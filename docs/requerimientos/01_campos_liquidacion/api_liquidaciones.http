    "codigoSede": "01",
    "codigoEntidad": "0994",
    "codigoProduccion": "20251021",
    "numeroProduccion": "20251043",
    "tipoEntidadMedica": "1",
    "numeroLiquidacion": "20251021",
    "codigoLiquidacion": "20251021",
    "periodoLiquidacion": "10/10/2025",
    "estadoLiquidacion": "AUTORIZADO",
    "fechaLiquidacion": "13/11/2026 10:00:00",
    "descripcionLiquidacion": "PRUEBA MONTO NEGATIVO",
    "codSapCpm": "5100012347",
    "mtoDetraccion": -1,
    "porcDetraccion": 12.00
  }
]


