### -----------------------------------------------------------------------------
### 7. Produccion que no existe
### Esperado: 200 con el detalle en "ER" (produccion no encontrada); el resto
### del lote no se ve afectado.
### -----------------------------------------------------------------------------
POST {{url}}
Content-Type: application/json

[
  {
    "codigoSede": "01",
    "codigoEntidad": "0994",
    "codigoProduccion": "NOEXISTE",
    "numeroProduccion": "99999999",
    "tipoEntidadMedica": "1",
    "numeroLiquidacion": "99999999",
    "codigoLiquidacion": "99999999",
    "periodoLiquidacion": "10/10/2025",
    "estadoLiquidacion": "AUTORIZADO",
    "fechaLiquidacion": "13/11/2026 10:00:00",
    "descripcionLiquidacion": "PRUEBA PRODUCCION INEXISTENTE",
    "codSapCpm": "5100012348"
  }
]


### -----------------------------------------------------------------------------
### 8. Falta un campo obligatorio (codigoSede)
### Esperado: 400 Bad Request, "Error de validacion."
### -----------------------------------------------------------------------------
POST {{url}}
Content-Type: application/json

[
  {
    "codigoEntidad": "0994",
    "codigoProduccion": "20251022",
    "numeroProduccion": "20251044",
    "tipoEntidadMedica": "1",
    "numeroLiquidacion": "20251022",
    "codigoLiquidacion": "20251022",
    "periodoLiquidacion": "10/10/2025",
    "estadoLiquidacion": "AUTORIZADO",
    "fechaLiquidacion": "13/11/2026 10:00:00",
    "descripcionLiquidacion": "PRUEBA SIN SEDE"
  }
]


### -----------------------------------------------------------------------------
### 9. Monto enviado como texto en lugar de numero
### Esperado: 400 Bad Request. Un tipo equivocado rechaza TODO el lote antes de
### procesarlo (no es un error por registro). Pendiente de verificar el mensaje.
### -----------------------------------------------------------------------------
POST {{url}}
Content-Type: application/json

[
  {
    "codigoSede": "01",
    "codigoEntidad": "0994",
    "codigoProduccion": "20251022",
    "numeroProduccion": "20251044",
    "tipoEntidadMedica": "1",
    "numeroLiquidacion": "20251022",
    "codigoLiquidacion": "20251022",
    "periodoLiquidacion": "10/10/2025",
    "estadoLiquidacion": "AUTORIZADO",
    "fechaLiquidacion": "13/11/2026 10:00:00",
    "descripcionLiquidacion": "PRUEBA MONTO COMO TEXTO",
    "codSapCpm": "5100012349",
    "mtoDetraccion": "abc",
    "porcDetraccion": 12.00
  }
]


### -----------------------------------------------------------------------------
### 10. Lote vacio
### Esperado: 400 Bad Request, "La coleccion de liquidaciones no puede estar vacia".
### -----------------------------------------------------------------------------
POST {{url}}
Content-Type: application/json

[]
