    "mtoDescuento": 794.23,
    "mtoSubtotal": 574.23,
    "mtoRenta": 0,
    "mtoIgv": 103.36,
    "mtoTotal": 677.59,
    "mtoDetraccion": 81.31,
    "porcDetraccion": 12.00
  },
  {
    "codigoSede": "01",
    "codigoEntidad": "0995",
    "codigoProduccion": "T1000002",
    "numeroProduccion": "T100000002",
    "tipoProduccion": "01",
