### -----------------------------------------------------------------------------
### 3. Sin los campos de detraccion (son opcionales)
### Esperado: 201, "Creado exitosamente". MTO_DETRACCION y PORC_DETRACCION (el INSERT
### no aplica valor por defecto) quedan en NULL hasta que llegue la liquidacion.
### -----------------------------------------------------------------------------
POST {{url}}
Content-Type: application/json

[
  {
    "codigoSede": "01",
    "codigoEntidad": "0994",
    "codigoProduccion": "T1000003",
    "numeroProduccion": "T100000003",
    "tipoProduccion": "02",
    "tipoEntidadMedica": "1",
    "tipoMedico": "02",
    "tipoRubro": "03",
    "descripcion": "PRUEBA SIN CAMPOS DE DETRACCION",
    "periodo": "07/11/2026",
    "fechaProduccion": "07/11/2026 11:00:00",
    "estadoProduccion": "2",
    "mtoConsumo": 100,
    "mtoDescuento": 0,
    "mtoSubtotal": 100,
    "mtoRenta": 0,
    "mtoIgv": 18,
    "mtoTotal": 118
  }
]


### -----------------------------------------------------------------------------
### 4. Anular una produccion (estadoProduccion "0")
### Anula la produccion T1000003 creada en el paso 3.
### Esperado: 201, "Produccion anulada exitosamente". BD: ESTADO PRODUCCION_ANULADA.
### Si la produccion no existe responde OK con "Produccion a anular no encontrada, obviado".
### -----------------------------------------------------------------------------
POST {{url}}
Content-Type: application/json

[
  {
    "codigoSede": "01",
    "codigoEntidad": "0994",
    "codigoProduccion": "T1000003",
    "numeroProduccion": "T100000003",
    "tipoProduccion": "02",
    "tipoEntidadMedica": "1",
    "tipoMedico": "02",
    "tipoRubro": "03",
    "descripcion": "ANULACION DE PRODUCCION",
    "periodo": "07/11/2026",
    "fechaProduccion": "07/11/2026 11:00:00",
    "estadoProduccion": "0",
    "mtoConsumo": 100,
    "mtoDescuento": 0,
    "mtoSubtotal": 100,
    "mtoRenta": 0,
    "mtoIgv": 18,
    "mtoTotal": 118
  }
]


### -----------------------------------------------------------------------------
### 5. Anular el comprobante (estadoProduccion "9")
### Para una produccion que ya tenia factura cargada: vuelve a FACTURA_PENDIENTE y
### desactiva sus archivos (PDF y XML).
### Esperado: "Comprobante anulado exitosamente. N archivo(s) desactivado(s)", o
### "Produccion para anular comprobante no encontrada, obviado".
### -----------------------------------------------------------------------------
POST {{url}}
Content-Type: application/json

[
  {
    "codigoSede": "01",
    "codigoEntidad": "0994",
    "codigoProduccion": "T1000001",
    "numeroProduccion": "T100000001",
    "tipoProduccion": "02",
    "tipoEntidadMedica": "1",
    "tipoMedico": "02",
    "tipoRubro": "03",
    "descripcion": "ANULACION DE COMPROBANTE",
    "periodo": "07/11/2026",
    "fechaProduccion": "07/11/2026 10:30:00",
    "estadoProduccion": "9",
    "mtoConsumo": 1368.46,
    "mtoDescuento": 794.23,
    "mtoSubtotal": 574.23,
    "mtoRenta": 0,
    "mtoIgv": 103.36,
    "mtoTotal": 677.59
  }
]


