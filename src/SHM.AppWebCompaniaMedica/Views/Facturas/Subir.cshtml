@model SHM.AppWebCompaniaMedica.Models.SubirFacturaViewModel
@using static SHM.AppDomain.Constants.AppConstants
@{
    ViewData["Title"] = "Enviar Factura";
    var tipoNombre = Model.TipoComprobante switch { "1" => "Factura", "22" => "Recibo por Honorarios", _ => Model.TipoComprobante ?? "-" };
}

<style>
    /* Sin scroll de página en paso 2 */
    html, body { overflow: hidden !important; height: 100% !important; }
    /* Pasos 1, 3 y 4 necesitan scroll por el contenido extenso */
    html.paso-1, html.paso-1 body,
    html.paso-3, html.paso-3 body,
    html.paso-4, html.paso-4 body { overflow: auto !important; height: auto !important; }

    /* === Wizard Stepper === */
    .wizard-steps {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 0.75rem 1rem 0.625rem;
        background: transparent;
        border-bottom: 1px solid var(--border);
        margin-bottom: 1.25rem;
    }
    .step-indicator {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
        min-width: 80px;
    }
    .step-circle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.95rem;
        background: #dee2e6;
        color: #6c757d;
        transition: all 0.3s ease;
    }
    .step-indicator.active .step-circle {
        background: var(--accent);
        color: #fff;
        box-shadow: 0 3px 10px rgba(242,101,34,0.35);
    }
    .step-indicator.completed .step-circle {
        background: #28a745;
        color: #fff;
    }
    .step-label {
        font-size: 0.78rem;
        color: var(--text-secondary);
        font-weight: 500;
        text-align: center;
        line-height: 1.25;
    }
    .step-indicator.active .step-label  { color: var(--accent); font-weight: 700; }
    .step-indicator.completed .step-label { color: #28a745; font-weight: 600; }
    .step-connector {
        flex: 1;
        height: 2px;
        background: #dee2e6;
        margin: 0 0.4rem;
        margin-top: 17px;
        max-width: 120px;
        transition: background 0.3s ease;
    }
    .step-connector.completed { background: #28a745; }

    /* === Mini resumen Paso 2 === */
    .mini-resumen {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 0.875rem 1.25rem;
        background: var(--bg-main);
        border-radius: 10px;
        border-left: 4px solid var(--accent);
        font-size: 0.875rem;
        flex-wrap: wrap;
    }
    .mini-resumen .sep {
        color: var(--border);
        font-size: 1.1rem;
    }

    /* === Copy button === */
    .btn-copiar-concepto {
        background: none;
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 2px 8px;
        cursor: pointer;
        color: var(--text-secondary);
        font-size: 0.85rem;
        transition: all 0.2s ease;
        line-height: 1;
    }
    .btn-copiar-concepto:hover { border-color: var(--accent); color: var(--accent); }
    .btn-copiar-concepto.copiado { border-color: #28a745; color: #28a745; }

    /* === Info card reusable === */
    .info-card {
        padding: 0.35rem 0.75rem;
        background: var(--bg-main);
        border-radius: 8px;
        border: 1px solid var(--border);
        height: 100%;
    }
    .info-card .lbl { color: var(--text-secondary); font-size: 0.75rem; display: block; margin-bottom: 0.15rem; }
    .info-card .val { font-weight: 600; font-size: 0.95rem; color: var(--text-primary); }
    .info-card .val.mono { font-family: 'JetBrains Mono', monospace; }
    .info-card .val.accent { color: var(--accent); font-size: 0.95rem; }

    /* === Section title === */
    .section-title {
        font-weight: 700;
        color: var(--primary);
        font-size: 0.875rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.875rem;
    }

    /* === Sticky footer === */
    .wizard-footer {
        position: fixed;
        bottom: 0;
        left: 280px;
        right: 0;
        background: #fff;
        border-top: 1px solid var(--border);
        padding: 0.875rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.08);
        z-index: 200;
    }
    @@media (max-width: 992px) {
        .wizard-footer { left: 0; }
    }
    .btn-nav-back {
        background: transparent;
        color: var(--text-primary);
        border: 2px solid var(--border);
        border-radius: 10px;
        padding: 0.65rem 1.5rem;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }
    .btn-nav-back:hover { border-color: var(--text-secondary); background: var(--bg-main); color: var(--text-primary); }
    .btn-nav-next {
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.65rem 1.75rem;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    .btn-nav-next:hover:not(:disabled) { background: #d4541c; }
    .btn-nav-next:disabled { background: #6c757d; cursor: not-allowed; }
    .step-counter {
        font-size: 0.82rem;
        color: var(--text-secondary);
        font-weight: 500;
    }
    /* === btn-nav-confirm (Paso 4) === */
    .btn-nav-confirm {
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.65rem 1.75rem;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 4px 15px rgba(242,101,34,0.25);
    }
    .btn-nav-confirm:hover:not(:disabled) { background: #d4541c; }
    .btn-nav-confirm:disabled { background: #6c757d; cursor: not-allowed; box-shadow: none; }

    /* === PDF Fullscreen (Paso 3) === */
    .pdf-fullscreen {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        height: calc(100vh - 310px);
        min-height: 420px;
    }
    .pdf-fullscreen-inner {
        width: 100%;
        max-width: 900px;
        height: 100%;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0,0,0,0.12);
        border: 1px solid var(--border);
    }
    .pdf-fullscreen-inner iframe { width: 100%; height: 100%; border: none; display: block; }

    /* === Validacion (Paso 4) === */
    .validation-panel { max-width: 860px; margin: 0 auto; }
    .xml-section { margin-bottom: 1.25rem; }
    .xml-section-title { font-weight:700; color:var(--primary); font-size:0.875rem; margin-bottom:0.75rem; padding-bottom:0.5rem; border-bottom:2px solid var(--accent); display:flex; align-items:center; gap:0.5rem; }
    .xml-data-grid { display:grid; grid-template-columns:1fr 1fr; gap:0.6rem; }
    .xml-field { background:var(--bg-main); padding:0.65rem 0.75rem; border-radius:8px; }
    .xml-label { font-size:0.72rem; color:var(--text-secondary); display:block; margin-bottom:0.2rem; }
    .xml-value { font-weight:600; font-size:0.875rem; color:var(--text-primary); }
    .xml-value.mono { font-family:'JetBrains Mono',monospace; }
    .total-highlight { background:rgba(242,101,34,0.1); padding:0.875rem; border-radius:10px; margin-top:0.6rem; }
    .total-amount { font-size:1.35rem; font-weight:700; color:var(--accent); }
    .item-row { padding:0.65rem 0.75rem; border-radius:8px; margin-bottom:0.4rem; font-size:0.82rem; }
    .item-row:nth-child(odd)  { background:var(--bg-main); }
    .item-row:nth-child(even) { background:white; border:1px solid var(--border); }
    .validation-section { background:white; border-radius:12px; padding:1.25rem; margin-bottom:1.25rem; border:2px solid var(--border); }
    .validation-section.has-errors { border-color:#dc3545; background:rgba(220,53,69,0.03); }
    .validation-section.all-valid  { border-color:#28a745; background:rgba(40,167,69,0.03); }
    .validation-title { font-weight:700; font-size:0.95rem; margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem; }
    .validation-title.error   { color:#dc3545; }
    .validation-title.success { color:#28a745; }
    .validation-row { display:flex; align-items:stretch; margin-bottom:0.75rem; border-radius:8px; overflow:hidden; border:1px solid var(--border); }
    .validation-label { flex:0 0 100px; background:var(--bg-main); padding:0.75rem; font-weight:600; font-size:0.8rem; display:flex; align-items:center; border-right:1px solid var(--border); }
    .validation-values { flex:1; display:flex; }
    .validation-col { flex:1; padding:0.75rem; text-align:center; }
    .validation-col-header { font-size:0.7rem; color:var(--text-secondary); text-transform:uppercase; margin-bottom:0.25rem; }
    .validation-col-value { font-weight:600; font-size:0.85rem; font-family:'JetBrains Mono',monospace; }
    .validation-col:first-child { border-right:1px solid var(--border); }
    .validation-status { flex:0 0 50px; display:flex; align-items:center; justify-content:center; font-size:1.25rem; }
    .validation-status.valid   { background:rgba(40,167,69,0.1);  color:#28a745; }
    .validation-status.invalid { background:rgba(220,53,69,0.1);  color:#dc3545; }
    .validation-status.warning { background:rgba(255,193,7,0.15); color:#e6a000; }
    .error-alert { background:rgba(220,53,69,0.1); border:1px solid rgba(220,53,69,0.3); border-radius:10px; padding:1rem; margin-top:1rem; display:flex; align-items:flex-start; gap:0.75rem; }
    .error-alert i { color:#dc3545; font-size:1.25rem; margin-top:0.1rem; }
    .error-alert-text { flex:1; }
    .error-alert-text strong { color:#dc3545; display:block; margin-bottom:0.25rem; }
    .error-alert-text p { margin:0; color:var(--text-secondary); font-size:0.85rem; }

    @@media (max-width: 768px) { .pdf-fullscreen { height: calc(100vh - 240px); } }

    /* === Campos obligatorios con estado visual === */
    .form-control.campo-lleno {
        border-color: #28a745;
        background-color: rgba(40,167,69,0.04);
    }
    .form-control.campo-lleno:focus {
        border-color: #28a745;
        box-shadow: 0 0 0 0.2rem rgba(40,167,69,0.15);
    }
</style>

<div class="table-card fade-in" style="margin-bottom: 0;">
    <div class="table-header">
        <h3>
            <i class="bi bi-file-earmark-arrow-up"></i>
            Enviar Factura &mdash; Producci&oacute;n @Model.NumeroProduccion
        </h3>
    </div>
    <div style="padding: 1.25rem 1.5rem 0.75rem;">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" style="border-radius: 12px; margin-bottom: 1.5rem;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            </div>
        }

        <!-- ===== STEPPER ===== -->
        <div class="wizard-steps" id="wizardStepper">
            <div class="step-indicator active" id="si-1">
                <div class="step-circle">1</div>
                <div class="step-label">Revisar<br>Datos</div>
            </div>
            <div class="step-connector" id="sc-1"></div>
            <div class="step-indicator" id="si-2">
                <div class="step-circle">2</div>
                <div class="step-label">Adjuntar<br>Comprobante</div>
            </div>
            <div class="step-connector" id="sc-2"></div>
            <div class="step-indicator" id="si-3">
                <div class="step-circle">3</div>
                <div class="step-label">Ver<br>PDF</div>
            </div>
            <div class="step-connector" id="sc-3"></div>
            <div class="step-indicator" id="si-4">
                <div class="step-circle">4</div>
                <div class="step-label">Validar<br>y Enviar</div>
            </div>
        </div>

        <!-- ===================================================== -->
        <!-- PANEL PASO 1: Revisar Datos                           -->
        <!-- ===================================================== -->
        <div id="panel-paso-1" style="padding-bottom: 5rem;">

            @if (!Model.TieneCuentaBancaria)
            {
                if (Model.RequiereValidacionCuenta)
                {
                    <div class="alert alert-danger" style="border-radius: 12px; margin-bottom: 1rem;">
                        <i class="bi bi-x-circle-fill me-2"></i>
                        <strong>No puede enviar facturas.</strong> No tiene cuenta bancaria registrada. Contacte al administrador.
                    </div>
                }
                else
                {
                    <div class="alert alert-warning" style="border-radius: 12px; margin-bottom: 1rem;">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        No tiene cuenta bancaria registrada. Contacte al administrador.
                    </div>
                }
            }

            <div class="row g-0">

                <!-- ── Columna izquierda: contexto ── -->
                <div class="col-lg-5 col-md-5" style="background: var(--bg-main); border-radius: 12px 0 0 12px; padding: 1.25rem 1.5rem; border: 1px solid var(--border); border-right: none;">

                    <div class="section-title" style="margin-bottom: 0.5rem;"><i class="bi bi-info-circle"></i>Informaci&oacute;n de la Producci&oacute;n</div>
                    <div class="row g-1 mb-2">
                        <div class="col-12">
                            <div class="info-card" style="background: #fff;">
                                <span class="lbl">Producci&oacute;n</span>
                                <span class="val mono">@Model.NumeroProduccion</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="info-card" style="background: #fff;">
                                <span class="lbl">Sede</span>
                                <span class="val">@(Model.NombreSede ?? "-")</span>
                            </div>
                        </div>
                    </div>

                    <div class="section-title" style="margin-bottom: 0.5rem;"><i class="bi bi-bank"></i>Datos Bancarios para Pago</div>
                    <div class="row g-1">
                        <div class="col-12">
                            <div class="info-card" style="background: #fff;">
                                <span class="lbl">Banco</span>
                                <span class="val">@(Model.NombreBanco ?? "-")</span>
                            </div>
                        </div>
                        <div class="col-7">
                            <div class="info-card" style="background: #fff;">
                                <span class="lbl">Cuenta Corriente</span>
                                <span class="val mono">@(Model.CuentaCorriente ?? "-")</span>
                            </div>
                        </div>
                        <div class="col-5">
                            <div class="info-card" style="background: #fff;">
                                <span class="lbl">Moneda</span>
                                <span class="val">@(Model.Moneda ?? "-")</span>
                            </div>
                        </div>
                    </div>

                    @if (Model.FechaLimite.HasValue)
                    {
                        <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.875rem; background: rgba(255,193,7,0.12); border: 1px solid rgba(255,193,7,0.4); border-radius: 8px; font-size: 0.8rem; color: #856404; margin-top: 1rem;">
                            <i class="bi bi-alarm"></i>
                            <strong>Fecha l&iacute;mite para enviar:</strong>&nbsp;@Model.FechaLimite.Value.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    }
                </div>

                <!-- ── Columna derecha: datos críticos para la factura ── -->
                <div class="col-lg-7 col-md-7" style="background: #fff; border-radius: 0 12px 12px 0; padding: 1.25rem 1.5rem; border: 1px solid var(--border); border-left: 1px solid var(--border);">

                    <div class="section-title" style="margin-bottom: 0.5rem;"><i class="bi bi-receipt"></i>Datos para emitir el Comprobante de Pago</div>

                    <div style="background: linear-gradient(135deg, rgba(59,130,246,0.07) 0%, rgba(90,17,96,0.04) 100%); border: 1px solid #3B82F6; border-radius: 8px; padding: 0.6rem 0.875rem; margin-bottom: 0.875rem; font-size: 0.8rem; color: #1E40AF; display: flex; gap: 0.5rem; align-items: flex-start;">
                        <i class="bi bi-info-circle-fill" style="color: #3B82F6; font-size: 0.95rem; margin-top: 1px; flex-shrink: 0;"></i>
                        <span>Utilice estos datos para emitir su comprobante. Aseg&uacute;rese de que el <strong>Concepto</strong>, <strong>RUC del Receptor</strong> e <strong>Importe Total</strong> coincidan exactamente con su factura electr&oacute;nica.</span>
                    </div>

                    <!-- Emisor / Receptor -->
                    <div class="row g-1 mb-1">
                        <div class="col-12">
                            <div class="info-card">
                                <span class="lbl"><i class="bi bi-building me-1"></i>Emisor (Compa&ntilde;&iacute;a M&eacute;dica)</span>
                                <span class="val mono" style="display: inline;">@(Model.EmisorRuc ?? "-")</span>
                                <span style="color: var(--text-secondary); margin: 0 0.4rem;">—</span>
                                <span class="val" style="display: inline;">@(Model.EmisorRazonSocial ?? "-")</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="info-card">
                                <span class="lbl"><i class="bi bi-hospital me-1"></i>Receptor (Sede)</span>
                                <span class="val mono" style="display: inline;">@(Model.ReceptorRuc ?? "-")</span>
                                <span style="color: var(--text-secondary); margin: 0 0.4rem;">—</span>
                                <span class="val" style="display: inline;">@(Model.ReceptorNombre ?? "-")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Concepto -->
                    <div class="row g-1 mb-1">
                        <div class="col-12">
                            <div class="info-card">
                                <span class="lbl">Concepto</span>
                                <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                    <span class="val" id="conceptoTexto">@(Model.Concepto ?? "-")</span>
                                    @if (!string.IsNullOrEmpty(Model.Concepto))
                                    {
                                        <button type="button" class="btn-copiar-concepto" id="btnCopiarConcepto" onclick="copiarConcepto()" title="Copiar concepto">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Importes -->
                    <div class="row g-1">
                        <div class="col-4">
                            <div class="info-card">
                                <span class="lbl">SubTotal</span>
                                <span class="val">S/ @(Model.MtoSubtotal?.ToString("N2") ?? "0.00")</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="info-card">
                                @if (Model.TipoComprobante == "22")
                                {
                                    <span class="lbl">Retenci&oacute;n</span>
                                    <span class="val">S/ @(Model.MtoRenta?.ToString("N2") ?? "0.00")</span>
                                }
                                else
                                {
                                    <span class="lbl">IGV (18%)</span>
                                    <span class="val">S/ @(Model.MtoIgv?.ToString("N2") ?? "0.00")</span>
                                }
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="info-card" style="background: linear-gradient(135deg, rgba(242,101,34,0.08) 0%, rgba(90,17,96,0.06) 100%); border-color: var(--accent); text-align: center;">
                                <span class="lbl">Importe Total</span>
                                <span class="val accent" style="font-size: 1.1rem;">S/ @(Model.MtoTotal?.ToString("N2") ?? "0.00")</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ===================================================== -->
            <!-- Sección: Información de Pago                          -->
            <!-- ===================================================== -->
            <div style="margin-top: 1rem; background: #fff; border-radius: 12px; padding: 1.25rem 1.5rem; border: 1px solid var(--border);">
                <div class="section-title" style="margin-bottom: 0.875rem;">
                    <i class="bi bi-credit-card"></i>Informaci&oacute;n de Pago
                </div>
                <div class="row g-2">
                    <div class="col-lg-3 col-md-4 col-6">
                        <div class="info-card">
                            <span class="lbl">Forma de Pago</span>
                            <span class="val">@FacturacionConstants.FormaPago</span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-4 col-6">
                        <div class="info-card">
                            <span class="lbl">N&uacute;mero de Cuotas</span>
                            <span class="val">@FacturacionConstants.NroCuotas</span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-4 col-6">
                        <div class="info-card">
                            <span class="lbl">Fecha Vencimiento</span>
                            <span class="val @(Model.FacturaFechaVencimiento.HasValue ? "" : "text-muted")">
                                @(Model.FacturaFechaVencimiento.HasValue ? Model.FacturaFechaVencimiento.Value.ToString("dd/MM/yyyy") : "-")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.MtoDetraccion.HasValue && Model.MtoDetraccion > 0)
            {
                <!-- ===================================================== -->
                <!-- Sección: Información de Detracción                     -->
                <!-- ===================================================== -->
                <div style="margin-top: 1rem; background: #fff; border-radius: 12px; padding: 1.25rem 1.5rem; border: 1px solid #ffc107;">
                    <div class="section-title" style="margin-bottom: 0.5rem; color: #856404;">
                        <i class="bi bi-percent"></i>Informaci&oacute;n de Detracci&oacute;n
                        <span style="font-size: 0.75rem; font-weight: 500; color: #856404; margin-left: 0.5rem;">
                            (Factura afecta a detracci&oacute;n — @(Model.PorcDetraccion?.ToString("N0") ?? "0")%)
                        </span>
                    </div>
                    <div style="background: rgba(255,193,7,0.08); border: 1px solid rgba(255,193,7,0.35); border-radius: 8px; padding: 0.55rem 0.875rem; margin-bottom: 0.875rem; font-size: 0.78rem; color: #856404; display: flex; gap: 0.5rem; align-items: center;">
                        <i class="bi bi-info-circle-fill" style="flex-shrink: 0;"></i>
                        Esta producci&oacute;n est&aacute; sujeta al Sistema de Detracciones (SPOT). Incluya estos datos en su comprobante electr&oacute;nico.
                    </div>
                    <div class="row g-2">
                        <div class="col-12">
                            <div class="info-card">
                                <span class="lbl">Tipo de Operaci&oacute;n</span>
                                <span class="val">@FacturacionConstants.DescTipoOperacion</span>
                            </div>
                        </div>
                        <div class="col-lg-6 col-12">
                            <div class="info-card">
                                <span class="lbl">C&oacute;digo de Bien/Servicio sujeto a Detracci&oacute;n</span>
                                <span class="val mono">@FacturacionConstants.CodigoConceptoDetraccion</span>
                                <span style="color: var(--text-secondary); margin: 0 0.35rem; font-size: 0.85rem;">—</span>
                                <span class="val" style="display: inline; font-weight: 500;">@FacturacionConstants.DescConceptoDetraccion</span>
                            </div>
                        </div>
                        <div class="col-lg-6 col-12">
                            <div class="info-card">
                                <span class="lbl">Medio de Pago</span>
                                <span class="val mono">@FacturacionConstants.CodigoMedioPago</span>
                                <span style="color: var(--text-secondary); margin: 0 0.35rem; font-size: 0.85rem;">—</span>
                                <span class="val" style="display: inline; font-weight: 500;">@FacturacionConstants.DescMedioPago</span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-4 col-6">
                            <div class="info-card" style="border-color: rgba(255,193,7,0.5);">
                                <span class="lbl">Porcentaje de Detracci&oacute;n</span>
                                <span class="val" style="color: #856404; font-size: 1.05rem;">@(Model.PorcDetraccion?.ToString("N0") ?? "0")%</span>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-4 col-6">
                            <div class="info-card" style="border-color: rgba(255,193,7,0.5);">
                                <span class="lbl">Monto de la Detracci&oacute;n</span>
                                <span class="val" style="color: #856404; font-size: 1.05rem;">S/ @(Model.MtoDetraccion?.ToString("N2") ?? "0.00")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div><!-- /panel-paso-1 -->

        <!-- ===================================================== -->
        <!-- PANEL PASO 2: Adjuntar Comprobante                    -->
        <!-- ===================================================== -->
        <div id="panel-paso-2" style="display: none;">

            <form id="uploadForm" asp-controller="Facturas" asp-action="PrepararVistaPrevia" method="post" enctype="multipart/form-data" novalidate>
                <input type="hidden" name="guidRegistro" value="@Model.GuidRegistro" />
                <input type="hidden" id="tipoComprobante" name="tipoComprobante" value="@Model.TipoComprobante" />

                <div class="row g-0">

                    <!-- ── Columna izquierda: datos del comprobante ── -->
                    <div class="col-lg-5 col-md-5" style="background: #fff; border-radius: 12px 0 0 12px; padding: 1.25rem 1.5rem; border: 1px solid var(--border); border-right: none;">

                        <div class="section-title" style="margin-bottom: 0.875rem;"><i class="bi bi-card-list"></i>Datos del Comprobante</div>

                        <div style="background: linear-gradient(135deg, rgba(59,130,246,0.07) 0%, rgba(90,17,96,0.04) 100%); border: 1px solid #3B82F6; border-radius: 8px; padding: 0.55rem 0.875rem; margin-bottom: 1rem; font-size: 0.78rem; color: #1E40AF; display: flex; gap: 0.5rem; align-items: center;">
                            <i class="bi bi-info-circle-fill" style="color: #3B82F6; flex-shrink: 0;"></i>
                            Ingrese los datos exactamente como aparecen en su comprobante electr&oacute;nico.
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">
                                    Tipo Comprobante <i class="bi bi-lock-fill" style="font-size: 0.7rem; color: var(--text-secondary);"></i>
                                </label>
                                <input type="text" class="form-control" readonly value="@tipoNombre" style="background-color: var(--bg-main); cursor: default;" />
                            </div>
                            <div class="col-6">
                                <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">Fecha Emisi&oacute;n <span style="color: var(--danger);">*</span></label>
                                <input type="date" class="form-control" id="fechaEmision" name="fechaEmision" max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">Serie <span style="color: var(--danger);">*</span></label>
                                <input type="text" class="form-control" id="serie" name="serie" placeholder="Ej: E001" maxlength="4" required style="text-transform: uppercase;" />
                            </div>
                            <div class="col-6">
                                <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">N&uacute;mero <span style="color: var(--danger);">*</span></label>
                                <input type="text" class="form-control" id="numero" name="numero" placeholder="Ej: 1234" maxlength="8" required pattern="[0-9]*" inputmode="numeric" />
                            </div>
                        </div>


                    </div>

                    <!-- ── Columna derecha: archivos ── -->
                    <div class="col-lg-7 col-md-7" style="background: #fff; border-radius: 0 12px 12px 0; padding: 1.25rem 1.5rem; border: 1px solid var(--border); border-left: 1px solid var(--border);">

                        <div class="section-title" style="margin-bottom: 0.875rem;"><i class="bi bi-file-earmark-arrow-up"></i>Documentos Electr&oacute;nicos</div>

                        <!-- PDF + XML en fila -->
                        <div class="row g-3 mb-3">
                            <div class="@(Model.RequiereCdr ? "col-6" : "col-6")">
                                <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">Archivo PDF <span style="color: var(--danger);">*</span></label>
                                <div class="file-upload-area" id="pdfArea"
                                     style="border: 2px dashed var(--border); border-radius: 12px; padding: 1.25rem 1rem; text-align: center; transition: all 0.3s ease; cursor: pointer; background: var(--bg-main); min-height: 140px; display: flex; flex-direction: column; justify-content: center;">
                                    <i class="bi bi-file-earmark-pdf" style="font-size: 2.25rem; color: var(--danger); margin-bottom: 0.5rem;"></i>
                                    <p class="mb-1" style="font-weight: 600; font-size: 0.85rem;">Factura PDF</p>
                                    <p class="text-muted mb-0" style="font-size: 0.72rem;">Click o arrastre aqu&iacute;</p>
                                </div>
                                <input type="file" id="archivoPdf" name="archivoPdf" accept=".pdf" style="display: none;" required />
                                <div id="pdfFileName" class="mt-1" style="display: none; color: var(--accent); font-weight: 600; font-size: 0.8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    <i class="bi bi-check-circle-fill me-1"></i><span id="pdfFileNameText"></span>
                                </div>
                            </div>

                            <div class="col-6">
                                <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">Archivo XML <span style="color: var(--danger);">*</span></label>
                                <div class="file-upload-area" id="xmlArea"
                                     style="border: 2px dashed var(--border); border-radius: 12px; padding: 1.25rem 1rem; text-align: center; transition: all 0.3s ease; cursor: pointer; background: var(--bg-main); min-height: 140px; display: flex; flex-direction: column; justify-content: center;">
                                    <i class="bi bi-file-earmark-code" style="font-size: 2.25rem; color: var(--warning); margin-bottom: 0.5rem;"></i>
                                    <p class="mb-1" style="font-weight: 600; font-size: 0.85rem;">Factura XML</p>
                                    <p class="text-muted mb-0" style="font-size: 0.72rem;">Click o arrastre aqu&iacute;</p>
                                </div>
                                <input type="file" id="archivoXml" name="archivoXml" accept=".xml" style="display: none;" required />
                                <div id="xmlFileName" class="mt-1" style="display: none; color: var(--accent); font-weight: 600; font-size: 0.8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    <i class="bi bi-check-circle-fill me-1"></i><span id="xmlFileNameText"></span>
                                </div>
                            </div>
                        </div>

                        @if (Model.RequiereCdr)
                        {
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">Archivo CDR <span style="color: var(--danger);">*</span></label>
                                    <div class="file-upload-area" id="cdrArea"
                                         style="border: 2px dashed var(--border); border-radius: 12px; padding: 1.25rem 1rem; text-align: center; transition: all 0.3s ease; cursor: pointer; background: var(--bg-main); min-height: 140px; display: flex; flex-direction: column; justify-content: center;">
                                        <i class="bi bi-file-earmark-zip" style="font-size: 2.25rem; color: var(--primary); margin-bottom: 0.5rem;"></i>
                                        <p class="mb-1" style="font-weight: 600; font-size: 0.85rem;">Constancia CDR</p>
                                        <p class="text-muted mb-0" style="font-size: 0.72rem;">Click o arrastre aqu&iacute;</p>
                                    </div>
                                    <input type="file" id="archivoCdr" name="archivoCdr" accept=".zip,.xml" style="display: none;" required />
                                    <div id="cdrFileName" class="mt-1" style="display: none; color: var(--accent); font-weight: 600; font-size: 0.8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        <i class="bi bi-check-circle-fill me-1"></i><span id="cdrFileNameText"></span>
                                    </div>
                                </div>
                                <div class="col-6 d-flex align-items-end">
                                    <div style="padding: 0.875rem; background: rgba(255,193,7,0.08); border: 1px solid rgba(255,193,7,0.4); border-radius: 10px; font-size: 0.78rem; color: #856404; width: 100%;">
                                        <i class="bi bi-shield-check me-1"></i>
                                        El CDR (Constancia de Recepci&oacute;n) es el archivo <strong>.zip</strong> que emite SUNAT confirmando la aceptaci&oacute;n del comprobante.
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                        }

                    </div>
                </div>

            </form>

        </div><!-- /panel-paso-2 -->

        <!-- ===================================================== -->
        <!-- PANEL PASO 3: Ver PDF + Datos XML                    -->
        <!-- ===================================================== -->
        <div id="panel-paso-3" style="display:none; padding-bottom: 5rem;">
            <div class="row g-4">
                <!-- PDF -->
                <div class="col-lg-7" style="border-right: 1px solid var(--border); padding-right: 1.5rem;">
                    <div class="section-title"><i class="bi bi-file-earmark-pdf"></i>Vista Previa del Comprobante</div>
                    <div class="pdf-fullscreen">
                        <div class="pdf-fullscreen-inner">
                            <iframe id="pdfIframe" src="about:blank" title="Vista previa del PDF"></iframe>
                        </div>
                    </div>
                </div>
                <!-- Datos XML -->
                <div class="col-lg-5" style="padding-left: 1.5rem;">
                    <div class="section-title"><i class="bi bi-file-earmark-code"></i>Datos Extra&iacute;dos del XML</div>
                    <div id="datosXmlContainer">
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-hourglass-split" style="font-size:2rem;"></i>
                            <p class="mt-2">Cargando datos del XML...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===================================================== -->
        <!-- PANEL PASO 4: Validar y Enviar                        -->
        <!-- ===================================================== -->
        <div id="panel-paso-4" style="display:none; padding-bottom: 5rem;">
            <div class="section-title"><i class="bi bi-shield-check"></i>Validaci&oacute;n del Comprobante</div>
            <div id="validacionContainer">
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-hourglass-split" style="font-size:2rem;"></i>
                    <p class="mt-2">Cargando validaciones...</p>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ===== STICKY FOOTER ===== -->
<div class="wizard-footer">
    <!-- Izquierda -->
    <div id="footer-left">
        <a asp-controller="Facturas" asp-action="Pendientes" id="btnCancelar" class="btn-nav-back">
            <i class="bi bi-arrow-left"></i> Cancelar
        </a>
        <button type="button" id="btnAnterior" class="btn-nav-back" onclick="irAtras()" style="display:none;">
            <i class="bi bi-arrow-left"></i> Anterior
        </button>
    </div>

    <span class="step-counter" id="footerStepCounter">Paso 1 de 4</span>

    <!-- Derecha -->
    <div style="display:flex; gap:0.5rem; align-items:center;">
        @if (Model.PuedeSubirFactura)
        {
            <button type="button" id="btnSiguiente" class="btn-nav-next" onclick="irPaso(2)">
                Siguiente <i class="bi bi-arrow-right"></i>
            </button>
        }
        else
        {
            <button type="button" disabled class="btn-nav-next" title="Sin cuenta bancaria">
                <i class="bi bi-lock-fill"></i> Sin cuenta bancaria
            </button>
        }
        <button type="button" id="btnSubirArchivos" class="btn-nav-next" onclick="irPaso(3)" style="display:none;">
            Siguiente <i class="bi bi-arrow-right"></i>
        </button>
        <button type="button" id="btnIrPaso4" class="btn-nav-next" onclick="mostrarPanel(4)" style="display:none;">
            Siguiente <i class="bi bi-arrow-right"></i>
        </button>
        <button type="button" id="btnConfirmarEnvio" class="btn-nav-confirm" style="display:none;">
            <i class="bi bi-send-fill"></i> Confirmar y Enviar
        </button>
    </div>
</div>

@section Scripts {
    <script>
        // Estado del wizard
        var sessionIdActual = null;
        var esDirty = true; // true = necesita subir archivos
        var pasoActual = 1;
        var guidRegistro = '@Model.GuidRegistro';
        var confirmUrl   = '@Url.Action("ConfirmarEnvio", "Facturas")';
        var urlEnviadas  = '@Url.Action("Enviadas", "Facturas")';

        document.addEventListener('DOMContentLoaded', function () {
            // Paso 1 requiere scroll (contenido extenso)
            document.documentElement.classList.add('paso-1');

            var pdfInput    = document.getElementById('archivoPdf');
            var xmlInput    = document.getElementById('archivoXml');
            var cdrInput    = document.getElementById('archivoCdr');
            var requiereCdr = @(Model.RequiereCdr ? "true" : "false");

            // === Opción A: Detectar estado inconsistente (ej. pestaña duplicada) ===
            // El navegador restaura campos de texto pero nunca file inputs (política de seguridad).
            // Si hay texto en los campos pero no hay archivos, el estado es inválido → limpiar.
            (function detectarEstadoInconsistente() {
                var tieneTexto = document.getElementById('serie').value.trim() !== '' ||
                                 document.getElementById('numero').value.trim() !== '' ||
                                 document.getElementById('fechaEmision').value !== '';
                var tieneArchivos = (pdfInput && pdfInput.files && pdfInput.files.length > 0) ||
                                    (xmlInput && xmlInput.files && xmlInput.files.length > 0);
                if (tieneTexto && !tieneArchivos) {
                    document.getElementById('serie').value = '';
                    document.getElementById('numero').value = '';
                    document.getElementById('fechaEmision').value = '';
                    ['serie', 'numero', 'fechaEmision'].forEach(function(id) {
                        var el = document.getElementById(id);
                        if (el) el.classList.remove('campo-lleno');
                    });
                }
            })();

            // === Click en áreas de upload ===
            document.getElementById('pdfArea').addEventListener('click', function () { pdfInput.click(); });
            document.getElementById('xmlArea').addEventListener('click', function () { xmlInput.click(); });
            if (requiereCdr && document.getElementById('cdrArea')) {
                document.getElementById('cdrArea').addEventListener('click', function () { cdrInput.click(); });
            }

            // === Drag & Drop ===
            function bindUploadArea(areaId, inputEl, nameId, nameTextId) {
                var area = document.getElementById(areaId);
                if (!area) return;
                area.addEventListener('mouseenter', function () { if (area.dataset.hasFile !== '1') { area.style.borderColor = 'var(--primary)'; area.style.background = 'rgba(242,101,34,0.05)'; } });
                area.addEventListener('mouseleave', function () { if (area.dataset.hasFile !== '1') { area.style.borderColor = 'var(--border)'; area.style.background = 'var(--bg-main)'; } });
                area.addEventListener('dragover',   function (e) { e.preventDefault(); area.style.borderColor = 'var(--accent)'; area.style.background = 'rgba(242,101,34,0.08)'; });
                area.addEventListener('dragleave',  function (e) { if (!area.contains(e.relatedTarget) && area.dataset.hasFile !== '1') { area.style.borderColor = 'var(--border)'; area.style.background = 'var(--bg-main)'; } });
                area.addEventListener('drop', function (e) {
                    e.preventDefault();
                    if (e.dataTransfer.files.length > 0) { var dt = new DataTransfer(); dt.items.add(e.dataTransfer.files[0]); inputEl.files = dt.files; inputEl.dispatchEvent(new Event('change')); }
                });
                inputEl.addEventListener('change', function () {
                    if (this.files.length > 0) {
                        document.getElementById(nameTextId).textContent = this.files[0].name;
                        document.getElementById(nameId).style.display = 'block';
                        area.style.borderColor = 'var(--accent)'; area.style.background = 'rgba(40,167,69,0.05)'; area.dataset.hasFile = '1';
                        esDirty = true;
                    }
                });
            }
            bindUploadArea('pdfArea', pdfInput, 'pdfFileName', 'pdfFileNameText');
            bindUploadArea('xmlArea', xmlInput, 'xmlFileName', 'xmlFileNameText');
            if (requiereCdr && cdrInput) bindUploadArea('cdrArea', cdrInput, 'cdrFileName', 'cdrFileNameText');

            // === Opción C: Deshabilitar botón Siguiente hasta que archivos requeridos estén cargados ===
            function actualizarEstadoBotonSubir() {
                var btnSubir = document.getElementById('btnSubirArchivos');
                if (!btnSubir) return;
                var tienePdf = pdfInput && pdfInput.files && pdfInput.files.length > 0;
                var tieneXml = xmlInput && xmlInput.files && xmlInput.files.length > 0;
                var tieneCdr = !requiereCdr || (cdrInput && cdrInput.files && cdrInput.files.length > 0);
                var habilitado = tienePdf && tieneXml && tieneCdr;
                btnSubir.disabled = !habilitado;
                btnSubir.style.opacity = habilitado ? '1' : '0.45';
                btnSubir.style.cursor  = habilitado ? 'pointer' : 'not-allowed';
            }
            pdfInput.addEventListener('change', actualizarEstadoBotonSubir);
            xmlInput.addEventListener('change', actualizarEstadoBotonSubir);
            if (cdrInput) cdrInput.addEventListener('change', actualizarEstadoBotonSubir);
            actualizarEstadoBotonSubir(); // estado inicial

            // === Dirty tracking + estado visual en campos obligatorios ===
            ['fechaEmision','serie','numero'].forEach(function(id) {
                var el = document.getElementById(id);
                if (!el) return;
                function actualizarEstado() {
                    el.classList.toggle('campo-lleno', el.value.trim() !== '');
                    esDirty = true;
                }
                el.addEventListener('input',  actualizarEstado);
                el.addEventListener('change', actualizarEstado);
                actualizarEstado();
            });

            // === Formato de campos ===
            document.getElementById('serie').addEventListener('input', function () { this.value = this.value.toUpperCase(); });
            document.getElementById('numero').addEventListener('input', function () { this.value = this.value.replace(/[^0-9]/g, '').replace(/^0+(\d)/, '$1'); });

            // === Confirmar Envío ===
            var btnConfirmar = document.getElementById('btnConfirmarEnvio');
            if (btnConfirmar) {
                btnConfirmar.addEventListener('click', function () {
                    if (btnConfirmar.disabled) return;
                    Swal.fire({
                        title: 'Confirmar Envio',
                        text: '\u00bfEst\u00e1 seguro de enviar esta factura? Esta acci\u00f3n no se puede deshacer.',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#f26522',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'S\u00ed, Enviar',
                        cancelButtonText: 'Cancelar'
                    }).then(function (result) {
                        if (!result.isConfirmed) return;
                        btnConfirmar.disabled = true;
                        Swal.fire({ title: 'Enviando...', text: 'Por favor espere.', allowOutsideClick: false, allowEscapeKey: false, showConfirmButton: false, didOpen: function() { Swal.showLoading(); } });
                        var fd = new FormData();
                        fd.append('sessionId', sessionIdActual);
                        fetch(confirmUrl, { method: 'POST', body: fd })
                            .then(function (r) { return r.json(); })
                            .then(function (data) {
                                if (data.success) {
                                    Swal.fire({ icon: 'success', title: 'Factura Enviada', text: data.message, confirmButtonColor: '#28a745', allowOutsideClick: false })
                                        .then(function () { window.location.href = urlEnviadas; });
                                } else {
                                    Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#dc3545' });
                                    btnConfirmar.disabled = false;
                                }
                            })
                            .catch(function () {
                                Swal.fire({ icon: 'error', title: 'Error', text: 'Ocurri\u00f3 un error al enviar.', confirmButtonColor: '#dc3545' });
                                btnConfirmar.disabled = false;
                            });
                    });
                });
            }

            // Ajustar footer cuando el sidebar se oculta/muestra
            (function () {
                var sidebar = document.getElementById('sidebar');
                if (!sidebar) return;
                var footer = document.querySelector('.wizard-footer');
                if (!footer) return;
                var observer = new MutationObserver(function () {
                    footer.style.left = (window.innerWidth > 992 && !sidebar.classList.contains('hidden')) ? '280px' : '0';
                });
                observer.observe(sidebar, { attributes: true, attributeFilter: ['class'] });
            })();
        });

        // === Validacion de formulario Paso 2 ===
        function validarFormularioPaso2() {
            var pdfInput    = document.getElementById('archivoPdf');
            var xmlInput    = document.getElementById('archivoXml');
            var cdrInput    = document.getElementById('archivoCdr');
            var requiereCdr = @(Model.RequiereCdr ? "true" : "false");
            var errores = [];
            if (!document.getElementById('fechaEmision').value) {
                errores.push('Ingrese la fecha de emisi\u00f3n');
            } else {
                var fe = new Date(document.getElementById('fechaEmision').value + 'T00:00:00');
                var hoy = new Date(); hoy.setHours(0,0,0,0);
                if (fe > hoy) errores.push('La fecha de emisi\u00f3n no puede ser futura');
            }
            if (!document.getElementById('serie').value.trim())  errores.push('Ingrese la serie');
            var numeroVal = document.getElementById('numero').value.trim();
            if (!numeroVal)                     errores.push('Ingrese el número');
            else if (parseInt(numeroVal) === 0) errores.push('El número de factura no puede ser cero');
            if (!pdfInput || !pdfInput.files[0])  errores.push('Seleccione el archivo PDF');
            if (!xmlInput || !xmlInput.files[0])  errores.push('Seleccione el archivo XML');
            if (requiereCdr && cdrInput && !cdrInput.files[0]) errores.push('Seleccione el archivo CDR');
            return errores;
        }

        // === Navegar hacia atrás ===
        function irAtras() {
            if (pasoActual > 1) mostrarPanel(pasoActual - 1);
        }

        // === irPaso: entrada principal de navegación ===
        function irPaso(paso) {
            if (paso === 3) {
                // Validar formulario primero
                var errores = validarFormularioPaso2();
                if (errores.length > 0) {
                    Swal.fire({
                        icon: 'warning', title: 'Campos Requeridos',
                        html: '<ul style="text-align:left;margin:0;padding-left:1.5rem;">' + errores.map(function(e){ return '<li>'+e+'</li>'; }).join('') + '</ul>',
                        confirmButtonText: 'Entendido', confirmButtonColor: '#f26522'
                    });
                    return;
                }
                // Si no hay cambios y ya tenemos sesion, ir directo
                if (!esDirty && sessionIdActual) {
                    mostrarPanel(3);
                    return;
                }
                // Subir archivos por AJAX
                subirArchivosAjax();
                return;
            }
            mostrarPanel(paso);
        }

        // === AJAX Upload ===
        function subirArchivosAjax() {
            Swal.fire({ title: 'Procesando...', text: 'Validando archivos, por favor espere.', allowOutsideClick: false, allowEscapeKey: false, showConfirmButton: false, didOpen: function() { Swal.showLoading(); } });

            var pdfInput = document.getElementById('archivoPdf');
            var xmlInput = document.getElementById('archivoXml');
            var cdrInput = document.getElementById('archivoCdr');
            var fd = new FormData();
            fd.append('guidRegistro',    guidRegistro);
            fd.append('tipoComprobante', document.getElementById('tipoComprobante').value);
            fd.append('serie',           document.getElementById('serie').value);
            fd.append('numero',          document.getElementById('numero').value);
            fd.append('fechaEmision',    document.getElementById('fechaEmision').value);
            fd.append('archivoPdf',      pdfInput.files[0]);
            fd.append('archivoXml',      xmlInput.files[0]);
            if (cdrInput && cdrInput.files[0]) fd.append('archivoCdr', cdrInput.files[0]);
            if (sessionIdActual) fd.append('sessionIdAnterior', sessionIdActual);

            fetch('@Url.Action("PrepararVistaPreviaAjax", "Facturas")', { method: 'POST', body: fd })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    Swal.close();
                    if (data.success) {
                        sessionIdActual = data.sessionId;
                        esDirty = false;
                        var pdfSrc = '/Facturas/ObtenerPdfTemporal?sessionId=' + sessionIdActual;
                        document.getElementById('pdfIframe').src = pdfSrc;
                        mostrarPanel(3);
                        cargarDatosXml();
                        cargarValidacion();
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: data.error, confirmButtonColor: '#dc3545' });
                    }
                })
                .catch(function() {
                    Swal.close();
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Error al procesar los archivos.', confirmButtonColor: '#dc3545' });
                });
        }

        // === Cargar datos XML del Paso 3 vía AJAX ===
        function cargarDatosXml() {
            fetch('/Facturas/DatosXmlPartial?sessionId=' + sessionIdActual)
                .then(function(r) { return r.text(); })
                .then(function(html) {
                    document.getElementById('datosXmlContainer').innerHTML = html;
                });
        }

        // === Cargar validaciones vía AJAX ===
        function cargarValidacion() {
            fetch('/Facturas/ValidacionPartial?sessionId=' + sessionIdActual)
                .then(function(r) { return r.text(); })
                .then(function(html) {
                    document.getElementById('validacionContainer').innerHTML = html;
                    var content = document.getElementById('validacionContent');
                    var puedeEnviar = content && content.dataset.puedeEnviar === 'true';
                    var btnConfirmar = document.getElementById('btnConfirmarEnvio');
                    if (btnConfirmar) {
                        btnConfirmar.disabled = !puedeEnviar;
                        if (!puedeEnviar) {
                            btnConfirmar.innerHTML = '<i class="bi bi-lock-fill"></i> No puede enviar';
                            btnConfirmar.title = 'Corrija los errores para poder enviar';
                        } else {
                            btnConfirmar.innerHTML = '<i class="bi bi-send-fill"></i> Confirmar y Enviar';
                            btnConfirmar.title = '';
                        }
                    }
                });
        }

        // === Mostrar panel y actualizar stepper + footer ===
        function mostrarPanel(paso) {
            pasoActual = paso;
            [1,2,3,4].forEach(function(p) {
                document.getElementById('panel-paso-' + p).style.display = p === paso ? 'block' : 'none';
            });
            for (var i = 1; i <= 4; i++) {
                var si = document.getElementById('si-' + i);
                si.classList.remove('active','completed');
                if (i < paso)  si.classList.add('completed');
                if (i === paso) si.classList.add('active');
            }
            for (var j = 1; j <= 3; j++) {
                document.getElementById('sc-' + j).classList.toggle('completed', j < paso);
            }
            var btnCancelar  = document.getElementById('btnCancelar');
            var btnAnterior  = document.getElementById('btnAnterior');
            var btnSiguiente = document.getElementById('btnSiguiente');
            var btnSubir     = document.getElementById('btnSubirArchivos');
            var btnIrP4      = document.getElementById('btnIrPaso4');
            var btnConfirmar = document.getElementById('btnConfirmarEnvio');
            var counter      = document.getElementById('footerStepCounter');

            if (btnCancelar)  btnCancelar.style.display  = paso === 1 ? 'inline-flex' : 'none';
            if (btnAnterior)  btnAnterior.style.display  = paso > 1  ? 'inline-flex' : 'none';
            if (btnSiguiente) btnSiguiente.style.display = paso === 1 ? 'inline-flex' : 'none';
            if (btnSubir)     btnSubir.style.display     = paso === 2 ? 'inline-flex' : 'none';
            if (btnIrP4)      btnIrP4.style.display      = paso === 3 ? 'inline-flex' : 'none';
            if (btnConfirmar) btnConfirmar.style.display = paso === 4 ? 'inline-flex' : 'none';
            if (counter)      counter.textContent        = 'Paso ' + paso + ' de 4';

            document.documentElement.classList.toggle('paso-1', paso === 1);
            document.documentElement.classList.toggle('paso-3', paso === 3);
            document.documentElement.classList.toggle('paso-4', paso === 4);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // === Copiar concepto ===
        function copiarConcepto() {
            var texto = document.getElementById('conceptoTexto').innerText;
            navigator.clipboard.writeText(texto).then(function () {
                var btn = document.getElementById('btnCopiarConcepto');
                btn.classList.add('copiado'); btn.innerHTML = '<i class="bi bi-check-lg"></i>';
                setTimeout(function () { btn.classList.remove('copiado'); btn.innerHTML = '<i class="bi bi-clipboard"></i>'; }, 2000);
            });
        }
    </script>
}
