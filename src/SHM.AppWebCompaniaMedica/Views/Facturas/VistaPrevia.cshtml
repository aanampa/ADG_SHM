@model SHM.AppWebCompaniaMedica.Models.VistaPreviaFacturaViewModel
@{
    ViewData["Title"] = "Vista Previa de Factura";

    // Extraer serie y numero del XML (formato "E001-17")
    var numeroFacturaXml = Model.DatosXml?.DatosGenerales.NumeroFactura ?? "";
    var partesXml = numeroFacturaXml.Split('-');
    var serieXml = partesXml.Length > 0 ? partesXml[0] : "";
    var numeroXml = partesXml.Length > 1 ? partesXml[1] : "";

    // Normalizar numero (quitar ceros a la izquierda para comparacion)
    int.TryParse(numeroXml, out var numeroXmlInt);
    int.TryParse(Model.Numero, out var numeroFormInt);

    // Datos del XML para comparacion de Tipo
    // tipoComprobanteForm="1" equivale a "01" en el XML (Factura); "22" equivale a "22" (RHE)
    var tipoComprobanteXml = Model.DatosXml?.DatosGenerales.CodigoTipoDocumento ?? "";
    var tipoComprobanteForm = Model.TipoComprobante ?? "";
    // "1" = Factura (interno) -> "01" (SUNAT); "22" = RHE (interno) -> "02" (SUNAT/parser)
    var tipoComprobanteFormNormalizado = tipoComprobanteForm == "1" ? "01"
        : tipoComprobanteForm == "22" ? "02"
        : tipoComprobanteForm;
    var tipoCoincide = string.Equals(tipoComprobanteFormNormalizado.Trim(), tipoComprobanteXml.Trim(), StringComparison.OrdinalIgnoreCase);

    // Nombres legibles de tipo comprobante
    var tipoNombres = new Dictionary<string, string> { {"1", "Factura"}, {"22", "Recibo por Honorarios"} };
    var tipoFormNombre = tipoNombres.ContainsKey(tipoComprobanteForm) ? tipoNombres[tipoComprobanteForm] : tipoComprobanteForm;
    var tipoXmlNombre = Model.DatosXml?.DatosGenerales.TipoDocumento ?? tipoComprobanteXml;

    // Datos del XML para comparacion de Fecha Emision
    var fechaEmisionXmlStr = Model.DatosXml?.DatosGenerales.FechaEmision ?? "";
    DateTime.TryParse(fechaEmisionXmlStr, out var fechaEmisionXmlDate);
    var fechaEmisionFormDate = Model.FechaEmision?.Date ?? DateTime.MinValue;
    var fechaEmisionCoincide = fechaEmisionFormDate == fechaEmisionXmlDate.Date;

    // Validaciones de Serie y Numero
    var serieCoincide = string.Equals(Model.Serie?.Trim(), serieXml?.Trim(), StringComparison.OrdinalIgnoreCase);
    var numeroCoincide = numeroXmlInt == numeroFormInt;

    // Validaciones de RUC Emisor y RUC Receptor
    var rucEmisorSistema = Model.EmisorRuc ?? "";
    var rucEmisorXml = Model.DatosXml?.Emisor.Ruc ?? "";
    var rucEmisorCoincide = string.Equals(rucEmisorSistema.Trim(), rucEmisorXml.Trim(), StringComparison.OrdinalIgnoreCase);

    var rucReceptorSistema = Model.ReceptorRuc ?? "";
    var rucReceptorXml = Model.DatosXml?.Cliente.NumeroDocumento ?? "";
    var rucReceptorCoincide = string.Equals(rucReceptorSistema.Trim(), rucReceptorXml.Trim(), StringComparison.OrdinalIgnoreCase);

    // Validaciones de Importe y Concepto (siempre activas)
    var importeXml = Model.DatosXml?.DesgloseTotales.ImporteTotal ?? 0;
    var importeProduccion = Model.MtoTotal ?? 0;
    var importeCoincide = Math.Abs(importeProduccion - importeXml) <= 0.01m;

    var conceptoXml = Model.DatosXml?.DetalleItems?.FirstOrDefault()?.Descripcion ?? "";
    var conceptoProduccion = Model.Concepto ?? "";
    var conceptoCoincide = string.Equals(conceptoProduccion.Trim(), conceptoXml.Trim(), StringComparison.OrdinalIgnoreCase);

    // Determinar si puede enviar (solo valida los campos habilitados por parametro)
    var puedeEnviar = true;
    var totalErrores = 0;

    var totalAdvertencias = 0;

    if (Model.ValidaTipo && !tipoCoincide) { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaTipo && !tipoCoincide) { totalAdvertencias++; }

    if (Model.ValidaFechaEmision && !fechaEmisionCoincide) { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaFechaEmision && !fechaEmisionCoincide) { totalAdvertencias++; }

    if (Model.ValidaSerie && !serieCoincide) { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaSerie && !serieCoincide) { totalAdvertencias++; }

    if (Model.ValidaNumero && !numeroCoincide) { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaNumero && !numeroCoincide) { totalAdvertencias++; }

    if (Model.ValidaRucEmisor && !rucEmisorCoincide) { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaRucEmisor && !rucEmisorCoincide) { totalAdvertencias++; }

    if (Model.ValidaRucReceptor && !rucReceptorCoincide) { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaRucReceptor && !rucReceptorCoincide) { totalAdvertencias++; }

    if (Model.ValidaImporte && !importeCoincide) { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaImporte && !importeCoincide) { totalAdvertencias++; }
    if (Model.ValidaConcepto && !conceptoCoincide) { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaConcepto && !conceptoCoincide) { totalAdvertencias++; }
}

<style>
    /* === Wizard Stepper === */
    .wizard-steps {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 1.25rem 1rem;
        background: var(--bg-main);
        border-radius: 12px;
        margin-bottom: 2rem;
    }
    .step-indicator {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        min-width: 90px;
    }
    .step-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.9rem;
        background: #dee2e6;
        color: #6c757d;
        transition: all 0.3s ease;
    }
    .step-indicator.active .step-circle {
        background: var(--accent);
        color: #fff;
        box-shadow: 0 4px 12px rgba(242,101,34,0.35);
    }
    .step-indicator.completed .step-circle {
        background: #28a745;
        color: #fff;
    }
    .step-label {
        font-size: 0.72rem;
        color: var(--text-secondary);
        font-weight: 500;
        text-align: center;
        line-height: 1.3;
    }
    .step-indicator.active .step-label   { color: var(--accent); font-weight: 700; }
    .step-indicator.completed .step-label { color: #28a745; font-weight: 600; }
    .step-connector {
        flex: 1;
        height: 2px;
        background: #dee2e6;
        margin: 0 0.5rem;
        margin-bottom: 1.6rem;
        max-width: 140px;
        transition: background 0.3s ease;
    }
    .step-connector.completed { background: #28a745; }

    /* === PDF Full Width === */
    .pdf-fullscreen {
        background: #525659;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        height: calc(100vh - 185px);
        min-height: 500px;
    }
    .pdf-fullscreen iframe {
        width: 100%;
        height: 100%;
        border: none;
        display: block;
    }

    /* === Panel 4: Validación === */
    .validation-panel {
        max-width: 860px;
        margin: 0 auto;
    }

    /* === Validation rows === */
    .xml-section { margin-bottom: 1.25rem; }
    .xml-section-title {
        font-weight: 700;
        color: var(--primary);
        font-size: 0.875rem;
        margin-bottom: 0.75rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--accent);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .xml-data-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
    .xml-field { background: var(--bg-main); padding: 0.65rem 0.75rem; border-radius: 8px; }
    .xml-label { font-size: 0.72rem; color: var(--text-secondary); display: block; margin-bottom: 0.2rem; }
    .xml-value { font-weight: 600; font-size: 0.875rem; color: var(--text-primary); }
    .xml-value.mono { font-family: 'JetBrains Mono', monospace; }
    .total-highlight { background: rgba(242,101,34,0.1); padding: 0.875rem; border-radius: 10px; margin-top: 0.6rem; }
    .total-amount { font-size: 1.35rem; font-weight: 700; color: var(--accent); }
    .item-row { padding: 0.65rem 0.75rem; border-radius: 8px; margin-bottom: 0.4rem; font-size: 0.82rem; }
    .item-row:nth-child(odd)  { background: var(--bg-main); }
    .item-row:nth-child(even) { background: white; border: 1px solid var(--border); }

    .btn-nav-back {
        background: transparent;
        color: var(--text-primary);
        border: 2px solid var(--border);
        border-radius: 10px;
        padding: 0.65rem 1.5rem;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }
    .btn-nav-back:hover { border-color: var(--text-secondary); background: var(--bg-main); color: var(--text-primary); }
    .btn-nav-confirm {
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.65rem 1.75rem;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 4px 15px rgba(242,101,34,0.25);
    }
    .btn-nav-confirm:hover:not(:disabled) { background: #d4541c; }
    .btn-nav-confirm:disabled { background: #6c757d; cursor: not-allowed; box-shadow: none; }
    .wizard-footer {
        position: fixed;
        bottom: 0;
        left: 280px;
        right: 0;
        background: #fff;
        border-top: 1px solid var(--border);
        padding: 0.875rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.08);
        z-index: 200;
    }
    @@media (max-width: 992px) {
        .wizard-footer { left: 0; }
    }
    .step-counter {
        font-size: 0.82rem;
        color: var(--text-secondary);
        font-weight: 500;
    }
    /* Estilos de validacion */
    .validation-section {
        background: white;
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1.25rem;
        border: 2px solid var(--border);
    }
    .validation-section.has-errors {
        border-color: #dc3545;
        background: rgba(220, 53, 69, 0.03);
    }
    .validation-section.all-valid {
        border-color: #28a745;
        background: rgba(40, 167, 69, 0.03);
    }
    .validation-title {
        font-weight: 700;
        font-size: 0.95rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .validation-title.error {
        color: #dc3545;
    }
    .validation-title.success {
        color: #28a745;
    }
    .validation-row {
        display: flex;
        align-items: stretch;
        margin-bottom: 0.75rem;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--border);
    }
    .validation-label {
        flex: 0 0 100px;
        background: var(--bg-main);
        padding: 0.75rem;
        font-weight: 600;
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        border-right: 1px solid var(--border);
    }
    .validation-values {
        flex: 1;
        display: flex;
    }
    .validation-col {
        flex: 1;
        padding: 0.75rem;
        text-align: center;
    }
    .validation-col-header {
        font-size: 0.7rem;
        color: var(--text-secondary);
        text-transform: uppercase;
        margin-bottom: 0.25rem;
    }
    .validation-col-value {
        font-weight: 600;
        font-size: 0.85rem;
        font-family: 'JetBrains Mono', monospace;
    }
    .validation-col:first-child {
        border-right: 1px solid var(--border);
    }
    .validation-status {
        flex: 0 0 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
    .validation-status.valid {
        background: rgba(40, 167, 69, 0.1);
        color: #28a745;
    }
    .validation-status.invalid {
        background: rgba(220, 53, 69, 0.1);
        color: #dc3545;
    }
    .validation-status.warning {
        background: rgba(255, 193, 7, 0.15);
        color: #e6a000;
    }
    .error-alert {
        background: rgba(220, 53, 69, 0.1);
        border: 1px solid rgba(220, 53, 69, 0.3);
        border-radius: 10px;
        padding: 1rem;
        margin-top: 1rem;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }
    .error-alert i {
        color: #dc3545;
        font-size: 1.25rem;
        margin-top: 0.1rem;
    }
    .error-alert-text {
        flex: 1;
    }
    .error-alert-text strong {
        color: #dc3545;
        display: block;
        margin-bottom: 0.25rem;
    }
    .error-alert-text p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.85rem;
    }

    @@media (max-width: 768px) {
        .pdf-fullscreen { height: calc(100vh - 160px); }
    }
</style>

<!-- Wizard Stepper -->
<div class="wizard-steps" id="vpStepper">
    <div class="step-indicator completed" id="vp-si-1">
        <div class="step-circle"><i class="bi bi-check-lg"></i></div>
        <div class="step-label">Revisar<br>Datos</div>
    </div>
    <div class="step-connector completed" id="vp-sc-1"></div>
    <div class="step-indicator completed" id="vp-si-2">
        <div class="step-circle"><i class="bi bi-check-lg"></i></div>
        <div class="step-label">Adjuntar<br>Comprobante</div>
    </div>
    <div class="step-connector completed" id="vp-sc-2"></div>
    <div class="step-indicator active" id="vp-si-3">
        <div class="step-circle">3</div>
        <div class="step-label">Ver<br>PDF</div>
    </div>
    <div class="step-connector" id="vp-sc-3"></div>
    <div class="step-indicator" id="vp-si-4">
        <div class="step-circle">4</div>
        <div class="step-label">Validar<br>y Enviar</div>
    </div>
</div>

<!-- PANEL PASO 3: Ver PDF -->
<div id="vp-panel-3" style="margin-bottom:5rem;">
    <div class="pdf-fullscreen">
        <iframe src="@Model.PdfTempPath" title="Vista previa del PDF"></iframe>
    </div>
</div>

<!-- PANEL PASO 4: Validar y Enviar -->
<div id="vp-panel-4" style="display:none;margin-bottom:5rem;">
    <div class="validation-panel">

        <!-- Resumen de validaciones -->
        <div class="validation-section @(puedeEnviar ? "all-valid" : "has-errors")" style="margin-bottom:1.25rem;">
            <div class="validation-title @(puedeEnviar ? "success" : "error")" style="margin-bottom:0.875rem;">
                @if (puedeEnviar && totalAdvertencias == 0)
                {
                    <i class="bi bi-check-circle-fill" style="color:#28a745;"></i>
                    <span style="color:#28a745;">Validaciones Correctas</span>
                }
                else if (puedeEnviar && totalAdvertencias > 0)
                {
                    <i class="bi bi-exclamation-triangle-fill" style="color:#e6a000;"></i>
                    <span style="color:#e6a000;">@totalAdvertencias advertencia(s) — Puede continuar</span>
                }
                else
                {
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@totalErrores error(es)@(totalAdvertencias > 0 ? $" y {totalAdvertencias} advertencia(s)" : "")</span>
                }
            </div>

            <div class="validation-row">
                <div class="validation-label">Tipo</div>
                <div class="validation-values">
                    <div class="validation-col"><div class="validation-col-header">Formulario</div><div class="validation-col-value">@tipoFormNombre</div></div>
                    <div class="validation-col"><div class="validation-col-header">XML</div><div class="validation-col-value">@tipoXmlNombre</div></div>
                </div>
                <div class="validation-status @(tipoCoincide ? "valid" : (Model.ValidaTipo ? "invalid" : "warning"))">
                    <i class="bi @(tipoCoincide ? "bi-check-lg" : (Model.ValidaTipo ? "bi-x-lg" : "bi-exclamation-triangle-fill"))"></i>
                </div>
            </div>
            <div class="validation-row">
                <div class="validation-label">Fecha</div>
                <div class="validation-values">
                    <div class="validation-col"><div class="validation-col-header">Formulario</div><div class="validation-col-value">@(Model.FechaEmision?.ToString("dd/MM/yyyy") ?? "-")</div></div>
                    <div class="validation-col"><div class="validation-col-header">XML</div><div class="validation-col-value">@(fechaEmisionXmlDate != DateTime.MinValue ? fechaEmisionXmlDate.ToString("dd/MM/yyyy") : fechaEmisionXmlStr)</div></div>
                </div>
                <div class="validation-status @(fechaEmisionCoincide ? "valid" : (Model.ValidaFechaEmision ? "invalid" : "warning"))">
                    <i class="bi @(fechaEmisionCoincide ? "bi-check-lg" : (Model.ValidaFechaEmision ? "bi-x-lg" : "bi-exclamation-triangle-fill"))"></i>
                </div>
            </div>
            <div class="validation-row">
                <div class="validation-label">Serie</div>
                <div class="validation-values">
                    <div class="validation-col"><div class="validation-col-header">Formulario</div><div class="validation-col-value">@(Model.Serie ?? "-")</div></div>
                    <div class="validation-col"><div class="validation-col-header">XML</div><div class="validation-col-value">@serieXml</div></div>
                </div>
                <div class="validation-status @(serieCoincide ? "valid" : (Model.ValidaSerie ? "invalid" : "warning"))">
                    <i class="bi @(serieCoincide ? "bi-check-lg" : (Model.ValidaSerie ? "bi-x-lg" : "bi-exclamation-triangle-fill"))"></i>
                </div>
            </div>
            <div class="validation-row">
                <div class="validation-label">N&uacute;mero</div>
                <div class="validation-values">
                    <div class="validation-col"><div class="validation-col-header">Formulario</div><div class="validation-col-value">@(Model.Numero ?? "-")</div></div>
                    <div class="validation-col"><div class="validation-col-header">XML</div><div class="validation-col-value">@numeroXml</div></div>
                </div>
                <div class="validation-status @(numeroCoincide ? "valid" : (Model.ValidaNumero ? "invalid" : "warning"))">
                    <i class="bi @(numeroCoincide ? "bi-check-lg" : (Model.ValidaNumero ? "bi-x-lg" : "bi-exclamation-triangle-fill"))"></i>
                </div>
            </div>
            <div class="validation-row">
                <div class="validation-label">RUC Emisor</div>
                <div class="validation-values">
                    <div class="validation-col"><div class="validation-col-header">Sistema</div><div class="validation-col-value mono">@(string.IsNullOrEmpty(rucEmisorSistema) ? "-" : rucEmisorSistema)</div></div>
                    <div class="validation-col"><div class="validation-col-header">XML</div><div class="validation-col-value mono">@(string.IsNullOrEmpty(rucEmisorXml) ? "-" : rucEmisorXml)</div></div>
                </div>
                <div class="validation-status @(rucEmisorCoincide ? "valid" : (Model.ValidaRucEmisor ? "invalid" : "warning"))">
                    <i class="bi @(rucEmisorCoincide ? "bi-check-lg" : (Model.ValidaRucEmisor ? "bi-x-lg" : "bi-exclamation-triangle-fill"))"></i>
                </div>
            </div>
            <div class="validation-row">
                <div class="validation-label">RUC Receptor</div>
                <div class="validation-values">
                    <div class="validation-col"><div class="validation-col-header">Sistema</div><div class="validation-col-value mono">@(string.IsNullOrEmpty(rucReceptorSistema) ? "-" : rucReceptorSistema)</div></div>
                    <div class="validation-col"><div class="validation-col-header">XML</div><div class="validation-col-value mono">@(string.IsNullOrEmpty(rucReceptorXml) ? "-" : rucReceptorXml)</div></div>
                </div>
                <div class="validation-status @(rucReceptorCoincide ? "valid" : (Model.ValidaRucReceptor ? "invalid" : "warning"))">
                    <i class="bi @(rucReceptorCoincide ? "bi-check-lg" : (Model.ValidaRucReceptor ? "bi-x-lg" : "bi-exclamation-triangle-fill"))"></i>
                </div>
            </div>
            <div class="validation-row">
                <div class="validation-label">Importe</div>
                <div class="validation-values">
                    <div class="validation-col"><div class="validation-col-header">Produccion</div><div class="validation-col-value">S/ @importeProduccion.ToString("N2")</div></div>
                    <div class="validation-col"><div class="validation-col-header">XML</div><div class="validation-col-value">S/ @importeXml.ToString("N2")</div></div>
                </div>
                <div class="validation-status @(importeCoincide ? "valid" : (Model.ValidaImporte ? "invalid" : "warning"))">
                    <i class="bi @(importeCoincide ? "bi-check-lg" : (Model.ValidaImporte ? "bi-x-lg" : "bi-exclamation-triangle-fill"))"></i>
                </div>
            </div>
            <div class="validation-row" style="flex-wrap:wrap;">
                <div class="validation-label">Concepto</div>
                <div class="validation-values" style="flex-direction:column;">
                    <div style="padding:0.5rem 0.75rem;border-bottom:1px solid var(--border);">
                        <div class="validation-col-header">Produccion</div>
                        <div style="font-size:0.8rem;font-weight:500;word-break:break-word;">@(string.IsNullOrEmpty(conceptoProduccion) ? "-" : conceptoProduccion)</div>
                    </div>
                    <div style="padding:0.5rem 0.75rem;">
                        <div class="validation-col-header">XML (Primer Item)</div>
                        <div style="font-size:0.8rem;font-weight:500;word-break:break-word;">@(string.IsNullOrEmpty(conceptoXml) ? "-" : conceptoXml)</div>
                    </div>
                </div>
                <div class="validation-status @(conceptoCoincide ? "valid" : (Model.ValidaConcepto ? "invalid" : "warning"))">
                    <i class="bi @(conceptoCoincide ? "bi-check-lg" : (Model.ValidaConcepto ? "bi-x-lg" : "bi-exclamation-triangle-fill"))"></i>
                </div>
            </div>

            @if (!puedeEnviar)
            {
                <div class="error-alert">
                    <i class="bi bi-x-circle-fill"></i>
                    <div class="error-alert-text">
                        <strong>No puede enviar esta factura</strong>
                        <p>Los datos no coinciden con el XML. Regrese y corrija los datos o suba el archivo correcto.</p>
                    </div>
                </div>
            }
        </div>

        <!-- Datos del XML -->
        <div class="xml-section">
            <div class="xml-section-title"><i class="bi bi-receipt"></i> Datos del Comprobante (XML)</div>
            <div class="xml-data-grid">
                <div class="xml-field"><span class="xml-label">Tipo</span><span class="xml-value">@(Model.DatosXml?.DatosGenerales.TipoDocumento ?? "-")</span></div>
                <div class="xml-field"><span class="xml-label">N&uacute;mero</span><span class="xml-value mono">@(Model.DatosXml?.DatosGenerales.NumeroFactura ?? "-")</span></div>
                <div class="xml-field"><span class="xml-label">Fecha Emisi&oacute;n</span><span class="xml-value">@(fechaEmisionXmlDate != DateTime.MinValue ? fechaEmisionXmlDate.ToString("dd/MM/yyyy") : (Model.DatosXml?.DatosGenerales.FechaEmision ?? "-"))</span></div>
                <div class="xml-field"><span class="xml-label">Moneda</span><span class="xml-value">@(Model.DatosXml?.DatosGenerales.Moneda ?? "-")</span></div>
            </div>
        </div>
        <div class="xml-section">
            <div class="xml-section-title"><i class="bi bi-building"></i> Emisor</div>
            <div class="xml-field" style="margin-bottom:0.5rem;"><span class="xml-label">RUC</span><span class="xml-value mono">@(Model.DatosXml?.Emisor.Ruc ?? "-")</span></div>
            <div class="xml-field"><span class="xml-label">Raz&oacute;n Social</span><span class="xml-value">@(Model.DatosXml?.Emisor.RazonSocial ?? "-")</span></div>
        </div>
        <div class="xml-section">
            <div class="xml-section-title"><i class="bi bi-person"></i> Cliente</div>
            <div class="xml-data-grid">
                <div class="xml-field"><span class="xml-label">RUC/DNI</span><span class="xml-value mono">@(Model.DatosXml?.Cliente.NumeroDocumento ?? "-")</span></div>
                <div class="xml-field"><span class="xml-label">Raz&oacute;n Social</span><span class="xml-value">@(Model.DatosXml?.Cliente.RazonSocial ?? "-")</span></div>
            </div>
        </div>
        <div class="xml-section">
            <div class="xml-section-title"><i class="bi bi-calculator"></i> Totales</div>
            <div class="xml-data-grid">
                <div class="xml-field"><span class="xml-label">Valor Venta</span><span class="xml-value">S/ @(Model.DatosXml?.DesgloseTotales.ValorVenta.ToString("N2") ?? "0.00")</span></div>
                <div class="xml-field">
                    @if (Model.TipoComprobante == "22")
                    { <span class="xml-label">Retenci&oacute;n</span><span class="xml-value">S/ @(Model.DatosXml?.DesgloseTotales.Retencion.ToString("N2") ?? "0.00")</span> }
                    else
                    { <span class="xml-label">IGV</span><span class="xml-value">S/ @(Model.DatosXml?.DesgloseTotales.Igv.ToString("N2") ?? "0.00")</span> }
                </div>
            </div>
            <div class="total-highlight"><span class="xml-label">IMPORTE TOTAL</span><span class="total-amount">S/ @(Model.DatosXml?.DesgloseTotales.ImporteTotal.ToString("N2") ?? "0.00")</span></div>
        </div>
        @if (Model.DatosXml?.DetalleItems != null && Model.DatosXml.DetalleItems.Count > 0)
        {
            <div class="xml-section">
                <div class="xml-section-title"><i class="bi bi-list-ul"></i> Items (@Model.DatosXml.DetalleItems.Count)</div>
                @foreach (var item in Model.DatosXml.DetalleItems)
                {
                    <div class="item-row">
                        <div style="font-weight:600;margin-bottom:0.2rem;">@item.Descripcion</div>
                        <div style="display:flex;justify-content:space-between;color:var(--text-secondary);font-size:0.78rem;">
                            <span>@item.Cantidad @item.UnidadMedida x S/ @item.PrecioUnitario.ToString("N2")</span>
                            <span style="font-weight:600;color:var(--text-primary);">S/ @item.ValorVenta.ToString("N2")</span>
                        </div>
                    </div>
                }
            </div>
        }

    </div><!-- /validation-panel -->
</div><!-- /vp-panel-4 -->


<!-- ===== STICKY FOOTER ===== -->
<div class="wizard-footer">
    <!-- Izquierda -->
    <div>
        <!-- Paso 3: vuelve al Paso 2 conservando la sesion -->
        <a href="@Url.Action("Subir", "Facturas", new { guid = Model.GuidRegistro, sessionId = Model.SessionId })"
           id="vpBtnCancelar" class="btn-nav-back">
            <i class="bi bi-arrow-left"></i> Anterior
        </a>
        <button type="button" id="vpBtnAnterior" class="btn-nav-back" onclick="irPasoVP(3)" style="display:none;">
            <i class="bi bi-arrow-left"></i> Anterior
        </button>
    </div>

    <span class="step-counter" id="vpStepCounter">Paso 3 de 4</span>

    <!-- Derecha -->
    <div>
        <button type="button" id="vpBtnSiguiente" class="btn-nav-confirm" onclick="irPasoVP(4)">
            Siguiente <i class="bi bi-arrow-right"></i>
        </button>
        @if (puedeEnviar)
        {
            <button type="button" id="btnConfirmarEnvio" class="btn-nav-confirm" style="display:none;">
                <i class="bi bi-send-fill"></i> Confirmar y Enviar
            </button>
        }
        else
        {
            <button type="button" id="btnConfirmarEnvio" disabled class="btn-nav-confirm" style="display:none;" title="Corrija los errores para poder enviar">
                <i class="bi bi-lock-fill"></i> No puede enviar
            </button>
        }
    </div>
</div>

@section Scripts {
    <script>
        function irPasoVP(paso) {
            var p3 = document.getElementById('vp-panel-3');
            var p4 = document.getElementById('vp-panel-4');
            p3.style.display = paso === 3 ? 'block' : 'none';
            p4.style.display = paso === 4 ? 'block' : 'none';

            // Stepper
            [3, 4].forEach(function(i) {
                var si = document.getElementById('vp-si-' + i);
                si.classList.remove('active', 'completed');
                if (i < paso)  si.classList.add('completed');
                if (i === paso) si.classList.add('active');
            });
            document.getElementById('vp-sc-3').classList.toggle('completed', paso === 4);

            // Footer
            var btnCancelar  = document.getElementById('vpBtnCancelar');
            var btnAnterior  = document.getElementById('vpBtnAnterior');
            var btnSiguiente = document.getElementById('vpBtnSiguiente');
            var btnConfirmar = document.getElementById('btnConfirmarEnvio');
            var counter      = document.getElementById('vpStepCounter');

            btnCancelar.style.display  = paso === 3 ? 'inline-flex' : 'none';
            btnAnterior.style.display  = paso === 4 ? 'inline-flex' : 'none';
            btnSiguiente.style.display = paso === 3 ? 'inline-flex' : 'none';
            if (btnConfirmar) btnConfirmar.style.display = paso === 4 ? 'inline-flex' : 'none';
            counter.textContent = 'Paso ' + paso + ' de 4';

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        document.addEventListener('DOMContentLoaded', function() {
            var btnConfirmar = document.getElementById('btnConfirmarEnvio');
            var sessionId = '@Model.SessionId';
            var puedeEnviar = @(puedeEnviar ? "true" : "false");

            if (btnConfirmar && puedeEnviar) {
                btnConfirmar.addEventListener('click', function() {
                    Swal.fire({
                        title: 'Confirmar Envio',
                        text: '¿Esta seguro de enviar esta factura? Esta accion no se puede deshacer.',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#f26522',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Si, Enviar',
                        cancelButtonText: 'Cancelar'
                    }).then(function(result) {
                        if (result.isConfirmed) {
                            btnConfirmar.disabled = true;

                            // Bloquear pantalla con spinner
                            Swal.fire({
                                title: 'Enviando comprobante...',
                                text: 'Registrando datos, por favor espere.',
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                showConfirmButton: false,
                                didOpen: function() { Swal.showLoading(); }
                            });

                            var formData = new FormData();
                            formData.append('sessionId', sessionId);

                            fetch('@Url.Action("ConfirmarEnvio", "Facturas")', {
                                method: 'POST',
                                body: formData
                            })
                            .then(function(response) { return response.json(); })
                            .then(function(data) {
                                if (data.success) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Factura Enviada',
                                        text: data.message,
                                        confirmButtonColor: '#28a745',
                                        allowOutsideClick: false
                                    }).then(function() {
                                        window.location.href = '@Url.Action("Enviadas", "Facturas")';
                                    });
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error',
                                        text: data.message,
                                        confirmButtonColor: '#dc3545'
                                    });
                                    btnConfirmar.disabled = false;
                                    btnConfirmar.innerHTML = '<i class="bi bi-send-fill"></i> Confirmar y Enviar';
                                }
                            })
                            .catch(function(error) {
                                console.error('Error:', error);
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: 'Ocurrio un error al enviar la factura.',
                                    confirmButtonColor: '#dc3545'
                                });
                                btnConfirmar.disabled = false;
                                btnConfirmar.innerHTML = '<i class="bi bi-send-fill"></i> Confirmar y Enviar';
                            });
                        }
                    });
                });
            }
        });

        // Ajustar footer cuando el sidebar se oculta/muestra en desktop
        (function () {
            var sidebar = document.getElementById('sidebar');
            if (!sidebar) return;
            var footer  = document.querySelector('.wizard-footer');
            if (!footer) return;
            var observer = new MutationObserver(function () {
                var hidden = sidebar.classList.contains('hidden');
                footer.style.left = (window.innerWidth > 992 && !hidden) ? '280px' : '0';
            });
            observer.observe(sidebar, { attributes: true, attributeFilter: ['class'] });
        })();
    </script>
}
