@model SHM.AppWebCompaniaMedica.Models.VistaPreviaFacturaViewModel
@{
    var numeroFacturaXml = Model.DatosXml?.DatosGenerales.NumeroFactura ?? "";
    var partesXml = numeroFacturaXml.Split('-');
    var serieXml  = partesXml.Length > 0 ? partesXml[0] : "";
    var numeroXml = partesXml.Length > 1 ? partesXml[1] : "";

    int.TryParse(numeroXml, out var numeroXmlInt);
    int.TryParse(Model.Numero, out var numeroFormInt);

    var tipoComprobanteXml  = Model.DatosXml?.DatosGenerales.CodigoTipoDocumento ?? "";
    var tipoComprobanteForm = Model.TipoComprobante ?? "";
    var tipoNorm = tipoComprobanteForm == "1" ? "01" : tipoComprobanteForm == "22" ? "02" : tipoComprobanteForm;
    var tipoCoincide = string.Equals(tipoNorm.Trim(), tipoComprobanteXml.Trim(), StringComparison.OrdinalIgnoreCase);
    var tipoNombres = new Dictionary<string, string> { {"1","Factura"}, {"22","Recibo por Honorarios"} };
    var tipoFormNombre = tipoNombres.ContainsKey(tipoComprobanteForm) ? tipoNombres[tipoComprobanteForm] : tipoComprobanteForm;
    var tipoXmlNombre  = Model.DatosXml?.DatosGenerales.TipoDocumento ?? tipoComprobanteXml;

    var fechaEmisionXmlStr = Model.DatosXml?.DatosGenerales.FechaEmision ?? "";
    DateTime.TryParse(fechaEmisionXmlStr, out var fechaEmisionXmlDate);
    var fechaEmisionFormDate = Model.FechaEmision?.Date ?? DateTime.MinValue;
    var fechaEmisionCoincide = fechaEmisionFormDate == fechaEmisionXmlDate.Date;

    var serieCoincide  = string.Equals(Model.Serie?.Trim(), serieXml?.Trim(), StringComparison.OrdinalIgnoreCase);
    var numeroCoincide = numeroXmlInt == numeroFormInt;

    var rucEmisorSistema  = Model.EmisorRuc ?? "";
    var rucEmisorXml      = Model.DatosXml?.Emisor.Ruc ?? "";
    var rucEmisorCoincide = string.Equals(rucEmisorSistema.Trim(), rucEmisorXml.Trim(), StringComparison.OrdinalIgnoreCase);

    var rucReceptorSistema  = Model.ReceptorRuc ?? "";
    var rucReceptorXml      = Model.DatosXml?.Cliente.NumeroDocumento ?? "";
    var rucReceptorCoincide = string.Equals(rucReceptorSistema.Trim(), rucReceptorXml.Trim(), StringComparison.OrdinalIgnoreCase);

    var importeXml        = Model.DatosXml?.DesgloseTotales.ImporteTotal ?? 0;
    var importeProduccion = Model.MtoTotal ?? 0;
    var importeCoincide   = Math.Abs(importeProduccion - importeXml) <= 0.01m;

    var conceptoXml        = Model.DatosXml?.DetalleItems?.FirstOrDefault()?.Descripcion ?? "";
    var conceptoProduccion = Model.Concepto ?? "";
    var conceptoCoincide   = string.Equals(conceptoProduccion.Trim(), conceptoXml.Trim(), StringComparison.OrdinalIgnoreCase);

    var puedeEnviar       = true;
    var totalErrores      = 0;
    var totalAdvertencias = 0;

    if (Model.ValidaTipo && !tipoCoincide)                    { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaTipo && !tipoCoincide)              { totalAdvertencias++; }
    if (Model.ValidaFechaEmision && !fechaEmisionCoincide)    { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaFechaEmision && !fechaEmisionCoincide) { totalAdvertencias++; }
    if (Model.ValidaSerie && !serieCoincide)                  { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaSerie && !serieCoincide)            { totalAdvertencias++; }
    if (Model.ValidaNumero && !numeroCoincide)                { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaNumero && !numeroCoincide)          { totalAdvertencias++; }
    if (Model.ValidaRucEmisor && !rucEmisorCoincide)          { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaRucEmisor && !rucEmisorCoincide)    { totalAdvertencias++; }
    if (Model.ValidaRucReceptor && !rucReceptorCoincide)      { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaRucReceptor && !rucReceptorCoincide){ totalAdvertencias++; }
    if (Model.ValidaImporte && !importeCoincide)              { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaImporte && !importeCoincide)        { totalAdvertencias++; }
    if (Model.ValidaConcepto && !conceptoCoincide)            { puedeEnviar = false; totalErrores++; }
    else if (!Model.ValidaConcepto && !conceptoCoincide)      { totalAdvertencias++; }
}

<style>
    .val-panel { max-width: 860px; margin: 0 auto; }
    .val-section {
        background: #fff;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.25rem;
        border: 2px solid var(--border);
    }
    .val-section.has-errors  { border-color: #dc3545; background: rgba(220,53,69,0.02); }
    .val-section.has-warnings{ border-color: #e6a000; background: rgba(255,193,7,0.03); }
    .val-section.all-valid   { border-color: #28a745; background: rgba(40,167,69,0.02); }

    .val-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        font-size: 0.95rem;
        margin-bottom: 0.875rem;
        padding-bottom: 0.625rem;
        border-bottom: 1px solid var(--border);
    }
    .val-header.ok      { color: #28a745; }
    .val-header.warn    { color: #e6a000; }
    .val-header.error   { color: #dc3545; }

    .val-list { display: flex; flex-direction: column; gap: 0.3rem; }

    .val-item {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.35rem 0.6rem;
        border-radius: 7px;
        font-size: 0.875rem;
        line-height: 1.4;
    }
    .val-item.ok   { background: rgba(40,167,69,0.06); }
    .val-item.warn { background: rgba(255,193,7,0.1); }
    .val-item.err  { background: rgba(220,53,69,0.07); }

    .val-item i { font-size: 0.85rem; flex-shrink: 0; margin-top: 2px; }
    .val-item.ok   i { color: #28a745; }
    .val-item.warn i { color: #e6a000; }
    .val-item.err  i { color: #dc3545; }

    .val-name  { font-weight: 600; color: var(--text-primary); white-space: nowrap; }
    .val-diff  { color: var(--text-secondary); font-size: 0.82rem; }
    .val-vals  { font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; }
    .val-vals .form-val { color: var(--text-primary); font-weight: 600; }
    .val-vals .xml-val  { color: #3B82F6; font-weight: 600; }

    .val-error-alert {
        display: flex; align-items: flex-start; gap: 0.75rem;
        background: rgba(220,53,69,0.08); border: 1px solid rgba(220,53,69,0.25);
        border-radius: 10px; padding: 0.875rem 1rem; margin-top: 0.75rem;
    }
    .val-error-alert i { color: #dc3545; font-size: 1.2rem; margin-top: 1px; flex-shrink:0; }
    .val-error-alert strong { color: #dc3545; display:block; margin-bottom:0.2rem; }
    .val-error-alert p { margin:0; color: var(--text-secondary); font-size: 0.83rem; }

    /* Sección datos XML */
    .xml-section { margin-bottom: 1.25rem; }
    .xml-section-title { font-weight:700; color:var(--primary); font-size:0.875rem; margin-bottom:0.75rem; padding-bottom:0.5rem; border-bottom:2px solid var(--accent); display:flex; align-items:center; gap:0.5rem; }
    .xml-data-grid { display:grid; grid-template-columns:1fr 1fr; gap:0.6rem; }
    .xml-field { background:var(--bg-main); padding:0.5rem 0.75rem; border-radius:8px; }
    .xml-label { font-size:0.72rem; color:var(--text-secondary); display:block; margin-bottom:0.15rem; }
    .xml-value { font-weight:600; font-size:0.875rem; color:var(--text-primary); }
    .xml-value.mono { font-family:'JetBrains Mono',monospace; }
    .total-highlight { background:rgba(242,101,34,0.1); padding:0.75rem; border-radius:10px; margin-top:0.5rem; display:flex; justify-content:space-between; align-items:center; }
    .total-amount { font-size:1.25rem; font-weight:700; color:var(--accent); }
    .item-row { padding:0.5rem 0.75rem; border-radius:8px; margin-bottom:0.35rem; font-size:0.82rem; }
    .item-row:nth-child(odd)  { background:var(--bg-main); }
    .item-row:nth-child(even) { background:#fff; border:1px solid var(--border); }
</style>

<div id="validacionContent"
     data-puede-enviar="@puedeEnviar.ToString().ToLower()"
     data-session-id="@Model.SessionId">

    <div class="val-panel">

        <!-- ── Sección de validaciones ── -->
        <div class="val-section @(totalErrores > 0 ? "has-errors" : totalAdvertencias > 0 ? "has-warnings" : "all-valid")">

            <div class="val-header @(totalErrores > 0 ? "error" : totalAdvertencias > 0 ? "warn" : "ok")">
                @if (totalErrores > 0)
                {
                    <i class="bi bi-x-circle-fill"></i>
                    <span>@totalErrores error(es)@(totalAdvertencias > 0 ? $" y {totalAdvertencias} advertencia(s)" : "") — No puede enviar</span>
                }
                else if (totalAdvertencias > 0)
                {
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@totalAdvertencias advertencia(s) — Puede continuar</span>
                }
                else
                {
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Todas las validaciones correctas</span>
                }
            </div>

            <div class="val-list">
                @{
                    void FilaCompacta(string label, string valForm, string valXml, bool coincide, bool esError) {
                        var cls  = coincide ? "ok"  : (esError ? "err" : "warn");
                        var icon = coincide ? "bi-check-circle-fill" : (esError ? "bi-x-circle-fill" : "bi-exclamation-triangle-fill");
                        <div class="val-item @cls">
                            <i class="bi @icon"></i>
                            <span class="val-name">@label</span>
                            @if (!coincide)
                            {
                                <span class="val-diff">
                                    &mdash; no coincide con el XML
                                    <span class="val-vals">
                                        (<span class="form-val">@valForm</span>
                                        &nbsp;&rarr;&nbsp;XML:&nbsp;<span class="xml-val">@valXml</span>)
                                    </span>
                                </span>
                            }
                        </div>
                    }
                }

                @{ FilaCompacta("Tipo de Comprobante",  tipoFormNombre, tipoXmlNombre, tipoCoincide, Model.ValidaTipo); }
                @{ FilaCompacta("Fecha de Emisión",     Model.FechaEmision?.ToString("dd/MM/yyyy") ?? "-", fechaEmisionXmlDate != DateTime.MinValue ? fechaEmisionXmlDate.ToString("dd/MM/yyyy") : fechaEmisionXmlStr, fechaEmisionCoincide, Model.ValidaFechaEmision); }
                @{ FilaCompacta("Serie",                Model.Serie ?? "-", serieXml ?? "-", serieCoincide, Model.ValidaSerie); }
                @{ FilaCompacta("Número",               Model.Numero ?? "-", numeroXml ?? "-", numeroCoincide, Model.ValidaNumero); }
                @{ FilaCompacta("RUC Emisor",           string.IsNullOrEmpty(rucEmisorSistema) ? "-" : rucEmisorSistema, string.IsNullOrEmpty(rucEmisorXml) ? "-" : rucEmisorXml, rucEmisorCoincide, Model.ValidaRucEmisor); }
                @{ FilaCompacta("RUC Receptor",         string.IsNullOrEmpty(rucReceptorSistema) ? "-" : rucReceptorSistema, string.IsNullOrEmpty(rucReceptorXml) ? "-" : rucReceptorXml, rucReceptorCoincide, Model.ValidaRucReceptor); }
                @{ FilaCompacta("Importe Total",        $"S/ {importeProduccion:N2}", $"S/ {importeXml:N2}", importeCoincide, Model.ValidaImporte); }
                @{ FilaCompacta("Concepto",             string.IsNullOrEmpty(conceptoProduccion) ? "-" : conceptoProduccion, string.IsNullOrEmpty(conceptoXml) ? "-" : conceptoXml, conceptoCoincide, Model.ValidaConcepto); }
            </div>

            @if (!puedeEnviar)
            {
                <div class="val-error-alert">
                    <i class="bi bi-x-circle-fill"></i>
                    <div>
                        <strong>No puede enviar esta factura</strong>
                        <p>Corrija los datos en el Paso 2 o suba el archivo correcto antes de continuar.</p>
                    </div>
                </div>
            }
        </div>

        @* ── Datos del XML (comentado temporalmente) ──
        <div class="xml-section">
            <div class="xml-section-title"><i class="bi bi-receipt"></i> Datos del Comprobante (XML)</div>
            <div class="xml-data-grid">
                <div class="xml-field"><span class="xml-label">Tipo</span><span class="xml-value">@(Model.DatosXml?.DatosGenerales.TipoDocumento ?? "-")</span></div>
                <div class="xml-field"><span class="xml-label">Número</span><span class="xml-value mono">@(Model.DatosXml?.DatosGenerales.NumeroFactura ?? "-")</span></div>
                <div class="xml-field"><span class="xml-label">Fecha Emisión</span><span class="xml-value">@(fechaEmisionXmlDate != DateTime.MinValue ? fechaEmisionXmlDate.ToString("dd/MM/yyyy") : (Model.DatosXml?.DatosGenerales.FechaEmision ?? "-"))</span></div>
                <div class="xml-field"><span class="xml-label">Moneda</span><span class="xml-value">@(Model.DatosXml?.DatosGenerales.Moneda ?? "-")</span></div>
            </div>
        </div>
        <div class="xml-section">
            <div class="xml-section-title"><i class="bi bi-building"></i> Emisor</div>
            <div class="xml-data-grid">
                <div class="xml-field"><span class="xml-label">RUC</span><span class="xml-value mono">@(Model.DatosXml?.Emisor.Ruc ?? "-")</span></div>
                <div class="xml-field"><span class="xml-label">Razón Social</span><span class="xml-value">@(Model.DatosXml?.Emisor.RazonSocial ?? "-")</span></div>
            </div>
        </div>
        <div class="xml-section">
            <div class="xml-section-title"><i class="bi bi-person"></i> Cliente</div>
            <div class="xml-data-grid">
                <div class="xml-field"><span class="xml-label">RUC/DNI</span><span class="xml-value mono">@(Model.DatosXml?.Cliente.NumeroDocumento ?? "-")</span></div>
                <div class="xml-field"><span class="xml-label">Razón Social</span><span class="xml-value">@(Model.DatosXml?.Cliente.RazonSocial ?? "-")</span></div>
            </div>
        </div>
        <div class="xml-section">
            <div class="xml-section-title"><i class="bi bi-calculator"></i> Totales</div>
            <div class="xml-data-grid">
                <div class="xml-field"><span class="xml-label">Valor Venta</span><span class="xml-value">S/ @(Model.DatosXml?.DesgloseTotales.ValorVenta.ToString("N2") ?? "0.00")</span></div>
                <div class="xml-field">
                    @if (Model.TipoComprobante == "22")
                    { <span class="xml-label">Retención</span><span class="xml-value">S/ @(Model.DatosXml?.DesgloseTotales.Retencion.ToString("N2") ?? "0.00")</span> }
                    else
                    { <span class="xml-label">IGV</span><span class="xml-value">S/ @(Model.DatosXml?.DesgloseTotales.Igv.ToString("N2") ?? "0.00")</span> }
                </div>
            </div>
            <div class="total-highlight">
                <span class="xml-label" style="font-size:0.8rem;">IMPORTE TOTAL</span>
                <span class="total-amount">S/ @(Model.DatosXml?.DesgloseTotales.ImporteTotal.ToString("N2") ?? "0.00")</span>
            </div>
        </div>
        @if (Model.DatosXml?.DetalleItems != null && Model.DatosXml.DetalleItems.Count > 0)
        {
            <div class="xml-section">
                <div class="xml-section-title"><i class="bi bi-list-ul"></i> Items (@Model.DatosXml.DetalleItems.Count)</div>
                @foreach (var item in Model.DatosXml.DetalleItems)
                {
                    <div class="item-row">
                        <div style="font-weight:600;margin-bottom:0.15rem;">@item.Descripcion</div>
                        <div style="display:flex;justify-content:space-between;color:var(--text-secondary);font-size:0.78rem;">
                            <span>@item.Cantidad @item.UnidadMedida &times; S/ @item.PrecioUnitario.ToString("N2")</span>
                            <span style="font-weight:600;color:var(--text-primary);">S/ @item.ValorVenta.ToString("N2")</span>
                        </div>
                    </div>
                }
            </div>
        }
        *@

    </div>
</div>
