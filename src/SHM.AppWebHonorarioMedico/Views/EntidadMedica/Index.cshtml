@{
    ViewData["Title"] = "Entidades Medicas";
}

<div class="wrapper">
    <div class="content-wrapper">
        
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0 titulo-formulario">
                            <i class="fas fa-hospital mr-2"></i>Entidades Medicas
                        </h1>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-right">
                            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                            <li class="breadcrumb-item active">Entidades Medicas</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="input-group input-group-sm">
                                    <input type="text" id="txtSearchTerm" class="form-control"
                                           placeholder="Buscar por razon social, RUC o codigo..."
                                           style="width: 300px;">
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-default" onclick="searchList()">
                                            <i class="fas fa-search"></i>
                                        </button>
                                        <button type="button" class="btn btn-default" onclick="clearSearch()" title="Limpiar busqueda">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 text-right">
                                <button type="button" class="btn btn-morado btn-sm" onclick="openCreateModal()">
                                    <i class="fas fa-plus mr-1"></i>Nueva Entidad
                                </button>
                            </div>
                        </div>
                    </div>
                    <!-- Contenedor para la lista cargada via AJAX -->
                    <div id="listContainer">
                        <div class="card-body text-center py-5">
                            <i class="fas fa-spinner fa-spin fa-2x"></i>
                            <p class="mt-2">Cargando...</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<!-- Modal Container -->
<div id="modalContainer"></div>

<!-- Token antiforgery siempre disponible para llamadas AJAX -->
@Html.AntiForgeryToken()

@section Scripts {
    <script>
        let currentPage = 1;
        const pageSize = 10;
        let searchTerm = '';

        // Recargar lista de usuarios cuando se cierra el modal de crear/editar usuario
        $(document).on('hidden.bs.modal', '#usuarioCreateModal, #usuarioEditModal', function () {
            $('#usuarioEntidadBodyContainer').remove();
            if (currentEntidadGuidUsuarios) {
                loadUsuariosEntidad();
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            // Cargar lista inicial
            loadList(1);

            // Buscar al presionar Enter
            document.getElementById('txtSearchTerm').addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    searchList();
                }
            });

            // Validar solo numeros en campos con clase only-numbers
            document.addEventListener('input', function (e) {
                if (e.target.classList.contains('only-numbers')) {
                    e.target.value = e.target.value.replace(/[^0-9]/g, '');
                }
            });
        });

        function loadList(page) {
            currentPage = page || 1;
            searchTerm = document.getElementById('txtSearchTerm').value || '';

            const params = new URLSearchParams({
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            });

            f_loading();
            fetch('@Url.Action("GetList")?' + params.toString())
                .then(response => {
                    if (!response.ok) throw new Error('Error en la respuesta');
                    return response.text();
                })
                .then(html => {
                    document.getElementById('listContainer').innerHTML = html;
                    f_remove_loading();
                })
                .catch(error => {
                    f_remove_loading();
                    document.getElementById('listContainer').innerHTML =
                        '<div class="card-body text-center text-danger py-4">' +
                        '<i class="fas fa-exclamation-triangle fa-2x mb-2"></i>' +
                        '<p>Error al cargar la lista</p></div>';
                });
        }

        function searchList() {
            loadList(1);
        }

        function clearSearch() {
            document.getElementById('txtSearchTerm').value = '';
            loadList(1);
        }

        function refreshList() {
            loadList(currentPage);
        }

        function openCreateModal() {
            f_loading();
            fetch('@Url.Action("GetCreateModal")')
                .then(response => {
                    if (!response.ok) throw new Error('Error en la respuesta');
                    return response.text();
                })
                .then(html => {
                    document.getElementById('modalContainer').innerHTML = html;
                    $('#createModal').modal('show');
                    f_remove_loading();
                })
                .catch(error => {
                    f_remove_loading();
                    f_alert('e', '', 'Error al cargar el formulario');
                });
        }

        function openEditModal(guid) {
            f_loading();
            fetch('@Url.Action("GetEditModal")?guid=' + encodeURIComponent(guid))
                .then(response => {
                    if (!response.ok) throw new Error('Error en la respuesta');
                    return response.text();
                })
                .then(html => {
                    document.getElementById('modalContainer').innerHTML = html;
                    $('#editModal').modal('show');
                    f_remove_loading();
                })
                .catch(error => {
                    f_remove_loading();
                    f_alert('e', '', 'Error al cargar el formulario');
                });
        }

        function openDeleteModal(guid) {
            f_loading();
            fetch('@Url.Action("GetDeleteModal")?guid=' + encodeURIComponent(guid))
                .then(response => {
                    if (!response.ok) throw new Error('Error en la respuesta');
                    return response.text();
                })
                .then(html => {
                    document.getElementById('modalContainer').innerHTML = html;
                    $('#deleteModal').modal('show');
                    f_remove_loading();
                })
                .catch(error => {
                    f_remove_loading();
                    f_alert('e', '', 'Error al cargar el formulario');
                });
        }

        function submitCreate() {
            const form = document.getElementById('createForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const data = {
                CodigoEntidad: document.getElementById('create_CodigoEntidad').value,
                RazonSocial: document.getElementById('create_RazonSocial').value,
                Ruc: document.getElementById('create_Ruc').value,
                TipoEntidadMedica: document.getElementById('create_TipoEntidadMedica').value,
                Telefono: document.getElementById('create_Telefono').value,
                Celular: document.getElementById('create_Celular').value,
                CodigoAcreedor: document.getElementById('create_CodigoAcreedor').value
            };

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            f_loading();
            fetch('@Url.Action("Create")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                f_remove_loading();
                if (result.success) {
                    $('#createModal').modal('hide');
                    toastr.success(result.message, 'Exito');
                    refreshList();
                } else {
                    f_alert('e', '', result.message);
                }
            })
            .catch(error => {
                f_remove_loading();
                f_alert('e', '', 'Error al procesar la solicitud');
            });
        }

        function submitEdit() {
            const form = document.getElementById('editForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const data = {
                GuidRegistro: document.getElementById('edit_GuidRegistro').value,
                CodigoEntidad: document.getElementById('edit_CodigoEntidad').value,
                RazonSocial: document.getElementById('edit_RazonSocial').value,
                Ruc: document.getElementById('edit_Ruc').value,
                TipoEntidadMedica: document.getElementById('edit_TipoEntidadMedica').value,
                Telefono: document.getElementById('edit_Telefono').value,
                Celular: document.getElementById('edit_Celular').value,
                CodigoAcreedor: document.getElementById('edit_CodigoAcreedor').value,
                Activo: document.getElementById('edit_Activo').checked ? 1 : 0
            };

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            f_loading();
            fetch('@Url.Action("Edit")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                f_remove_loading();
                if (result.success) {
                    $('#editModal').modal('hide');
                    toastr.success(result.message, 'Exito');
                    refreshList();
                } else {
                    f_alert('e', '', result.message);
                }
            })
            .catch(error => {
                f_remove_loading();
                f_alert('e', '', 'Error al procesar la solicitud');
            });
        }

        function submitDelete(guidRegistro) {
            const data = {
                GuidRegistro: guidRegistro
            };

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            f_loading();
            fetch('@Url.Action("Delete")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                f_remove_loading();
                if (result.success) {
                    $('#deleteModal').modal('hide');
                    toastr.success(result.message, 'Exito');
                    refreshList();
                } else {
                    f_alert('e', '', result.message);
                }
            })
            .catch(error => {
                f_remove_loading();
                f_alert('e', '', 'Error al procesar la solicitud');
            });
        }

        // Funciones para Usuarios por Entidad
        let currentEntidadGuidUsuarios = '';

        function openUsuariosEntidadModal(guid) {
            currentEntidadGuidUsuarios = guid;
            f_loading();
            fetch('@Url.Action("GetUsuariosEntidadModal")?guid=' + encodeURIComponent(guid))
                .then(response => {
                    if (!response.ok) throw new Error('Error en la respuesta');
                    return response.text();
                })
                .then(html => {
                    document.getElementById('modalContainer').innerHTML = html;
                    $('#usuariosEntidadModal').modal('show');
                    f_remove_loading();
                })
                .catch(error => {
                    f_remove_loading();
                    f_alert('e', '', 'Error al cargar los usuarios');
                });
        }

        function loadUsuariosEntidad() {
            fetch('@Url.Action("GetListUsuariosEntidad")?entidadGuid=' + encodeURIComponent(currentEntidadGuidUsuarios))
                .then(response => response.text())
                .then(html => {
                    document.getElementById('usuariosEntidadListContainer').innerHTML = html;
                })
                .catch(() => {
                    document.getElementById('usuariosEntidadListContainer').innerHTML =
                        '<div class="text-center text-danger py-3">Error al cargar usuarios</div>';
                });
        }

        function wrapEnModal(id, html) {
            return '<div class="modal fade" id="' + id + '" tabindex="-1" role="dialog" aria-hidden="true" style="z-index:1060">' +
                       '<div class="modal-dialog modal-lg" role="document">' +
                           '<div class="modal-content">' + html + '</div>' +
                       '</div>' +
                   '</div>';
        }

        function openCreateUsuarioEntidad(idEntidadMedica) {
            fetch('/Usuario/GetCreateModal?idEntidadMedica=' + idEntidadMedica)
                .then(response => response.text())
                .then(html => {
                    $('#usuarioEntidadBodyContainer').remove();
                    $('body').append('<div id="usuarioEntidadBodyContainer">' + wrapEnModal('usuarioCreateModal', html) + '</div>');
                    // Preseleccionar rol Compania Medica
                    var $rol = $('#usuarioCreateModal #IdRol');
                    $rol.find('option').each(function () {
                        if ($(this).text().toUpperCase().indexOf('COMPAN') > -1 ||
                            $(this).text().toUpperCase().indexOf('COMPA\u00D1') > -1) {
                            $rol.val($(this).val());
                            return false;
                        }
                    });
                    // Redirigir boton Guardar a funcion correcta
                    $('#usuarioCreateModal .btn-primary[onclick="submitCreate()"]').attr('onclick', 'submitCreateUsuarioEntidad()');
                    $('#usuarioCreateModal').modal('show');
                })
                .catch(() => f_alert('e', '', 'Error al cargar el formulario'));
        }

        function openEditUsuarioEntidad(guid) {
            fetch('/Usuario/GetEditModal?guid=' + encodeURIComponent(guid))
                .then(response => {
                    if (!response.ok) throw new Error('HTTP ' + response.status);
                    return response.text();
                })
                .then(html => {
                    $('#usuarioEntidadBodyContainer').remove();
                    $('body').append('<div id="usuarioEntidadBodyContainer">' + wrapEnModal('usuarioEditModal', html) + '</div>');
                    initSelect2EditUsuarioEntidad();
                    // Redirigir el boton Guardar a la funcion correcta (submitEdit del Index edita entidades)
                    $('#usuarioEditModal button[onclick="submitEdit()"]').attr('onclick', 'submitEditUsuarioEntidad()');
                    $('#usuarioEditModal').modal('show');
                })
                .catch(err => f_alert('e', '', 'Error al cargar el formulario: ' + err.message));
        }

        function submitCreateUsuarioEntidad() {
            var form = document.getElementById('createForm');
            if (!form.checkValidity()) { form.reportValidity(); return; }

            var token = document.querySelector('#usuarioCreateModal input[name="__RequestVerificationToken"]').value;
            var formData = {
                login:           document.getElementById('Login').value,
                email:           document.getElementById('Email').value,
                nombres:         document.getElementById('Nombres').value,
                apellidoPaterno: document.getElementById('ApellidoPaterno').value,
                apellidoMaterno: document.getElementById('ApellidoMaterno').value,
                numeroDocumento: document.getElementById('NumeroDocumento').value,
                celular:         document.getElementById('Celular').value,
                idEntidadMedica: document.getElementById('IdEntidadMedica').value || null,
                idRol:           document.getElementById('IdRol') ? document.getElementById('IdRol').value || null : null,
                enviarCorreo:    document.getElementById('EnviarCorreo').checked
            };

            f_loading();
            fetch('/Usuario/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(formData)
            })
            .then(r => r.json())
            .then(result => {
                f_remove_loading();
                if (result.success) {
                    $('#usuarioCreateModal').modal('hide');
                    toastr.success(result.message, 'Exito');
                    if (result.generatedPassword) {
                        toastr.info('Clave generada: ' + result.generatedPassword, 'Clave', { timeOut: 0, extendedTimeOut: 0 });
                    }
                } else {
                    f_alert('e', '', result.message);
                }
            })
            .catch(() => { f_remove_loading(); f_alert('e', '', 'Error al procesar la solicitud'); });
        }

        function submitEditUsuarioEntidad() {
            var form = document.getElementById('editForm');
            if (!form.checkValidity()) { form.reportValidity(); return; }

            var token = document.querySelector('#usuarioEditModal input[name="__RequestVerificationToken"]').value;
            var formData = {
                guidRegistro:    document.getElementById('GuidRegistro').value,
                login:           document.getElementById('Login').value,
                email:           document.getElementById('Email').value,
                nombres:         document.getElementById('Nombres').value,
                apellidoPaterno: document.getElementById('ApellidoPaterno').value,
                apellidoMaterno: document.getElementById('ApellidoMaterno').value,
                numeroDocumento: document.getElementById('NumeroDocumento').value,
                celular:         document.getElementById('Celular').value,
                idEntidadMedica: document.getElementById('IdEntidadMedica').value || null,
                idRol:           document.getElementById('IdRol') ? document.getElementById('IdRol').value || null : null,
                activo:          parseInt(document.getElementById('Activo').value)
            };

            f_loading();
            fetch('/Usuario/Edit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(formData)
            })
            .then(r => r.json())
            .then(result => {
                f_remove_loading();
                if (result.success) {
                    $('#usuarioEditModal').modal('hide');
                    toastr.success(result.message, 'Exito');
                } else {
                    f_alert('e', '', result.message);
                }
            })
            .catch(() => { f_remove_loading(); f_alert('e', '', 'Error al procesar la solicitud'); });
        }

        function initSelect2EditUsuarioEntidad() {
            // Reemplazar el select de entidad por un campo readonly (no hay Select2 en esta pagina)
            var $select = $('#usuarioEditModal #IdEntidadMedica');
            if ($select.length === 0) return;
            var currentId   = $select.data('current-id');
            var currentText = $select.data('current-text') || '';
            $select.replaceWith(
                '<input type="hidden" id="IdEntidadMedica" name="IdEntidadMedica" value="' + currentId + '" />' +
                '<input type="text" class="form-control" value="' + currentText + '" readonly style="background-color:#e9ecef;" />'
            );
        }

        function openResetClaveUsuarioEntidad(guid) {
            fetch('/Usuario/GetResetClaveModal?guid=' + encodeURIComponent(guid))
                .then(response => {
                    if (!response.ok) throw new Error('HTTP ' + response.status);
                    return response.text();
                })
                .then(html => {
                    $('#usuarioEntidadBodyContainer').remove();
                    $('body').append('<div id="usuarioEntidadBodyContainer">' + wrapEnModal('usuarioResetClaveModal', html) + '</div>');
                    $('#usuarioResetClaveModal button[onclick="submitResetClave()"]').attr('onclick', 'submitResetClaveUsuarioEntidad()');
                    $('#usuarioResetClaveModal').modal('show');
                })
                .catch(err => f_alert('e', '', 'Error al cargar el formulario: ' + err.message));
        }

        function submitResetClaveUsuarioEntidad() {
            var formData = {
                guidRegistro: document.querySelector('#usuarioResetClaveModal #GuidRegistro').value,
                enviarCorreo: document.querySelector('#usuarioResetClaveModal #EnviarCorreo').checked
            };
            var token = document.querySelector('#usuarioResetClaveModal input[name="__RequestVerificationToken"]').value;

            f_loading();
            fetch('/Usuario/ResetClave', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(formData)
            })
            .then(response => response.json())
            .then(data => {
                f_remove_loading();
                $('#usuarioResetClaveModal').modal('hide');
                if (data.success) {
                    f_alert('s', '', data.message);
                    if (data.generatedPassword) {
                        Swal.fire({
                            icon: 'info',
                            title: 'Clave generada',
                            html: '<strong>Clave:</strong> <code style="font-size:1.1em;">' + data.generatedPassword + '</code>',
                            confirmButtonColor: '#28a745'
                        });
                    }
                } else {
                    f_alert('e', '', data.message);
                }
            })
            .catch(() => { f_remove_loading(); f_alert('e', '', 'Error al procesar la solicitud'); });
        }

        function toggleActivoUsuarioEntidad(guid, nuevoActivo) {
            var titulo = nuevoActivo === 1 ? '¿Activar usuario?' : '¿Desactivar usuario?';
            var texto  = nuevoActivo === 1
                ? 'El usuario podrá ingresar al sistema nuevamente.'
                : 'El usuario no podrá ingresar al sistema.';
            var btnColor = nuevoActivo === 1 ? '#28a745' : '#dc3545';
            var btnTexto = nuevoActivo === 1 ? '<i class="fas fa-check mr-1"></i>Activar' : '<i class="fas fa-ban mr-1"></i>Desactivar';

            Swal.fire({
                title: titulo,
                text: texto,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: btnColor,
                cancelButtonColor: '#6c757d',
                confirmButtonText: btnTexto,
                cancelButtonText: 'Cancelar'
            }).then(function(result) {
                if (!result.isConfirmed) return;

                var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                var token   = tokenEl ? tokenEl.value : '';
                f_loading();
                fetch('/Usuario/ToggleActivoUsuario?guidRegistro=' + encodeURIComponent(guid), {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                })
                .then(r => r.json())
                .then(function(data) {
                    f_remove_loading();
                    if (data.success) {
                        toastr.success(data.message, 'Éxito');
                        loadUsuariosEntidad();
                    } else {
                        f_alert('e', '', data.message);
                    }
                })
                .catch(function() { f_remove_loading(); f_alert('e', '', 'Error al procesar la solicitud'); });
            });
        }

        // Capturar guardado exitoso desde modales de usuario (crear/editar)
        $(document).on('usuarioEntidadGuardado', function () {
            loadUsuariosEntidad();
        });

        // Funciones para Contactos de Notificacion
        function openContactosModal(guid) {
            f_loading();
            fetch('@Url.Action("GetContactosModal", "EntidadMedica")?guid=' + encodeURIComponent(guid))
                .then(response => {
                    if (!response.ok) throw new Error('Error en la respuesta');
                    return response.text();
                })
                .then(html => {
                    document.getElementById('modalContainer').innerHTML = html;
                    document.getElementById('modalContainer').querySelectorAll('script').forEach(oldScript => {
                        const newScript = document.createElement('script');
                        newScript.textContent = oldScript.textContent;
                        document.body.appendChild(newScript);
                        document.body.removeChild(newScript);
                    });
                    $('#modalContactos').modal('show');
                    f_remove_loading();
                })
                .catch(() => {
                    f_remove_loading();
                    f_alert('e', '', 'Error al cargar los contactos');
                });
        }

        // Funciones para Cuentas Bancarias
        let currentEntidadGuid = '';

        function openCuentasBancariasModal(guid) {
            currentEntidadGuid = guid;
            f_loading();
            fetch('@Url.Action("GetCuentasBancariasModal")?guid=' + encodeURIComponent(guid))
                .then(response => {
                    if (!response.ok) throw new Error('Error en la respuesta');
                    return response.text();
                })
                .then(html => {
                    document.getElementById('modalContainer').innerHTML = html;
                    $('#cuentasBancariasModal').modal('show');
                    f_remove_loading();
                })
                .catch(error => {
                    f_remove_loading();
                    f_alert('e', '', 'Error al cargar las cuentas bancarias');
                });
        }

        function sincronizarCuentasBancarias() {

            console.log("Entro 1");

            const btn = document.getElementById('btnSincronizarCuentas');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i>Sincronizando...';

            const formData = new FormData();
            formData.append('guid', currentEntidadGuid);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            fetch('@Url.Action("SincronizarCuentasBancarias")', { method: 'POST', body: formData })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        Swal.fire({ icon: 'success', title: 'Sincronización', text: result.message, confirmButtonColor: '#28a745' });
                        loadCuentasBancarias();
                    } else {
                        Swal.fire({ icon: 'warning', title: 'Sincronización', text: result.message, confirmButtonColor: '#f26522' });
                    }
                })
                .catch(() => {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudo conectar con el servidor', confirmButtonColor: '#dc3545' });
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-sync mr-1"></i>Sincronizar Cuentas';
                });
        }

        function loadCuentasBancarias() {
            fetch('@Url.Action("GetListCuentasBancarias")?entidadGuid=' + encodeURIComponent(currentEntidadGuid))
                .then(response => response.text())
                .then(html => {
                    document.getElementById('cuentasBancariasListContainer').innerHTML = html;
                })
                .catch(error => {
                    document.getElementById('cuentasBancariasListContainer').innerHTML =
                        '<div class="text-center text-danger py-3">Error al cargar las cuentas</div>';
                });
        }

        function openCreateCuentaBancariaModal() {
            fetch('@Url.Action("GetCreateCuentaBancariaModal")?entidadGuid=' + encodeURIComponent(currentEntidadGuid))
                .then(response => response.text())
                .then(html => {
                    document.getElementById('cuentaBancariaFormContainer').innerHTML = html;
                    $('#createCuentaBancariaModal').modal('show');
                })
                .catch(error => {
                    f_alert('e', '', 'Error al cargar el formulario');
                });
        }

        function openEditCuentaBancariaModal(guid) {
            fetch('@Url.Action("GetEditCuentaBancariaModal")?guid=' + encodeURIComponent(guid) + '&entidadGuid=' + encodeURIComponent(currentEntidadGuid))
                .then(response => response.text())
                .then(html => {
                    document.getElementById('cuentaBancariaFormContainer').innerHTML = html;
                    $('#editCuentaBancariaModal').modal('show');
                })
                .catch(error => {
                    f_alert('e', '', 'Error al cargar el formulario');
