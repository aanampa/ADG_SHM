@model SHM.AppWebHonorarioMedico.Models.ContactoListViewModel

@if (!Model.Items.Any())
{
    <div class="text-center py-4 text-muted">
        <i class="fas fa-address-book fa-2x mb-2"></i>
        <p class="mb-0">No hay contactos registrados para esta entidad.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-bordered table-hover mb-0" style="font-size: 13px;">
            <thead style="background-color: #6c757d; color: #fff;">
                <tr>
                    <th class="align-middle">Nombre</th>
                    <th class="align-middle">Correo</th>
                    <th class="align-middle" style="width: 110px;">Celular</th>
                    <th class="align-middle" style="width: 130px;">Cargo</th>
                    <th class="align-middle text-center" style="width: 70px;">Estado</th>
                    <th class="align-middle text-center" style="width: 100px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr class="@(item.Activo == 0 ? "text-muted" : "")">
                        <td>@item.NombreCompleto</td>
                        <td>
                            <a href="mailto:@item.Email" class="@(item.Activo == 0 ? "text-muted" : "text-dark")">@item.Email</a>
                        </td>
                        <td>@(item.Celular ?? "-")</td>
                        <td>@(item.Cargo ?? "-")</td>
                        <td class="text-center">
                            @if (item.Activo == 1)
                            {
                                <span class="badge badge-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-info btn-xs"
                                    onclick="openEditContactoModal('@item.GuidRegistro', '@Model.EntidadGuid')"
                                    title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            @if (item.Activo == 1)
                            {
                                <button type="button" class="btn btn-warning btn-xs"
                                        onclick="toggleActivoContacto('@item.GuidRegistro', '@Model.EntidadGuid', 0)"
                                        title="Inactivar">
                                    <i class="fas fa-ban"></i>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-success btn-xs"
                                        onclick="toggleActivoContacto('@item.GuidRegistro', '@Model.EntidadGuid', 1)"
                                        title="Activar">
                                    <i class="fas fa-check"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="mt-2">
        <small class="text-muted">@Model.Items.Count contacto(s) registrado(s).</small>
    </div>
}
