@model SHM.AppWebHonorarioMedico.Models.ContactoCreateViewModel

<div class="modal fade" id="modalCreateContacto" tabindex="-1" role="dialog" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="fas fa-plus mr-2"></i>Nuevo Contacto
                </h6>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @Html.AntiForgeryToken()
                <input type="hidden" id="createContactoEntidadGuid" value="@Model.EntidadGuid" />
                <input type="hidden" id="createContactoIdEntidadMedica" value="@Model.IdEntidadMedica" />

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label>Apellido Paterno</label>
                        <input type="text" id="createContactoApellidoPaterno" class="form-control form-control-sm"
                               maxlength="100" placeholder="Apellido Paterno" />
                    </div>
                    <div class="form-group col-md-6">
                        <label>Apellido Materno</label>
                        <input type="text" id="createContactoApellidoMaterno" class="form-control form-control-sm"
                               maxlength="100" placeholder="Apellido Materno" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Nombres <span class="text-danger">*</span></label>
                    <input type="text" id="createContactoNombres" class="form-control form-control-sm"
                           maxlength="200" placeholder="Nombres" />
                </div>
                <div class="form-group">
                    <label>Correo Electronico <span class="text-danger">*</span></label>
                    <input type="email" id="createContactoEmail" class="form-control form-control-sm"
                           maxlength="100" placeholder="correo@@ejemplo.com" />
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label>Celular</label>
                        <input type="text" id="createContactoCelular" class="form-control form-control-sm"
                               maxlength="10" placeholder="999999999" />
                    </div>
                    <div class="form-group col-md-6">
                        <label>Cargo</label>
                        <input type="text" id="createContactoCargo" class="form-control form-control-sm"
                               maxlength="120" placeholder="Cargo o area" />
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-success btn-sm" onclick="submitCreateContacto()">
                    <i class="fas fa-save mr-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        $('#modalCreateContacto').modal('show');

        $('#modalCreateContacto').on('hidden.bs.modal', function () {
            $('body').addClass('modal-open');
        });
    })();

    function submitCreateContacto() {
        const nombres = document.getElementById('createContactoNombres').value.trim();
        const email   = document.getElementById('createContactoEmail').value.trim();
        const celular = document.getElementById('createContactoCelular').value.trim();

        const errores = [];
        if (!nombres) errores.push('Los nombres son requeridos');
        if (!email)   errores.push('El correo electronico es requerido');

        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        if (email && !emailRegex.test(email)) errores.push('El correo electronico no es valido');


        if (errores.length > 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Campos requeridos',
                html: '<ul class="text-left">' + errores.map(e => '<li>' + e + '</li>').join('') + '</ul>',
                confirmButtonColor: '#f26522'
            });
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        fetch('@Url.Action("CreateContacto", "EntidadMedica")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({
                entidadGuid:     document.getElementById('createContactoEntidadGuid').value,
                idEntidadMedica: parseInt(document.getElementById('createContactoIdEntidadMedica').value),
                apellidoPaterno: document.getElementById('createContactoApellidoPaterno').value.trim() || null,
                apellidoMaterno: document.getElementById('createContactoApellidoMaterno').value.trim() || null,
                nombres:         nombres,
                email:           email,
                celular:         celular || null,
                cargo:           document.getElementById('createContactoCargo').value.trim() || null
            })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                $('#modalCreateContacto').modal('hide');
                Swal.fire({ icon: 'success', title: 'Exito', text: data.message, confirmButtonColor: '#28a745', timer: 1500, showConfirmButton: false });
                refreshContactosList(document.getElementById('createContactoEntidadGuid').value);
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#dc3545' });
            }
        })
        .catch(() => {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Error al procesar la solicitud.', confirmButtonColor: '#dc3545' });
        });
    }
</script>
