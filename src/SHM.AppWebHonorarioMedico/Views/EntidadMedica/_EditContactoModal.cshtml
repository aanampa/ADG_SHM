@model SHM.AppWebHonorarioMedico.Models.ContactoEditViewModel

<div class="modal fade" id="modalEditContacto" tabindex="-1" role="dialog" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="fas fa-edit mr-2"></i>Editar Contacto
                </h6>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editContactoGuid" value="@Model.GuidRegistro" />
                <input type="hidden" id="editContactoEntidadGuid" value="@Model.EntidadGuid" />
                <input type="hidden" id="editContactoId" value="@Model.IdEntidadContacto" />
                <input type="hidden" id="editContactoIdEntidadMedica" value="@Model.IdEntidadMedica" />

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label>Apellido Paterno</label>
                        <input type="text" id="editContactoApellidoPaterno" class="form-control form-control-sm"
                               maxlength="100" value="@Model.ApellidoPaterno" />
                    </div>
                    <div class="form-group col-md-6">
                        <label>Apellido Materno</label>
                        <input type="text" id="editContactoApellidoMaterno" class="form-control form-control-sm"
                               maxlength="100" value="@Model.ApellidoMaterno" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Nombres <span class="text-danger">*</span></label>
                    <input type="text" id="editContactoNombres" class="form-control form-control-sm"
                           maxlength="200" value="@Model.Nombres" />
                </div>
                <div class="form-group">
                    <label>Correo Electronico <span class="text-danger">*</span></label>
                    <input type="email" id="editContactoEmail" class="form-control form-control-sm"
                           maxlength="100" value="@Model.Email" />
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label>Celular</label>
                        <input type="text" id="editContactoCelular" class="form-control form-control-sm"
                               maxlength="10" value="@Model.Celular" />
                    </div>
                    <div class="form-group col-md-6">
                        <label>Cargo</label>
                        <input type="text" id="editContactoCargo" class="form-control form-control-sm"
                               maxlength="120" value="@Model.Cargo" />
                    </div>
                </div>
                <div class="form-group mb-0">
                    <div class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input" id="editContactoActivo"
                               @(Model.Activo == 1 ? "checked" : "") />
                        <label class="custom-control-label" for="editContactoActivo">Activo</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-info btn-sm" onclick="submitEditContacto()">
                    <i class="fas fa-save mr-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        $('#modalEditContacto').modal('show');

        $('#modalEditContacto').on('hidden.bs.modal', function () {
            $('body').addClass('modal-open');
        });
    })();

    function submitEditContacto() {
        const nombres = document.getElementById('editContactoNombres').value.trim();
        const email   = document.getElementById('editContactoEmail').value.trim();
        const celular = document.getElementById('editContactoCelular').value.trim();

        const errores = [];
        if (!nombres) errores.push('Los nombres son requeridos');
        if (!email)   errores.push('El correo electronico es requerido');

        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        if (email && !emailRegex.test(email)) errores.push('El correo electronico no es valido');


        if (errores.length > 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Campos requeridos',
                html: '<ul class="text-left">' + errores.map(e => '<li>' + e + '</li>').join('') + '</ul>',
                confirmButtonColor: '#f26522'
            });
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        fetch('@Url.Action("EditContacto", "EntidadMedica")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({
                guidRegistro:    document.getElementById('editContactoGuid').value,
                entidadGuid:     document.getElementById('editContactoEntidadGuid').value,
                idEntidadContacto: parseInt(document.getElementById('editContactoId').value),
                idEntidadMedica: parseInt(document.getElementById('editContactoIdEntidadMedica').value),
                apellidoPaterno: document.getElementById('editContactoApellidoPaterno').value.trim() || null,
                apellidoMaterno: document.getElementById('editContactoApellidoMaterno').value.trim() || null,
                nombres:         nombres,
                email:           email,
                celular:         celular || null,
                cargo:           document.getElementById('editContactoCargo').value.trim() || null,
                activo:          document.getElementById('editContactoActivo').checked ? 1 : 0
            })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                $('#modalEditContacto').modal('hide');
                Swal.fire({ icon: 'success', title: 'Exito', text: data.message, confirmButtonColor: '#28a745', timer: 1500, showConfirmButton: false });
                refreshContactosList(document.getElementById('editContactoEntidadGuid').value);
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#dc3545' });
            }
        })
        .catch(() => {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Error al procesar la solicitud.', confirmButtonColor: '#dc3545' });
        });
    }
</script>
