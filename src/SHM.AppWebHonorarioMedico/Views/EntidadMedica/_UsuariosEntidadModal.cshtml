@model SHM.AppWebHonorarioMedico.Models.UsuariosEntidadViewModel

<!-- Modal Usuarios de Entidad -->
<div class="modal fade" id="usuariosEntidadModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white">
                    <i class="fas fa-users mr-2"></i>Usuarios
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <strong>Entidad:</strong> @Model.EntidadRazonSocial
                </div>
                <div class="mb-3 text-right">
                    <button type="button" class="btn btn-primary btn-sm"
                            onclick="openCreateUsuarioEntidad(@Model.IdEntidadMedica)">
                        <i class="fas fa-plus mr-1"></i>Nuevo Usuario
                    </button>
                </div>
                <div id="usuariosEntidadListContainer">
                    @await Html.PartialAsync("_UsuariosEntidadListPartial", Model.Items)
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i>Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Contenedor para modales de formularios (crear/editar usuario) -->
<div id="usuarioEntidadFormContainer"></div>
