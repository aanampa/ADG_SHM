@model SHM.AppWebHonorarioMedico.Models.LiquidacionGrupoListViewModel

<style>
    thead th {
        vertical-align: middle !important;
        text-align: center !important;
    }
    .tabla-pequena {
        font-size: 14px;
    }
</style>

<div class="card-body table-responsive px-2 py-1">
    <table class="table table-sm table-bordered tabla-pequena" style="background-color: #FFFFFF; width: 100%;">
        <thead style="background-color: #6c757d; color: #fff;">
            <tr>
                <th class="text-center align-middle" align="center" style="width: 10px;">
                    Sel.
                </th>
                <th class="align-middle text-center" style="width: 50px;">Detalle</th>
                <th class="align-middle" style="width: 100px;">Cod.<br/>Liquidacion</th>
                <th class="align-middle" style="width: 120px;">Tipo Médico</th>
                <th class="align-middle" style="width: 150px;">Tipo Liquidación</th>
                <th class="align-middle" style="width: 120px;">Tipo Rubro</th>
                <th class="align-middle" style="width: 90px;">Periodo</th>
                <th class="align-middle">Descripcion</th>
                <th class="align-middle" style="width: 250px;">Banco</th>
                <th class="align-middle" style="width: 60px;">Cant. Fact.</th>
                <th class="align-middle text-right" style="width: 100px;">Total S/.</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                @foreach (LiquidacionGrupoItemViewModel item in Model.Items)
                {
                    <tr>
                        <td class="text-center">
                            <input type="checkbox"
                                   class="chk-item"
                                   data-codigo="@item.CodigoLiquidacion"
                                   data-banco="@item.IdBanco"
                                   onchange="onCheckboxChange(this, '@item.CodigoLiquidacion', @(item.IdBanco ?? 0), '@(item.NombreBanco?.Replace("'", "\\'") ?? "-")')" />
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-info btn-xs"
                                    onclick="verProducciones('@item.CodigoLiquidacion', @(item.IdBanco ?? 0), '@(item.Descripcion?.Replace("'", "\\'") ?? "-")', '@(item.DesTipoProduccion?.Replace("'", "\\'") ?? "-")', '@(item.NumeroLiquidacion?.Replace("'", "\\'") ?? "-")')"
                                    title="Ver Facturas">
                                <i class="fas fa-list"></i>
                            </button>
                        </td>
                        <td>@(item.NumeroLiquidacion ?? "-")</td>
                        <td>@(item.DesTipoMedico ?? "-")</td>
                        <td>@(item.DesTipoProduccion ?? "-")</td>
                        <td>@(item.DesTipoRubro ?? "-")</td>
                        <td>@(item.PeriodoLiquidacion ?? "-")</td>
                        <td>@(item.Descripcion ?? "-")</td>
                        <td>@(item.NombreBanco ?? "-")</td>
                        <td class="text-center">
                            <span class="badge badge-info">@item.CantidadFacturas</span>
                        </td>
                        <td class="text-right font-weight-bold">@(item.MtoTotal?.ToString("N2") ?? "-")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="11" class="text-center text-muted py-4">
                        <i class="fas fa-inbox fa-2x mb-2"></i>
                        <p class="mb-0">No se encontraron liquidaciones</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Items.Any())
{
    <div class="card-footer">
        <small class="text-muted">
            Mostrando @Model.Items.Count registro(s) |
            <strong>Total:</strong> S/. @(Model.Items.Sum(x => x.MtoTotal ?? 0).ToString("N2"))
        </small>
    </div>
}
