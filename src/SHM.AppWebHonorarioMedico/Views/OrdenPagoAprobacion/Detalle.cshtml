@model SHM.AppDomain.DTOs.OrdenPago.OrdenPagoResponseDto
@using SHM.AppDomain.Constants
@{
    ViewData["Title"] = "Aprobación de Orden de Pago";
    var liquidaciones = ViewBag.Liquidaciones as List<SHM.AppDomain.DTOs.OrdenPagoLiquidacion.OrdenPagoLiquidacionResponseDto>
        ?? new List<SHM.AppDomain.DTOs.OrdenPagoLiquidacion.OrdenPagoLiquidacionResponseDto>();
    var aprobaciones = ViewBag.Aprobaciones as List<SHM.AppDomain.DTOs.OrdenPagoAprobacion.OrdenPagoAprobacionResponseDto>
        ?? new List<SHM.AppDomain.DTOs.OrdenPagoAprobacion.OrdenPagoAprobacionResponseDto>();
    var perfilesUsuario = ViewBag.PerfilesUsuario as List<string> ?? new List<string>();
    var detalleLiquidaciones = ViewBag.DetalleLiquidaciones as List<SHM.AppDomain.DTOs.OrdenPagoLiquidacion.DetalleLiquidacionItemDto>
        ?? new List<SHM.AppDomain.DTOs.OrdenPagoLiquidacion.DetalleLiquidacionItemDto>();
    var bitacoras = ViewBag.Bitacoras as List<SHM.AppDomain.DTOs.Bitacora.BitacoraConUsuarioDto>
        ?? new List<SHM.AppDomain.DTOs.Bitacora.BitacoraConUsuarioDto>();
}

<style>
    .card-compact .card-header { padding: 0.5rem 0.75rem; }
    .card-compact .card-body { padding: 0.75rem; }
    .card-compact .card-title { font-size: 0.9rem; margin-bottom: 0; }
    .form-group-sm { margin-bottom: 0.5rem; }
    .form-group-sm label { font-size: 0.8rem; margin-bottom: 0.15rem; color: #6c757d; }
    .form-group-sm .form-control-sm { font-size: 0.8rem; padding: 0.2rem 0.4rem; height: auto; }
    .table-liq thead th { vertical-align: middle !important; text-align: center; }
    .table-liq thead th.text-right { text-align: right !important; }
</style>

<div class="wrapper">
    <div class="content-wrapper" style="min-height: auto;">

        <div class="content-header py-2">
            <div class="container-fluid">
                <div class="d-flex justify-content-between align-items-center">
                    <h1 class="m-0 titulo-formulario" style="font-size: 1.2rem;">
                        <i class="fas fa-file-invoice-dollar mr-2"></i>Aprobaci&oacute;n: @(Model.NumeroOrdenPago ?? "-")
                    </h1>
                    <a href="@Url.Action("Index", "OrdenPagoAprobacion")"
                        class="btn btn-sm btn-outline-secondary"
                        title="Volver a la lista">
                        <i class="fas fa-arrow-left mr-1"></i>Volver
                    </a>
                </div>
                <ol class="breadcrumb m-0 bg-transparent p-0 mt-1" style="font-size: 0.8rem;">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "OrdenPagoAprobacion")">Aprobaci&oacute;n de Orden de Pago</a></li>
                    <li class="breadcrumb-item active">Detalle</li>
                </ol>
            </div>
        </div>

        <section class="content py-0">
            <div class="container-fluid">

            <!-- Datos de Orden de Pago -->
            <div class="card card-compact mb-2 w-75">
                <div class="card-header bg-light">
                    <h3 class="card-title">
                        <i class="fas fa-info-circle mr-1"></i>Datos de Orden de Pago
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-2">
                            <div class="form-group-sm">
                                <label>Orden de Pago</label>
                                <input type="text" class="form-control form-control-sm" value="@(Model.NumeroOrdenPago ?? "-")" readonly style="background-color: #e9ecef;">
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="form-group-sm">
                                <label>Sede</label>
                                <input type="text" class="form-control form-control-sm" value="@(Model.NombreSede ?? "-")" readonly style="background-color: #e9ecef;">
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="form-group-sm">
                                <label>Banco</label>
                                <input type="text" class="form-control form-control-sm" value="@(Model.NombreBanco ?? "-")" readonly style="background-color: #e9ecef;">
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="form-group-sm">
                                <label>Fecha de Generaci&oacute;n</label>
                                <input type="text" class="form-control form-control-sm" value="@(Model.FechaGeneracion?.ToString("dd/MM/yyyy") ?? "-")" readonly style="background-color: #e9ecef;">
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="form-group-sm">
                                <label>Estado de Aprobaci&oacute;n</label>
                                <div>
                                    <span class="badge @EstadoDescripcion.OrdenPago.GetBadgeClass(Model.Estado)" style="font-size: 0.75rem; padding: 0.35rem 0.5rem;">
                                        @EstadoDescripcion.OrdenPago.GetDescripcion(Model.Estado)
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-2">
                            <div class="form-group-sm">
                                <label>N&deg; de Liquidaciones</label>
                                <input type="text" class="form-control form-control-sm" value="@(Model.CantLiquidaciones?.ToString() ?? "-")" readonly style="background-color: #e9ecef;">
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="form-group-sm">
                                <label>N&deg; de Facturas</label>
                                <input type="text" class="form-control form-control-sm" value="@(Model.CantComprobantes?.ToString() ?? "-")" readonly style="background-color: #e9ecef;">
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="form-group-sm">
                                <label>Sub Total (S/.)</label>
                                <input type="text" class="form-control form-control-sm" value="@(Model.MtoSubtotalAcum?.ToString("N2") ?? "--")" readonly style="background-color: #e9ecef;">
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="form-group-sm">
                                <label>IGV (S/.)</label>
                                <input type="text" class="form-control form-control-sm" value="@(Model.MtoIgvAcum?.ToString("N2") ?? "--")" readonly style="background-color: #e9ecef;">
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="form-group-sm">
                                <label>Imp. Renta (S/.)</label>
                                <input type="text" class="form-control form-control-sm" value="@(Model.MtoRentaAcum?.ToString("N2") ?? "--")" readonly style="background-color: #e9ecef;">
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="form-group-sm">
                                <label>Total (S/.)</label>
                                <input type="text" class="form-control form-control-sm font-weight-bold" value="@(Model.MtoTotalAcum?.ToString("N2") ?? "--")" readonly style="background-color: #e9ecef;">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer py-2 d-flex justify-content-between align-items-center">
                    <div>
                        @if (Model.Estado == EstadoDescripcion.OrdenPago.AprobacionPendiente && perfilesUsuario.Any())
                        {
                            <button type="button" class="btn btn-sm btn-danger" onclick="rechazarOrden()">
                                <i class="fas fa-times mr-1"></i>Devolver
                            </button>
                            <button type="button" class="btn btn-sm btn-success ml-1" onclick="aprobarOrden()">
                                <i class="fas fa-check mr-1"></i>Aprobar
                            </button>
                        }
                    </div>
                    <div>
                        @if (perfilesUsuario.Any())
                        {
                            <small class="text-muted mr-2">Tu perfil:</small>
                            @foreach (var perfil in perfilesUsuario)
                            {
                                <span class="badge badge-info mr-1" style="font-size: 0.85rem;">
                                    <i class="fas fa-user-tag mr-1"></i>@perfil
                                </span>
                            }
                        }
                        else
                        {
                            <small class="text-muted"><i class="fas fa-info-circle mr-1"></i>Sin perfil de aprobaci&oacute;n asignado</small>
                        }
                    </div>
                </div>
            </div>

            <!-- Detalle de aprobacion -->
            <div class="card card-compact mb-2 w-75">
                <div class="card-header bg-light">
                    <h3 class="card-title">
                        <i class="fas fa-check-double mr-1"></i>Detalle de Aprobaci&oacute;n
                    </h3>
                </div>
                <div class="card-body p-2">
                    <table class="table table-sm table-bordered mb-0" style="font-size: 0.85rem;">
                        <thead class="bg-secondary">
                            <tr class="text-center">
                                <th>#</th>
                                <th>Perfil</th>
                                <th>Estado</th>
                                <th>Nombre</th>
                                <th>Fecha de Aprobaci&oacute;n</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (aprobaciones.Any())
                            {
                                @foreach (var aprob in aprobaciones)
                                {
                                    <tr>
                                        <td class="text-center">@(aprob.Orden?.ToString() ?? "-")</td>
                                        <td>@(aprob.NombrePerfil ?? "-")</td>
                                        <td class="text-center @EstadoDescripcion.Aprobacion.GetTextClass(aprob.Estado)">
                                            @EstadoDescripcion.Aprobacion.GetDescripcion(aprob.Estado)
                                        </td>
                                        <td>@(aprob.NombreAprobador ?? "-")</td>
                                        <td>@(aprob.FechaAprobacion?.ToString("dd/MM/yyyy hh:mm tt") ?? "-")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">
                                        No hay aprobaciones registradas
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Liquidaciones asociadas -->
            <div class="card card-compact mb-2">
                <div class="card-header bg-light">
                    <h3 class="card-title">
                        <i class="fas fa-list-alt mr-1"></i>Liquidaciones (@liquidaciones.Count)
                    </h3>
                </div>
                <div class="card-body p-2">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover table-bordered mb-0 table-liq" style="font-size: 0.85rem; table-layout: fixed; width: 100%;">
                            <thead style="background-color: #6c757d; color: #fff;">
                                <tr>
                                    <th style="width: 30px;">#</th>
                                    <th style="width: 110px;">Cod.<br/>Liquidación</th>
                                    <th style="width: 110px;">Tipo de<br/>Liquidaci&oacute;n</th>
                                    <th>Descripci&oacute;n</th>
                                    <th style="width: 85px;">Periodo</th>
                                    <th style="width: 160px;">Banco</th>
                                    <th style="width: 90px;">Cant.<br/>Comprob.</th>
                                    <th class="text-right" style="width: 100px;">Sub Total<br/>S/.</th>
                                    <th class="text-right" style="width: 80px;">IGV<br/>S/.</th>
                                    <th class="text-right" style="width: 90px;">Imp. Renta<br/>S/.</th>
                                    <th class="text-right" style="width: 100px;">Total<br/>S/.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (liquidaciones.Any())
                                {
                                    var index = 0;
                                    @foreach (var liq in liquidaciones)
                                    {
                                        index++;
                                        <tr>
                                            <td class="text-center">@index</td>
                                            <td class="text-center">@(liq.NumeroLiquidacion ?? "-")</td>
                                            <td>@(liq.DesTipoLiquidacion ?? liq.TipoLiquidacion ?? "-")</td>
                                            <td>@(liq.DescripcionLiquidacion ?? "-")</td>
                                            <td class="text-center">@(liq.PeriodoLiquidacion ?? "-")</td>
                                            <td>@(liq.NombreBanco ?? "-")</td>
                                            <td class="text-center">@(liq.CantComprobantes?.ToString() ?? "-")</td>
                                            <td class="text-right">@(liq.MtoSubtotalAcum?.ToString("N2") ?? "--")</td>
                                            <td class="text-right">@(liq.MtoIgvAcum?.ToString("N2") ?? "--")</td>
                                            <td class="text-right">@(liq.MtoRentaAcum?.ToString("N2") ?? "--")</td>
                                            <td class="text-right font-weight-bold">@(liq.MtoTotalAcum?.ToString("N2") ?? "--")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="11" class="text-center text-muted py-3">
                                            <i class="fas fa-inbox fa-2x mb-2"></i>
                                            <p class="mb-0">No hay liquidaciones asociadas</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            @if (liquidaciones.Any())
                            {
                                <tfoot class="bg-light font-weight-bold">
                                    <tr>
                                        <td colspan="7" class="text-right">TOTALES:</td>
                                        <td class="text-right">@(liquidaciones.Sum(l => l.MtoSubtotalAcum ?? 0).ToString("N2"))</td>
                                        <td class="text-right">@(liquidaciones.Sum(l => l.MtoIgvAcum ?? 0).ToString("N2"))</td>
                                        <td class="text-right">@(liquidaciones.Sum(l => l.MtoRentaAcum ?? 0).ToString("N2"))</td>
                                        <td class="text-right">@(liquidaciones.Sum(l => l.MtoTotalAcum ?? 0).ToString("N2"))</td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>

            <!-- Detalle de Liquidaciones asociadas -->
            <div class="card card-compact mb-2">
                <div class="card-header bg-light">
                    <h3 class="card-title">
                        <i class="fas fa-file-alt mr-1"></i>Detalle de Liquidaciones (@detalleLiquidaciones.Count)
                    </h3>
                </div>
                <div class="card-body p-2">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover table-bordered mb-0 table-liq" style="font-size: 0.85rem; table-layout: fixed; width: 100%;">
                            <thead style="background-color: #6c757d; color: #fff;">
                                <tr>
                                    <th style="width: 30px;">#</th>
                                    <th style="width: 110px;">Cod.<br/>Liquidación</th>
                                    <th style="width: 110px;">Tipo de<br/>Liquidaci&oacute;n</th>
                                    <th style="width: 120px;">Descripci&oacute;n</th>
                                    <th style="width: 85px;">Periodo</th>
                                    <th style="width: 85px;">RUC</th>
                                    <th style="width: 100px;">Tipo<br/>Entidad</th>
                                    <th style="width: 130px;">Cia Medica</th>
                                    <th style="width: 160px;">Banco</th>
                                    <th style="width: 90px;">Comprobante</th>
                                    <th style="width: 40px;">PDF</th>
                                    <th class="text-right" style="width: 100px;">Sub Total<br/>S/.</th>
                                    <th class="text-right" style="width: 80px;">IGV<br/>S/.</th>
                                    <th class="text-right" style="width: 90px;">Imp. Renta<br/>S/.</th>
                                    <th class="text-right" style="width: 100px;">Total<br/>S/.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (detalleLiquidaciones.Any())
                                {
                                    var idxDet = 1;
                                    @foreach (var det in detalleLiquidaciones)
                                    {
                                        var comprobante = !string.IsNullOrEmpty(det.Serie) && !string.IsNullOrEmpty(det.Numero)
                                            ? $"{det.Serie}-{(int.TryParse(det.Numero, out int nParsed) ? nParsed.ToString() : det.Numero)}"
                                            : "-";
                                        <tr>
                                            <td class="text-center">@(idxDet++)</td>
                                            <td class="text-center">@(det.NumeroLiquidacion ?? "-")</td>
                                            <td>@(det.DesTipoLiquidacion ?? det.TipoLiquidacion ?? "-")</td>
                                            <td>@(det.DescripcionLiquidacion ?? "-")</td>
                                            <td class="text-center">@(det.PeriodoLiquidacion ?? "-")</td>
                                            <td class="text-center">@(det.Ruc ?? "-")</td>
                                            <td>@(det.DesTipoEntidadMedica ?? det.TipoEntidadMedica ?? "-")</td>
                                            <td>@(det.RazonSocial ?? "-")</td>
                                            <td>@(det.NombreBanco ?? "-")</td>
                                            <td class="text-center">@comprobante</td>
                                            <td class="text-center">
                                                @if (!string.IsNullOrEmpty(det.GuidArchivoFactura))
                                                {
                                                    <a href="@Url.Action("Descargar", "Archivo", new { guid = det.GuidArchivoFactura })"
                                                       class="btn btn-outline-danger btn-xs" target="_blank" title="Ver Factura PDF">
                                                        <i class="fas fa-file-pdf"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-right">@(det.MtoSubtotal?.ToString("N2") ?? "--")</td>
                                            <td class="text-right">@(det.MtoIgv?.ToString("N2") ?? "--")</td>
                                            <td class="text-right">@(det.MtoRenta?.ToString("N2") ?? "--")</td>
                                            <td class="text-right font-weight-bold">@(det.MtoTotal?.ToString("N2") ?? "--")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="15" class="text-center text-muted py-3">
                                            <i class="fas fa-inbox fa-2x mb-2"></i>
                                            <p class="mb-0">No hay detalle de liquidaciones</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            @if (detalleLiquidaciones.Any())
                            {
                                <tfoot class="bg-light font-weight-bold">
                                    <tr>
                                        <td colspan="11" class="text-right">TOTAL GENERAL:</td>
                                        <td class="text-right">@(detalleLiquidaciones.Sum(d => d.MtoSubtotal ?? 0).ToString("N2"))</td>
                                        <td class="text-right">@(detalleLiquidaciones.Sum(d => d.MtoIgv ?? 0).ToString("N2"))</td>
                                        <td class="text-right">@(detalleLiquidaciones.Sum(d => d.MtoRenta ?? 0).ToString("N2"))</td>
                                        <td class="text-right">@(detalleLiquidaciones.Sum(d => d.MtoTotal ?? 0).ToString("N2"))</td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>

            <!-- Bitacora -->
            <div class="card card-compact mb-2">
                <div class="card-header bg-light">
                    <h3 class="card-title">
                        <i class="fas fa-history mr-1"></i>Bit&aacute;cora
                    </h3>
                </div>
                <div class="card-body p-2">
                    @if (bitacoras.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0" style="font-size: 0.8rem;">
                                <thead class="thead-light">
                                    <tr>
                                        <th style="width: 30px;" class="text-center">#</th>
                                        <th>Descripci&oacute;n</th>
                                        <th style="width: 160px;">Usuario</th>
                                        <th style="width: 130px;">Fecha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var indexBit = 1; }
                                    @foreach (var bit in bitacoras)
                                    {
                                        <tr>
                                            <td class="text-center">@(indexBit++)</td>
                                            <td>@(bit.Descripcion ?? bit.Accion ?? "-")</td>
                                            <td>@bit.NombreCompletoUsuario</td>
                                            <td>@(bit.FechaAccion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-3" style="font-size: 0.8rem;">
                            <i class="fas fa-info-circle mr-1"></i>No hay registros en la bit&aacute;cora.
                        </div>
                    }
                </div>
            </div>

            </div>
        </section>

    </div>
</div>

@Html.AntiForgeryToken()

<input type="hidden" id="hdnGuidOrdenPago" value="@Model.GuidRegistro" />
<input type="hidden" value="@TempData["APP_RESPONSE"]" id="app-response" />
<input type="hidden" value="@TempData["APP_MESSAGE"]" id="app-message" />

@section Scripts {
    <script type="text/javascript">
        function aprobarOrden() {
            Swal.fire({
                icon: 'question',
                title: 'Aprobar Orden de Pago',
                text: '\u00bfEst\u00e1 seguro que desea aprobar esta orden de pago?',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'S\u00ed, Aprobar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    ejecutarAprobacion();
                }
            });
        }

        function ejecutarAprobacion() {
            const guid = document.getElementById('hdnGuidOrdenPago').value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            f_loading();
            fetch('@Url.Action("Aprobar", "OrdenPagoAprobacion")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ guidOrdenPago: guid })
            })
            .then(response => response.json())
            .then(data => {
                f_remove_loading();
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Aprobado',
                        text: data.message,
                        confirmButtonColor: '#28a745'
                    }).then(() => {
                        window.location.href = '@Url.Action("Index", "OrdenPagoAprobacion")';
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message,
                        confirmButtonColor: '#dc3545'
                    });
                }
            })
            .catch(error => {
                f_remove_loading();
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Error al procesar la aprobaci\u00f3n.',
                    confirmButtonColor: '#dc3545'
                });
            });
        }

        function rechazarOrden() {
            Swal.fire({
                icon: 'warning',
                title: 'Devolver Orden de Pago',
                html: '<p>\u00bfEst\u00e1 seguro que desea devolver esta orden de pago?</p>' +
                      '<div class="form-group text-left mt-3">' +
                      '<label class="font-weight-bold">Comentario <span class="text-danger">*</span></label>' +
                      '<textarea id="txtComentarioRechazo" class="form-control" rows="3" ' +
                      'placeholder="Ingrese el motivo del rechazo..." maxlength="500"></textarea>' +
                      '</div>',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'S\u00ed, Devolver',
                cancelButtonText: 'Cancelar',
                preConfirm: () => {
                    const comentario = document.getElementById('txtComentarioRechazo').value.trim();
                    if (!comentario) {
                        Swal.showValidationMessage('Debe ingresar un comentario');
                        return false;
                    }
                    return comentario;
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    ejecutarRechazo(result.value);
                }
            });
        }

        function ejecutarRechazo(comentario) {
            const guid = document.getElementById('hdnGuidOrdenPago').value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            f_loading();
            fetch('@Url.Action("Rechazar", "OrdenPagoAprobacion")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ guidOrdenPago: guid, comentario: comentario })
            })
            .then(response => response.json())
            .then(data => {
                f_remove_loading();
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Devuelto',
                        text: data.message,
                        confirmButtonColor: '#28a745'
                    }).then(() => {
                        window.location.href = '@Url.Action("Index", "OrdenPagoAprobacion")';
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message,
                        confirmButtonColor: '#dc3545'
                    });
                }
            })
            .catch(error => {
                f_remove_loading();
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Error al procesar el rechazo.',
                    confirmButtonColor: '#dc3545'
                });
            });
        }
    </script>
}
