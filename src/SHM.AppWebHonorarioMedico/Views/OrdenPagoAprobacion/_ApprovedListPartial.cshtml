@model SHM.AppWebHonorarioMedico.Models.OrdenPagoAprobacionListViewModel
@using SHM.AppDomain.Constants

<style>
    thead th {
        vertical-align: middle !important;
        text-align: center !important;
    }
</style>

<div class="card-body table-responsive px-2 py-1">
    <table class="table table-sm table-bordered" style="font-size: 14px; background-color: #FFFFFF; width: 100%;">
        <thead style="background-color: #6c757d; color: #fff;">
            <tr>
                <th class="align-middle text-center" style="width: 50px;">Acciones</th>
                <th class="align-middle">N&uacute;mero Orden de Pago</th>
                <th class="align-middle" style="width: 110px;">Fecha<br/>Generaci&oacute;n</th>
                <th class="align-middle">Sede</th>
                <th class="align-middle">Banco</th>
                <th class="align-middle" style="width: 90px;">Cant.<br/>Liquid.</th>
                <th class="align-middle" style="width: 90px;">Cant.<br/>Comprob.</th>
                <th class="align-middle" style="width: 110px;">Estado</th>
                <th class="align-middle text-right" style="width: 110px;">Sub Total S/.</th>
                <th class="align-middle text-right" style="width: 100px;">IGV S/.</th>
                <th class="align-middle text-right" style="width: 100px;">Renta S/.</th>
                <th class="align-middle text-right" style="width: 110px;">Total S/.</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-center">
                            <button type="button" class="btn btn-info btn-xs" onclick="verDetalle('@item.GuidRegistro')"
                                    title="Ver Detalle">
                                <i class="fas fa-eye"></i>
                            </button>
                        </td>
                        <td class="text-center">@(item.NumeroOrdenPago ?? "-")</td>
                        <td class="text-center">@(item.FechaGeneracion?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>@(item.NombreSede ?? "-")</td>
                        <td>@(item.NombreBanco ?? "-")</td>
                        <td class="text-center">@(item.CantLiquidaciones?.ToString() ?? "-")</td>
                        <td class="text-center">@(item.CantComprobantes?.ToString() ?? "-")</td>
                        <td class="text-center">
                            <span class="badge @EstadoDescripcion.OrdenPago.GetBadgeClass(item.Estado)">
                                @EstadoDescripcion.OrdenPago.GetDescripcion(item.Estado)
                            </span>
                        </td>
                        <td class="text-right">@(item.MtoSubtotalAcum?.ToString("N2") ?? "--")</td>
                        <td class="text-right">@(item.MtoIgvAcum?.ToString("N2") ?? "--")</td>
                        <td class="text-right">@(item.MtoRentaAcum?.ToString("N2") ?? "--")</td>
                        <td class="text-right font-weight-bold">@(item.MtoTotalAcum?.ToString("N2") ?? "--")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="12" class="text-center text-muted py-4">
                        <i class="fas fa-inbox fa-2x mb-2"></i>
                        <p class="mb-0">No tiene &oacute;rdenes de pago aprobadas</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="card-footer clearfix">
        <div class="float-left">
            <small class="text-muted">
                Mostrando @((Model.PageNumber - 1) * Model.PageSize + 1) -
                @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) de @Model.TotalCount registros
            </small>
        </div>
        <ul class="pagination pagination-sm m-0 float-right">
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link" href="javascript:void(0)" onclick="@(Model.PageNumber > 1 ? $"loadList({Model.PageNumber - 1})" : "")">
                    Anterior
                </a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                var pageNum = i;
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="javascript:void(0)" onclick="loadList(@pageNum)">@i</a>
                </li>
            }
            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="javascript:void(0)" onclick="@(Model.PageNumber < Model.TotalPages ? $"loadList({Model.PageNumber + 1})" : "")">
                    Siguiente
                </a>
            </li>
        </ul>
    </div>
}
else if (Model.TotalCount > 0)
{
    <div class="card-footer">
        <small class="text-muted">
            Mostrando @Model.TotalCount registro(s)
        </small>
    </div>
}
