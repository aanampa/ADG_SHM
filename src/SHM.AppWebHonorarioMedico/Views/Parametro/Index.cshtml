@{
    ViewData["Title"] = "Parametros";
}

<div class="wrapper">
    <div class="content-wrapper">

        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0 titulo-formulario">
                            <i class="fas fa-cogs mr-2"></i>Parametros
                        </h1>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-right">
                            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                            <li class="breadcrumb-item active">Parametros</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-6">
                                <h3 class="card-title">Lista de Parametros</h3>
                            </div>
                            <div class="col-md-6 text-right">
                                <button type="button" class="btn btn-morado btn-sm" onclick="openCreateModal()">
                                    <i class="fas fa-plus mr-1"></i>Nuevo Parametro
                                </button>
                            </div>
                        </div>
                    </div>
                    <!-- Contenedor para la lista cargada via AJAX -->
                    <div id="listContainer">
                        <div class="card-body text-center py-5">
                            <i class="fas fa-spinner fa-spin fa-2x"></i>
                            <p class="mt-2">Cargando...</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<!-- Modal Container -->
<div id="modalContainer"></div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            loadList();
        });

        function loadList() {
            f_loading();
            fetch('@Url.Action("GetList")')
                .then(response => {
                    if (!response.ok) throw new Error('Error en la respuesta');
                    return response.text();
                })
                .then(html => {
                    document.getElementById('listContainer').innerHTML = html;
                    f_remove_loading();
                })
                .catch(error => {
                    f_remove_loading();
                    document.getElementById('listContainer').innerHTML =
                        '<div class="card-body text-center text-danger py-4">' +
                        '<i class="fas fa-exclamation-triangle fa-2x mb-2"></i>' +
                        '<p>Error al cargar la lista</p></div>';
                });
        }

        function refreshList() {
            loadList();
        }

        function openCreateModal() {
            f_loading();
            fetch('@Url.Action("GetCreateModal")')
                .then(response => {
                    if (!response.ok) throw new Error('Error en la respuesta');
                    return response.text();
                })
                .then(html => {
                    document.getElementById('modalContainer').innerHTML = html;
                    $('#createModal').modal('show');
                    f_remove_loading();
                })
                .catch(error => {
                    f_remove_loading();
                    f_alert('e', '', 'Error al cargar el formulario');
                });
        }

        function openEditModal(guid) {
            f_loading();
            fetch('@Url.Action("GetEditModal")?guid=' + encodeURIComponent(guid))
                .then(response => {
                    if (!response.ok) throw new Error('Error en la respuesta');
                    return response.text();
                })
                .then(html => {
                    document.getElementById('modalContainer').innerHTML = html;
                    onTipoParametroChange('edit');
                    $('#editModal').modal('show');
                    f_remove_loading();
                })
                .catch(error => {
                    f_remove_loading();
                    f_alert('e', '', 'Error al cargar el formulario');
                });
        }

        function openDeleteModal(guid) {
            f_loading();
            fetch('@Url.Action("GetDeleteModal")?guid=' + encodeURIComponent(guid))
                .then(response => {
                    if (!response.ok) throw new Error('Error en la respuesta');
                    return response.text();
                })
                .then(html => {
                    document.getElementById('modalContainer').innerHTML = html;
                    $('#deleteModal').modal('show');
                    f_remove_loading();
                })
                .catch(error => {
                    f_remove_loading();
                    f_alert('e', '', 'Error al cargar el formulario');
                });
        }

        // Cambia el campo Valor segun el tipo de parametro seleccionado
        function onTipoParametroChange(prefix) {
            var tipo = document.getElementById(prefix + '_TipoParametro').value;
            var container = document.getElementById(prefix + '_ValorContainer');
            var currentValue = document.getElementById(prefix + '_Valor') ? document.getElementById(prefix + '_Valor').value : '';

            var html = '<label for="' + prefix + '_Valor">Valor</label>';

            if (tipo === 'LOGICO') {
                var checkedS = (currentValue.toUpperCase() === 'S') ? 'selected' : '';
                var checkedN = (currentValue.toUpperCase() === 'N' || currentValue === '') ? 'selected' : '';
                html += '<select id="' + prefix + '_Valor" class="form-control">' +
                        '<option value="S" ' + checkedS + '>Si</option>' +
                        '<option value="N" ' + checkedN + '>No</option>' +
                        '</select>';
            } else if (tipo === 'FECHA') {
                // Convertir DD/MM/YYYY a YYYY-MM-DD para el input date
                var dateValue = '';
                if (currentValue && currentValue.indexOf('/') > -1) {
                    var parts = currentValue.split('/');
                    if (parts.length === 3) {
                        dateValue = parts[2] + '-' + parts[1] + '-' + parts[0];
                    }
                }
                html += '<input type="date" id="' + prefix + '_Valor" class="form-control" value="' + dateValue + '" />';
            } else {
                html += '<input type="text" id="' + prefix + '_Valor" class="form-control" maxlength="512" value="' + currentValue.replace(/"/g, '&quot;') + '" placeholder="Ingrese el valor" />';
            }

            container.innerHTML = html;
        }

        // Obtiene el valor del campo segun el tipo
        function getValorByTipo(prefix) {
            var tipo = document.getElementById(prefix + '_TipoParametro').value;
            var valorElement = document.getElementById(prefix + '_Valor');

            if (!valorElement) return '';

            if (tipo === 'FECHA' && valorElement.type === 'date' && valorElement.value) {
                // Convertir YYYY-MM-DD a DD/MM/YYYY
                var parts = valorElement.value.split('-');
                if (parts.length === 3) {
                    return parts[2] + '/' + parts[1] + '/' + parts[0];
                }
            }

            return valorElement.value;
        }

        function submitCreate() {
            var form = document.getElementById('createForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            var tipoParametro = document.getElementById('create_TipoParametro').value;
            if (!tipoParametro) {
                f_alert('w', '', 'Seleccione un tipo de parametro');
                return;
            }

            var data = {
                Codigo: document.getElementById('create_Codigo').value,
                Descripcion: document.getElementById('create_Descripcion').value,
                Valor: getValorByTipo('create'),
                TipoParametro: tipoParametro
            };

            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            f_loading();
            fetch('@Url.Action("Create")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                f_remove_loading();
                if (result.success) {
                    $('#createModal').modal('hide');
                    toastr.success(result.message, 'Exito');
                    refreshList();
                } else {
                    f_alert('e', '', result.message);
                }
            })
            .catch(error => {
                f_remove_loading();
                f_alert('e', '', 'Error al procesar la solicitud');
            });
        }

        function submitEdit() {
            var form = document.getElementById('editForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            var tipoParametro = document.getElementById('edit_TipoParametro').value;
            if (!tipoParametro) {
                f_alert('w', '', 'Seleccione un tipo de parametro');
                return;
            }

            var data = {
                GuidRegistro: document.getElementById('edit_GuidRegistro').value,
                Codigo: document.getElementById('edit_Codigo').value,
                Descripcion: document.getElementById('edit_Descripcion').value,
                Valor: getValorByTipo('edit'),
                TipoParametro: tipoParametro,
                Activo: document.getElementById('edit_Activo').checked ? 1 : 0
            };

            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            f_loading();
            fetch('@Url.Action("Edit")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                f_remove_loading();
                if (result.success) {
                    $('#editModal').modal('hide');
                    toastr.success(result.message, 'Exito');
                    refreshList();
                } else {
                    f_alert('e', '', result.message);
                }
            })
            .catch(error => {
                f_remove_loading();
                f_alert('e', '', 'Error al procesar la solicitud');
            });
        }

        function submitDelete() {
            var data = {
                GuidRegistro: document.getElementById('delete_GuidRegistro').value
            };

            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            f_loading();
            fetch('@Url.Action("Delete")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                f_remove_loading();
                if (result.success) {
                    $('#deleteModal').modal('hide');
                    toastr.success(result.message, 'Exito');
                    refreshList();
                } else {
                    f_alert('e', '', result.message);
                }
            })
            .catch(error => {
                f_remove_loading();
                f_alert('e', '', 'Error al procesar la solicitud');
            });
        }
    </script>
}
