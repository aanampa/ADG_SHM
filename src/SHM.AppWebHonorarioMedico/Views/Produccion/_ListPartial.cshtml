@model SHM.AppWebHonorarioMedico.Models.ProduccionListViewModel

<style>
    thead th {
        vertical-align: middle !important;
        text-align: center !important;
    }
    .tabla-pequena {
        font-size: 14px;
    }

</style>

<div class="card-body table-responsive px-2 py-1">
    <table class="table table-sm table-bordered table-hover tabla-pequena" style="background-color: #FFFFFF; width: 100%;">
        <thead style="background-color: #6c757d; color: #fff;">
            <tr>
                <th class="align-middle text-center" style="width: 120px;">Acciones</th>
                <th class="align-middle" style="width: 90px;">Cod.<br/>Producción</th>
                <th class="align-middle" style="width: 120px;">Tipo Médico</th>
                <th class="align-middle" style="width: 130px;">Tipo Producción</th>
                <th class="align-middle" style="width: 120px;">Tipo Rubro</th>
                <th class="align-middle" style="width: 100px;">Periodo</th>
                <th class="align-middle">Descripción</th>
                <th class="align-middle">Cía Médica</th>
                <th class="align-middle text-right" style="width: 100px;">Total S/.</th>
                <th class="align-middle text-center" style="width: 120px;">Estado Factura</th>
                <th class="align-middle text-center" style="width: 100px;">Fecha Límite</th>
                <th class="align-middle text-center" style="width: 100px;">Fecha Vencimiento</th>
                <th class="align-middle" style="width: 120px;">Comprobante</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                @foreach (var item in Model.Items)
                {
                    var badgeClass = GetBadgeClass(item.Estado);
                    var esSolicitable = item.Estado == EstadoDescripcion.Produccion.FacturaPendiente
                                     || item.Estado == EstadoDescripcion.Produccion.FacturaSolicitada
                                     || item.Estado == EstadoDescripcion.Produccion.FacturaDevuelta;
                    var tooltipSolicitar  = item.Estado == EstadoDescripcion.Produccion.FacturaPendiente
                                          ? "Solicitar Factura"
                                          : "Renotificar Factura";
                    var fnSolicitar = item.Estado == EstadoDescripcion.Produccion.FacturaPendiente
                                    ? $"abrirModalSolicitudFacturaIndividual('{item.GuidRegistro}')"
                                    : $"abrirModalReNotificarFacturaIndividual('{item.GuidRegistro}')";
                    <tr>
                        <td class="text-center">
                            <button type="button" class="btn btn-info btn-xs" onclick="verDetalle('@item.GuidRegistro')"
                                title="Ver Detalle">
                                <i class="fas fa-eye"></i>
                            </button>
                            @if (esSolicitable)
                            {
                                <button type="button" class="btn btn-success btn-xs ml-1"
                                    onclick="@fnSolicitar"
                                    title="@tooltipSolicitar">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            }
                            @if (item.FechaLimite.HasValue)
                            {
                                <button type="button" class="btn btn-warning btn-xs ml-1"
                                    onclick="abrirHistorialNotificaciones('@item.GuidRegistro')"
                                    title="Ver correos enviados">
                                    <i class="fas fa-envelope"></i>
                                </button>
                            }
                        </td>
                        <td>@item.NumeroProduccion</td>
                        <td>@(item.DesTipoMedico ?? "-")</td>
                        <td>@item.DesTipoProduccion</td>
                        <td>@(item.DesTipoRubro ?? "-")</td>
                        <td>@(item.Periodo ?? "-")</td>
                        <td>@item.Descripcion</td>
                        <td>@item.RazonSocial</td>
                        <td class="text-right font-weight-bold">@(item.MtoTotal?.ToString("N2") ?? "-")</td>
                        <td class="text-center">
                            <span class="badge @badgeClass">@item.DesEstado</span>
                        </td>
                        <td class="text-center">
                            @if (item.FechaLimite.HasValue)
                            {
                                <span>@item.FechaLimite.Value.ToString("dd/MM/yyyy")</span>
                                <br /><span class="text-muted">@item.FechaLimite.Value.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture)</span>
                            }
                            else { <span>-</span> }
                        </td>
                        <td class="text-center">
                            @if (item.FacturaFechaVencimiento.HasValue)
                            {
                                <span>@item.FacturaFechaVencimiento.Value.ToString("dd/MM/yyyy")</span>
                            }
                            else { <span>-</span> }
                        </td>
                        <td>@(item.ComprobanteFactura ?? "-")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="13" class="text-center text-muted py-4">
                        <i class="fas fa-inbox fa-2x mb-2"></i>
                        <p class="mb-0">No se encontraron producciones</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="card-footer clearfix">
        <div class="float-left">
            <small class="text-muted">
                Mostrando @((Model.PageNumber - 1) * Model.PageSize + 1) -
                @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) de @Model.TotalCount registros
            </small>
        </div>
        <ul class="pagination pagination-sm m-0 float-right">
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link" href="javascript:void(0)" onclick="@(Model.PageNumber > 1 ? $"loadList({Model.PageNumber - 1})" : "")">
                    Anterior
                </a>
            </li>

            @{
                int startPage = Math.Max(1, Model.PageNumber - 2);
                int endPage   = Math.Min(Model.TotalPages, Model.PageNumber + 2);
            }
            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="javascript:void(0)" onclick="loadList(1)">1</a>
                </li>
                @if (startPage > 2)
                {
                    <li class="page-item disabled"><a class="page-link">…</a></li>
                }
            }
            @for (int i = startPage; i <= endPage; i++)
            {
                var pageNum = i;
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="javascript:void(0)" onclick="loadList(@pageNum)">@i</a>
                </li>
            }
            @if (endPage < Model.TotalPages)
            {
                @if (endPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><a class="page-link">…</a></li>
                }
                <li class="page-item">
                    <a class="page-link" href="javascript:void(0)" onclick="loadList(@Model.TotalPages)">@Model.TotalPages</a>
                </li>
            }

            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="javascript:void(0)" onclick="@(Model.PageNumber < Model.TotalPages ? $"loadList({Model.PageNumber + 1})" : "")">
                    Siguiente
                </a>
            </li>
        </ul>
    </div>
}
else if (Model.TotalCount > 0)
{
    <div class="card-footer">
        <small class="text-muted">
            Mostrando @Model.TotalCount registro(s)
        </small>
    </div>
}

@functions {
    string GetBadgeClass(string? estado)
    {
        return EstadoDescripcion.Produccion.GetBadgeClass(estado);
    }

}

