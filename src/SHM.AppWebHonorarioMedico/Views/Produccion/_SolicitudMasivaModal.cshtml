@using SHM.AppDomain.Constants
@model SHM.AppWebHonorarioMedico.Models.SolicitudMasivaViewModel

@{
    var habilitados    = Model.Items.Where(i => i.Habilitado).ToList();
    var deshabilitados = Model.Items.Where(i => !i.Habilitado).ToList();
    var esIndividual   = Model.EsModoIndividual;
    var itemIndividual = esIndividual ? Model.Items.FirstOrDefault() : null;
}

<div class="modal fade" id="modalSolicitudMasiva" tabindex="-1" role="dialog" aria-labelledby="modalSolicitudMasivaLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #28a745; color: #fff;">
                <h5 class="modal-title" id="modalSolicitudMasivaLabel">
                    <i class="fas fa-paper-plane mr-2"></i>Solicitud de Factura(s)
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body py-2">
                @if (!Model.Items.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fas fa-inbox fa-2x mb-2"></i>
                        <p class="mb-0">No hay producciones pendientes de solicitud</p>
                    </div>
                }
                else
                {
                    <!-- Indicador de pasos -->
                    <div class="d-flex align-items-center justify-content-center mb-3">
                        <div class="d-flex flex-column align-items-center" style="min-width:130px;">
                            <div id="smStepCircle1" style="width:32px;height:32px;border-radius:50%;background:#007bff;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:14px;">1</div>
                            <small id="smStepLabel1" class="mt-1 font-weight-bold text-primary">Seleccionar</small>
                        </div>
                        <div style="flex:1;height:2px;background:#dee2e6;margin-bottom:18px;max-width:80px;"></div>
                        <div class="d-flex flex-column align-items-center" style="min-width:130px;">
                            <div id="smStepCircle2" style="width:32px;height:32px;border-radius:50%;background:#dee2e6;color:#6c757d;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:14px;">2</div>
                            <small id="smStepLabel2" class="mt-1 text-muted">Solicitar / Renotificar</small>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════
                         PASO 1 — Seleccionar registro(s)
                    ══════════════════════════════════════ -->
                    <div id="smPaso1">

                        @if (!esIndividual)
                        {
                        <div class="row mb-2">
                            <div class="col-md-12 d-flex align-items-center">
                                <span class="font-weight-bold small mr-2" style="white-space:nowrap;">Filtrar por estado:</span>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-secondary" id="smFiltroPendiente"
                                            onclick="smFiltrarTipo('pendiente')">
                                        Factura Pendiente
                                        <span class="badge badge-light ml-1">@Model.Items.Count(i => i.Estado == EstadoDescripcion.Produccion.FacturaPendiente)</span>
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" id="smFiltroSolicitada"
                                            onclick="smFiltrarTipo('solicitada')">
                                        Solicitada / Devuelta
                                        <span class="badge badge-light ml-1">@Model.Items.Count(i => i.Estado == EstadoDescripcion.Produccion.FacturaSolicitada || i.Estado == EstadoDescripcion.Produccion.FacturaDevuelta)</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                        }

                        <div class="table-responsive" style="max-height: 360px; overflow-y: auto;">
                            <table class="table table-sm table-bordered mb-0" style="font-size: 13px;">
                                <thead style="background-color: #6c757d; color: #fff; position: sticky; top: 0; z-index: 1;">
                                    <tr>
                                        <th class="text-center align-middle" style="width: 40px;">
                                            <input type="checkbox" id="smChkSelectAll" title="Seleccionar todos los visibles" />
                                        </th>
                                        <th class="align-middle" style="width: 110px;">Cód. Producción</th>
                                        <th class="align-middle" style="width: 130px;">Tipo Producción</th>
                                        <th class="align-middle d-none" style="width: 100px;">Tipo Médico</th>
                                        <th class="align-middle">Cía Médica</th>
                                        <th class="align-middle" style="width: 80px;">Periodo</th>
                                        <th class="align-middle text-right" style="width: 100px;">Total S/.</th>
                                        <th class="align-middle text-center" style="width: 110px;">Estado</th>
                                        <th class="align-middle text-center" style="width: 110px;">Fecha Límite</th>
                                        <th class="align-middle text-center" style="width: 110px;">F. Vencimiento</th>
                                        <th class="align-middle" style="width: 160px;">Observación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        var rowClass   = item.Habilitado ? "" : "table-light text-muted";
                                        var badgeClass = EstadoDescripcion.Produccion.GetBadgeClass(item.Estado);
                                        <tr class="sm-row @rowClass" data-estado="@item.Estado">
                                            <td class="text-center">
                                                @if (item.Habilitado)
                                                {
                                                    <input type="checkbox" class="sm-chk-item"
                                                           data-guid="@item.GuidRegistro"
                                                           data-estado="@item.Estado" />
                                                }
                                                else
                                                {
                                                    <input type="checkbox" disabled title="@item.MotivoDeshabilitado" />
                                                }
                                            </td>
                                            <td>@(item.NumeroProduccion ?? "-")</td>
                                            <td>@(item.DesTipoProduccion ?? "-")</td>
                                            <td class="d-none">@(item.DesTipoMedico ?? "-")</td>
                                            <td>@(item.RazonSocial ?? "-")</td>
                                            <td>@(item.Periodo ?? "-")</td>
                                            <td class="text-right font-weight-bold">@(item.MtoTotal?.ToString("N2") ?? "-")</td>
                                            <td class="text-center">
                                                <span class="badge @badgeClass">@item.DesEstado</span>
                                            </td>
                                            <td class="text-center">
                                                @if (item.FechaLimite.HasValue)
                                                {
                                                    <span>@item.FechaLimite.Value.ToString("dd/MM/yyyy")</span>
                                                    <br /><span class="text-muted">@item.FechaLimite.Value.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture)</span>
                                                }
                                                else { <span class="text-muted">—</span> }
                                            </td>
                                            <td class="text-center">
                                                @if (item.FechaVencimiento.HasValue)
                                                {
                                                    <span>@item.FechaVencimiento.Value.ToString("dd/MM/yyyy")</span>
                                                }
                                                else { <span class="text-muted">—</span> }
                                            </td>
                                            <td>
                                                @if (!item.Habilitado)
                                                {
                                                    <span class="text-danger small"><i class="fas fa-exclamation-circle mr-1"></i>@item.MotivoDeshabilitado</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-1">
                            <small class="text-muted">
                                Total: <strong>@Model.Items.Count</strong> |
                                Habilitados: <strong class="text-success">@habilitados.Count</strong> |
                                No habilitados: <strong class="text-danger">@deshabilitados.Count</strong> |
                                Seleccionados: <strong id="smContadorSeleccionados">0</strong>
                            </small>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════
                         PASO 2 — Acción y fechas
                    ══════════════════════════════════════ -->
                    <div id="smPaso2" style="display:none;">

                        <!-- Resumen de selección -->
                        <div id="smResumenSeleccion" class="mb-2 p-2 rounded" style="background:#f8f9fa; border:1px solid #dee2e6; font-size:13px;"></div>

                        <!-- VARIANTE B: Solicitadas/Devueltas — 2 opciones de acción -->
                        <div id="smAccionSolicitada" style="display:none;">
                            <div class="border rounded p-2 mb-2" style="background:#f8f9fa;">
                                <div class="small font-weight-bold mb-2 text-secondary">
                                    <i class="fas fa-tasks mr-1"></i>Acción a realizar
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="smAccion"
                                           id="smRadioSoloRenotificar" value="renotificar" checked
                                           onchange="smToggleAccionSolicitada()" />
                                    <label class="form-check-label" for="smRadioSoloRenotificar">
                                        <strong>Solo Renotificar</strong>
                                        <small class="text-muted d-block">Reenvía el correo de solicitud sin cambiar fechas</small>
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="smAccion"
                                           id="smRadioCambiarFecha" value="cambiar"
                                           onchange="smToggleAccionSolicitada()" />
                                    <label class="form-check-label" for="smRadioCambiarFecha">
                                        <strong>Cambiar Fecha Límite y Renotificar</strong>
                                        <small class="text-muted d-block">Actualiza la fecha límite, la fecha de vencimiento y reenvía el correo</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- VARIANTE A: Pendientes / Solicitadas opción "cambiar" — Fecha Límite obligatoria -->
                        <div id="smFechaObligatoria" style="display:none;">
                            <div class="border rounded p-2 mb-2" style="background:#f8f9fa;">
                                <div class="small font-weight-bold mb-2 text-secondary">
                                    <i class="fas fa-clock mr-1"></i>Plazo de entrega
                                </div>
                                <div class="row">
                                    <div class="col-md-3">
                                        <label class="small font-weight-bold">Fecha Límite <span class="text-danger">*</span></label>
                                        <input type="date" id="smFechaObl" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="small font-weight-bold">Hora Límite <span class="text-danger">*</span></label>
                                        <select id="smHoraObl" class="form-control form-control-sm">
                                            <option value="">-- Hora --</option>
                                            @foreach (var h in Enumerable.Range(8, 15))
                                            {
                                                foreach (var m in new[] { 0, 15, 30, 45 })
                                                {
                                                    var val = $"{h:D2}:{m:D2}";
                                                    <option value="@val">@val</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    @if (!esIndividual)
                                    {
                                    <div class="col-md-7 d-flex align-items-end">
                                        <small class="text-muted"><i class="fas fa-info-circle mr-1"></i>Se aplicará a todos los registros seleccionados.</small>
                                    </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Fecha Vencimiento Factura (visible en Pendientes y en Solicitadas opción "cambiar") -->
                        <div id="smFechaVencimientoSection" style="display:none;">
                            <div class="border rounded p-2" style="background:#fff;">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label class="small font-weight-bold">
                                            Fecha Vencimiento Factura <span class="text-danger">*</span>
                                        </label>
                                        <input type="date" id="smFechaVencimiento" class="form-control form-control-sm" />
                                        <small class="text-muted">Dato a consignar en la factura emitida.</small>
                                    </div>
                                    @if (!esIndividual)
                                    {
                                    <div class="col-md-8 d-flex align-items-center">
                                        <small class="text-muted">
                                            <i class="fas fa-info-circle mr-1 text-info"></i>
                                            Se aplicará la misma fecha a todos los registros seleccionados.
                                        </small>
                                    </div>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>
                }
            </div>

            @if (Model.Items.Any())
            {
                <div class="modal-footer py-2" style="display:block;">
                    <div id="smFooterPaso1" style="display:flex; justify-content:space-between; align-items:center;">
                        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">
                            <i class="fas fa-times mr-1"></i>Cancelar
                        </button>
                        <button type="button" class="btn btn-primary btn-sm" id="btnSiguiente"
                                onclick="smIrPaso2()" disabled>
                            Siguiente <i class="fas fa-arrow-right ml-1"></i>
                        </button>
                    </div>
                    <div id="smFooterPaso2" style="display:none; justify-content:space-between; align-items:center;">
                        <button type="button" class="btn btn-secondary btn-sm" onclick="smIrPaso1()">
                            <i class="fas fa-arrow-left mr-1"></i>Anterior
                        </button>
                        <button type="button" class="btn btn-success btn-sm" id="btnEjecutarMasivo"
                                onclick="smEjecutar()">
                            <i class="fas fa-paper-plane mr-1"></i><span id="smBtnEjecutarLabel">Ejecutar</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
var smEsModoIndividual    = @(esIndividual ? "true" : "false");
var smGuidIndividual      = '@(itemIndividual?.GuidRegistro ?? "")';
var smEstadoIndividual    = '@(itemIndividual?.Estado ?? "")';
var smNumeroIndividual    = '@(itemIndividual?.NumeroProduccion ?? "")';
var smCiaIndividual       = '@(itemIndividual?.RazonSocial ?? "")';
var smMtoIndividual       = '@(itemIndividual?.MtoTotal?.ToString("N2") ?? "")';
var smDesEstadoIndividual = '@(itemIndividual?.DesEstado ?? "")';
var smBadgeIndividual     = '@(itemIndividual != null ? EstadoDescripcion.Produccion.GetBadgeClass(itemIndividual.Estado) : "")';

var SM_ESTADO_PENDIENTE  = '@EstadoDescripcion.Produccion.FacturaPendiente';
var SM_ESTADO_SOLICITADA = '@EstadoDescripcion.Produccion.FacturaSolicitada';
var SM_ESTADO_DEVUELTA   = '@EstadoDescripcion.Produccion.FacturaDevuelta';

var smFiltroActivo = 'pendiente'; // 'pendiente' | 'solicitada'

(function () {
    var modal  = document.getElementById('modalSolicitudMasiva');
    var chkAll = document.getElementById('smChkSelectAll');

    if (chkAll) {
        chkAll.addEventListener('change', function () {
            document.querySelectorAll('.sm-row:not([style*="display: none"]) .sm-chk-item')
                    .forEach(function (cb) { cb.checked = chkAll.checked; });
            smActualizarContador();
        });
    }

    modal.addEventListener('change', function (e) {
        if (e.target.classList.contains('sm-chk-item')) {
            smActualizarContador();
            var visibles = document.querySelectorAll('.sm-row:not([style*="display: none"]) .sm-chk-item');
            var marcados = document.querySelectorAll('.sm-row:not([style*="display: none"]) .sm-chk-item:checked');
            if (chkAll) chkAll.checked = (visibles.length > 0 && visibles.length === marcados.length);
        }
    });

    // Re-inicializar cada vez que se abre (para el caso Detalle con botón)
    modal.addEventListener('show.bs.modal', function () {
        smResetPaso1();
    });

    // Para Index (inyección AJAX): el script se ejecuta después de cargar la página,
    // aplicar el reset inmediatamente y luego mostrar el modal
    if (document.readyState !== 'loading') {
        smResetPaso1();
        $('#modalSolicitudMasiva').modal('show');
    }
})();

// ─── Reset al Paso 1 ─────────────────────────────────────────────────────────

function smResetPaso1() {
    document.getElementById('smPaso1').style.display       = '';
    document.getElementById('smPaso2').style.display       = 'none';
    document.getElementById('smFooterPaso1').style.display = 'flex';
    document.getElementById('smFooterPaso2').style.display = 'none';

    var c1 = document.getElementById('smStepCircle1');
    var c2 = document.getElementById('smStepCircle2');
    if (c1) { c1.style.background = '#007bff'; c1.style.color = '#fff'; }
    if (c2) { c2.style.background = '#dee2e6'; c2.style.color = '#6c757d'; }
    var l1 = document.getElementById('smStepLabel1');
    var l2 = document.getElementById('smStepLabel2');
    if (l1) l1.className = 'mt-1 font-weight-bold text-primary small';
    if (l2) l2.className = 'mt-1 text-muted small';

    if (smEsModoIndividual) {
        smFiltroActivo = (smEstadoIndividual === SM_ESTADO_PENDIENTE) ? 'pendiente' : 'solicitada';
        var chk = document.querySelector('.sm-chk-item[data-guid="' + smGuidIndividual + '"]');
        if (chk) { chk.checked = true; smActualizarContador(); }
    } else {
        smFiltrarTipo('pendiente');
    }

    // Limpiar campos Paso 2
    document.getElementById('smFechaObl').value       = '';
    document.getElementById('smHoraObl').value        = '';
    document.getElementById('smFechaVencimiento').value = '';
}

// ─── Paso 1: Filtros ──────────────────────────────────────────────────────────

function smFiltrarTipo(tipo) {
    smFiltroActivo = tipo;

    var btnPend = document.getElementById('smFiltroPendiente');
    var btnSoli = document.getElementById('smFiltroSolicitada');

    if (btnPend) {
        btnPend.classList.remove('active', 'btn-secondary', 'btn-outline-secondary');
        btnPend.classList.add(tipo === 'pendiente' ? 'active' : 'btn-outline-secondary');
        if (tipo === 'pendiente') btnPend.classList.add('btn-secondary');
    }
    if (btnSoli) {
        btnSoli.classList.remove('active', 'btn-secondary', 'btn-outline-secondary');
        btnSoli.classList.add(tipo === 'solicitada' ? 'active' : 'btn-outline-secondary');
        if (tipo === 'solicitada') btnSoli.classList.add('btn-secondary');
    }

    document.querySelectorAll('.sm-row').forEach(function (row) {
        var est = row.dataset.estado;
        var visible = tipo === 'pendiente'
            ? est === SM_ESTADO_PENDIENTE
            : est === SM_ESTADO_SOLICITADA || est === SM_ESTADO_DEVUELTA;
        row.style.display = visible ? '' : 'none';
    });

    document.querySelectorAll('.sm-chk-item').forEach(function (cb) { cb.checked = false; });
    var chkAll = document.getElementById('smChkSelectAll');
    if (chkAll) chkAll.checked = false;
    smActualizarContador();
}

function smActualizarContador() {
    var count = document.querySelectorAll('.sm-chk-item:checked').length;
    document.getElementById('smContadorSeleccionados').textContent = count;
    var btn = document.getElementById('btnSiguiente');
    if (btn) btn.disabled = (count === 0);
}

// ─── Transiciones entre pasos ─────────────────────────────────────────────────

function smGetGuids() {
    if (smEsModoIndividual) return [smGuidIndividual];
    return Array.from(document.querySelectorAll('.sm-chk-item:checked')).map(function (cb) { return cb.dataset.guid; });
}

function smIrPaso2() {
    var guids = smGetGuids();
    if (guids.length === 0) return;

    // Resumen
    var html = '';
    if (smEsModoIndividual) {
        html = '<div><i class="fas fa-file-invoice mr-1 text-primary"></i>' +
               '<strong>' + smNumeroIndividual + '</strong> &mdash; ' + smCiaIndividual +
               ' &mdash; S/. ' + smMtoIndividual +
               ' &mdash; <span class="badge ' + smBadgeIndividual + '">' + smDesEstadoIndividual + '</span></div>';
    } else {
        var tipo = smFiltroActivo === 'pendiente' ? 'pendiente(s)' : 'solicitada(s) / devuelta(s)';
        html = '<div><i class="fas fa-check-square text-success mr-1"></i>' +
               '<strong>' + guids.length + '</strong> registro(s) ' + tipo + ' seleccionado(s)</div>';
    }
    document.getElementById('smResumenSeleccion').innerHTML = html;

    // Mostrar variante correcta y limpiar
    if (smFiltroActivo === 'pendiente') {
        document.getElementById('smFechaObligatoria').style.display    = '';
        document.getElementById('smFechaVencimientoSection').style.display = '';
        document.getElementById('smAccionSolicitada').style.display    = 'none';
        document.getElementById('smFechaObl').value        = '';
        document.getElementById('smHoraObl').value         = '';
        document.getElementById('smFechaVencimiento').value = '';
        document.getElementById('smBtnEjecutarLabel').textContent =
            smEsModoIndividual ? 'Solicitar Factura' : 'Solicitar Seleccionados';
    } else {
        document.getElementById('smFechaObligatoria').style.display    = 'none';
        document.getElementById('smFechaVencimientoSection').style.display = 'none';
        document.getElementById('smAccionSolicitada').style.display    = '';
        document.getElementById('smRadioSoloRenotificar').checked = true;
        smToggleAccionSolicitada();
    }

    // Indicadores paso
    document.getElementById('smStepCircle1').style.background = '#28a745';
    document.getElementById('smStepCircle1').style.color      = '#fff';
    document.getElementById('smStepLabel1').className = 'mt-1 text-success small';
    document.getElementById('smStepCircle2').style.background = '#007bff';
    document.getElementById('smStepCircle2').style.color      = '#fff';
    document.getElementById('smStepLabel2').className = 'mt-1 font-weight-bold text-primary small';

    document.getElementById('smPaso1').style.display       = 'none';
    document.getElementById('smPaso2').style.display       = '';
    document.getElementById('smFooterPaso1').style.display = 'none';
    document.getElementById('smFooterPaso2').style.display = 'flex';
}

function smIrPaso1() {
    document.getElementById('smStepCircle1').style.background = '#007bff';
    document.getElementById('smStepCircle1').style.color      = '#fff';
    document.getElementById('smStepLabel1').className = 'mt-1 font-weight-bold text-primary small';
    document.getElementById('smStepCircle2').style.background = '#dee2e6';
    document.getElementById('smStepCircle2').style.color      = '#6c757d';
    document.getElementById('smStepLabel2').className = 'mt-1 text-muted small';

    document.getElementById('smPaso2').style.display       = 'none';
    document.getElementById('smPaso1').style.display       = '';
    document.getElementById('smFooterPaso2').style.display = 'none';
    document.getElementById('smFooterPaso1').style.display = 'flex';
}

function smToggleAccionSolicitada() {
    var esCambiar = document.getElementById('smRadioCambiarFecha').checked;
    document.getElementById('smFechaObligatoria').style.display       = esCambiar ? '' : 'none';
    document.getElementById('smFechaVencimientoSection').style.display = esCambiar ? '' : 'none';
    if (esCambiar) {
        document.getElementById('smFechaObl').value        = '';
        document.getElementById('smHoraObl').value         = '';
        document.getElementById('smFechaVencimiento').value = '';
    }
    document.getElementById('smBtnEjecutarLabel').textContent = esCambiar ? 'Cambiar y Renotificar' : 'Renotificar';
}

// ─── Paso 2: Ejecutar ─────────────────────────────────────────────────────────

function smFormatearHoraAmPm(hora) {
    var p = hora.split(':'), h = parseInt(p[0]), m = p[1];
    var sfx = h >= 12 ? 'PM' : 'AM', h12 = h % 12 || 12;
    return String(h12).padStart(2, '0') + ':' + m + ' ' + sfx;
}

function smMostrarErrores(errores) {
    Swal.fire({
        icon: 'warning', title: 'Atención',
        html: '<ul style="text-align:left;">' + errores.map(function (e) { return '<li>' + e + '</li>'; }).join('') + '</ul>',
        confirmButtonColor: '#f26522'
    });
}

function smEjecutar() {
    var guids = smGetGuids();
    if (guids.length === 0) return;

    var token = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value || '';

    if (smFiltroActivo === 'pendiente') {
        // ── Solicitar factura(s) pendiente(s) ──
        var fecha            = document.getElementById('smFechaObl').value;
        var hora             = document.getElementById('smHoraObl').value;
        var fechaVencimiento = document.getElementById('smFechaVencimiento').value;

        var errores = [];
        if (!fecha) errores.push('La fecha límite es requerida');
        if (!hora)  errores.push('La hora límite es requerida');
        if (fecha && hora && new Date(fecha + 'T' + hora) <= new Date())
            errores.push('La fecha y hora límite debe ser mayor a la actual');
        if (!fechaVencimiento) errores.push('La fecha de vencimiento de factura es requerida');
        if (errores.length > 0) { smMostrarErrores(errores); return; }

        var confirmHtml = '<div><i class="fas fa-file-invoice text-warning mr-1"></i>Solicitar factura a <strong>' + guids.length + '</strong> registro(s)</div>' +
                          '<div class="mt-1"><small>Fecha límite: <strong>' + fecha.split('-').reverse().join('/') + ' ' + smFormatearHoraAmPm(hora) + '</strong></small></div>';

        Swal.fire({
            icon: 'question', title: 'Confirmar operación', html: confirmHtml,
            showCancelButton: true,
            confirmButtonColor: '#28a745', cancelButtonColor: '#6c757d',
            confirmButtonText: '<i class="fas fa-check"></i> Confirmar', cancelButtonText: 'Cancelar'
        }).then(function (result) {
            if (!result.isConfirmed) return;
            smMostrarProcesando();

            fetch('@Url.Action("SolicitarFacturaMasivo", "Produccion")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ guids: guids, fecha: fecha, hora: hora, fechaVencimiento: fechaVencimiento })
            })
            .then(function (r) { return r.json(); })
            .then(function (d) { smMostrarResultado(d); })
            .catch(function ()  { smMostrarResultado({ success: false, message: 'Error al procesar la solicitud.' }); });
        });

    } else {
        // ── Renotificar solicitadas / devueltas ──
        var esCambiar = document.getElementById('smRadioCambiarFecha').checked;

        if (esCambiar) {
            var fecha            = document.getElementById('smFechaObl').value;
            var hora             = document.getElementById('smHoraObl').value;
            var fechaVencimiento = document.getElementById('smFechaVencimiento').value;

            var errores = [];
            if (!fecha) errores.push('La fecha límite es requerida');
            if (!hora)  errores.push('La hora límite es requerida');
            if (fecha && hora && new Date(fecha + 'T' + hora) <= new Date())
                errores.push('La fecha y hora límite debe ser mayor a la actual');
            if (!fechaVencimiento) errores.push('La fecha de vencimiento de factura es requerida');
            if (errores.length > 0) { smMostrarErrores(errores); return; }

            var confirmHtml = '<div><i class="fas fa-bell text-info mr-1"></i>Cambiar fecha límite y renotificar <strong>' + guids.length + '</strong> registro(s)</div>' +
                              '<div class="mt-1"><small>Nueva fecha límite: <strong>' + fecha.split('-').reverse().join('/') + ' ' + smFormatearHoraAmPm(hora) + '</strong></small></div>';

            Swal.fire({
                icon: 'question', title: 'Confirmar operación', html: confirmHtml,
                showCancelButton: true,
                confirmButtonColor: '#28a745', cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-check"></i> Confirmar', cancelButtonText: 'Cancelar'
            }).then(function (result) {
                if (!result.isConfirmed) return;
                smMostrarProcesando();

                fetch('@Url.Action("RenotificarFacturaMasivo", "Produccion")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ guids: guids, fecha: fecha, hora: hora, fechaVencimiento: fechaVencimiento })
                })
                .then(function (r) { return r.json(); })
                .then(function (d) { smMostrarResultado(d); })
                .catch(function ()  { smMostrarResultado({ success: false, message: 'Error al procesar.' }); });
            });

        } else {
            // Solo renotificar
            var confirmHtml = '<div><i class="fas fa-bell text-info mr-1"></i>Renotificar <strong>' + guids.length + '</strong> registro(s) sin cambiar fechas</div>';

            Swal.fire({
                icon: 'question', title: 'Confirmar operación', html: confirmHtml,
                showCancelButton: true,
                confirmButtonColor: '#28a745', cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-check"></i> Confirmar', cancelButtonText: 'Cancelar'
            }).then(function (result) {
                if (!result.isConfirmed) return;
                smMostrarProcesando();

                fetch('@Url.Action("RenotificarFacturaMasivo", "Produccion")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ guids: guids })
                })
                .then(function (r) { return r.json(); })
                .then(function (d) { smMostrarResultado(d); })
                .catch(function ()  { smMostrarResultado({ success: false, message: 'Error al procesar.' }); });
            });
        }
    }
}

function smMostrarProcesando() {
    Swal.fire({
        title: 'Procesando...', text: 'Por favor espere.',
        allowOutsideClick: false, allowEscapeKey: false, showConfirmButton: false,
        didOpen: function () { Swal.showLoading(); }
    });
}

function smMostrarResultado(d) {
    Swal.close();
    var totalErrores = d.errores || (d.success ? 0 : 1);
    $('#modalSolicitudMasiva').modal('hide');
    Swal.fire({
        icon: totalErrores > 0 ? 'warning' : 'success',
        title: 'Proceso completado',
        text: d.message,
        confirmButtonColor: '#28a745'
    }).then(function () { refreshList(); });
}
</script>
