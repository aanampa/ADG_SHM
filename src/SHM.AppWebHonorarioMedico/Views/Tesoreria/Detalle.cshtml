@model SHM.AppDomain.DTOs.OrdenPago.OrdenPagoResponseDto
@using SHM.AppDomain.Constants
@{
    ViewData["Title"] = "Detalle - Tesorería";
    var liquidaciones = ViewBag.Liquidaciones as List<SHM.AppDomain.DTOs.OrdenPagoLiquidacion.OrdenPagoLiquidacionResponseDto>
        ?? new List<SHM.AppDomain.DTOs.OrdenPagoLiquidacion.OrdenPagoLiquidacionResponseDto>();
    var detalleLiquidaciones = ViewBag.DetalleLiquidaciones as List<SHM.AppDomain.DTOs.OrdenPagoLiquidacion.DetalleLiquidacionItemDto>
        ?? new List<SHM.AppDomain.DTOs.OrdenPagoLiquidacion.DetalleLiquidacionItemDto>();
}

<style>
    .card-compact .card-header { padding: 0.5rem 0.75rem; }
    .card-compact .card-body   { padding: 0.75rem; }
    .card-compact .card-title  { font-size: 0.9rem; margin-bottom: 0; }
    .form-group-sm { margin-bottom: 0.5rem; }
    .form-group-sm label { font-size: 0.8rem; margin-bottom: 0.15rem; color: #6c757d; }
    .form-group-sm .form-control-sm { font-size: 0.8rem; padding: 0.2rem 0.4rem; height: auto; }
    .table-liq thead th { vertical-align: middle !important; text-align: center; }
    .table-liq thead th.text-right { text-align: right !important; }
    .row-selected { background-color: #fff3cd !important; }
</style>

<div class="wrapper">
    <div class="content-wrapper" style="min-height: auto;">

        <div class="content-header py-2">
            <div class="container-fluid">
                <div class="d-flex justify-content-between align-items-center">
                    <h1 class="m-0 titulo-formulario" style="font-size: 1.2rem;">
                        <i class="fas fa-cash-register mr-2"></i>Tesorería: @(Model.NumeroOrdenPago ?? "-")
                    </h1>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("DescargarOrdenPago", "Tesoreria", new { guid = Model.GuidRegistro })"
                           class="btn btn-sm btn-outline-danger" title="Descargar PDF de la Orden de Pago" target="_blank">
                            <i class="fas fa-file-pdf mr-1"></i>PDF
                        </a>
                        <a href="@Url.Action("DescargarExcelOrdenPago", "Tesoreria", new { guid = Model.GuidRegistro })"
                           class="btn btn-sm btn-outline-success" title="Descargar Excel con comprobantes de la Orden de Pago">
                            <i class="fas fa-file-excel mr-1"></i>Excel
                        </a>
                        <a href="@Url.Action("Index", "Tesoreria")"
                           class="btn btn-sm btn-outline-secondary" title="Volver a la bandeja">
                            <i class="fas fa-arrow-left mr-1"></i>Volver
                        </a>
                    </div>
                </div>
                <ol class="breadcrumb m-0 bg-transparent p-0 mt-1" style="font-size: 0.8rem;">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Tesoreria")">Tesorería</a></li>
                    <li class="breadcrumb-item active">Detalle</li>
                </ol>
            </div>
        </div>

        <section class="content py-0">
            <div class="container-fluid">

                <!-- Datos de Orden de Pago -->
                <div class="card card-compact mb-2 w-75">
                    <div class="card-header bg-light">
                        <h3 class="card-title">
                            <i class="fas fa-info-circle mr-1"></i>Datos de Orden de Pago
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-3">
                                <div class="form-group-sm">
                                    <label>Orden de Pago</label>
                                    <input type="text" class="form-control form-control-sm" value="@(Model.NumeroOrdenPago ?? "-")" readonly style="background-color: #e9ecef;">
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="form-group-sm">
                                    <label>Banco</label>
                                    <input type="text" class="form-control form-control-sm" value="@(Model.NombreBanco ?? "-")" readonly style="background-color: #e9ecef;">
                                </div>
                            </div>
                            <div class="col-2">
                                <div class="form-group-sm">
                                    <label>Fecha de Generación</label>
                                    <input type="text" class="form-control form-control-sm" value="@(Model.FechaGeneracion?.ToString("dd/MM/yyyy") ?? "-")" readonly style="background-color: #e9ecef;">
                                </div>
                            </div>
                            <div class="col-2">
                                <div class="form-group-sm">
                                    <label>Estado</label>
                                    <div>
                                        <span class="badge @EstadoDescripcion.OrdenPago.GetBadgeClass(Model.Estado)" style="font-size: 0.75rem; padding: 0.35rem 0.5rem;">
                                            @EstadoDescripcion.OrdenPago.GetDescripcion(Model.Estado)
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-2">
                                <div class="form-group-sm">
                                    <label>Fecha Aprobaci&oacute;n</label>
                                    @if (Model.FechaAprobacion.HasValue)
                                    {
                                        <input type="text" class="form-control form-control-sm"
                                               value="@Model.FechaAprobacion.Value.ToString("dd/MM/yyyy HH:mm")"
                                               readonly style="background-color: #e9ecef;">
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control form-control-sm"
                                               value="-" readonly style="background-color: #e9ecef;">
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-2">
                                <div class="form-group-sm">
                                    <label>N° de Liquidaciones</label>
                                    <input type="text" class="form-control form-control-sm" value="@(Model.CantLiquidaciones?.ToString() ?? "-")" readonly style="background-color: #e9ecef;">
                                </div>
                            </div>
                            <div class="col-2">
                                <div class="form-group-sm">
                                    <label>N° de Facturas</label>
                                    <input type="text" class="form-control form-control-sm" value="@(Model.CantComprobantes?.ToString() ?? "-")" readonly style="background-color: #e9ecef;">
                                </div>
                            </div>
                            <div class="col-2">
                                <div class="form-group-sm">
                                    <label>Sub Total (S/.)</label>
                                    <input type="text" class="form-control form-control-sm" value="@(Model.MtoSubtotalAcum?.ToString("N2") ?? "--")" readonly style="background-color: #e9ecef;">
                                </div>
                            </div>
                            <div class="col-2">
                                <div class="form-group-sm">
                                    <label>IGV (S/.)</label>
                                    <input type="text" class="form-control form-control-sm" value="@(Model.MtoIgvAcum?.ToString("N2") ?? "--")" readonly style="background-color: #e9ecef;">
                                </div>
                            </div>
                            <div class="col-2">
                                <div class="form-group-sm">
                                    <label>Imp. Renta (S/.)</label>
                                    <input type="text" class="form-control form-control-sm" value="@(Model.MtoRentaAcum?.ToString("N2") ?? "--")" readonly style="background-color: #e9ecef;">
                                </div>
                            </div>
                            <div class="col-2">
                                <div class="form-group-sm">
                                    <label>Total (S/.)</label>
                                    <input type="text" class="form-control form-control-sm font-weight-bold" value="@(Model.MtoTotalAcum?.ToString("N2") ?? "--")" readonly style="background-color: #e9ecef;">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Liquidaciones asociadas -->
                <div class="card card-compact mb-2">
                    <div class="card-header bg-light">
                        <h3 class="card-title">
                            <i class="fas fa-list-alt mr-1"></i>Liquidaciones (@liquidaciones.Count)
                        </h3>
                    </div>
                    <div class="card-body p-2">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover table-bordered mb-0 table-liq" style="font-size: 0.85rem; table-layout: fixed; width: 100%;">
                                <thead style="background-color: #6c757d; color: #fff;">
                                    <tr>
                                        <th style="width: 30px;">#</th>
                                        <th style="width: 110px;">Cod.<br/>Liquidación</th>
                                        <th style="width: 110px;">Tipo de<br/>Liquidaci&oacute;n</th>
                                        <th style="width: 150px;">Descripci&oacute;n</th>
                                        <th style="width: 85px;">Periodo</th>
                                        <th style="width: 160px;">Banco</th>
                                        <th style="width: 90px;">Cant.<br/>Comprob.</th>
                                        <th class="text-right" style="width: 100px;">Sub Total<br/>S/.</th>
                                        <th class="text-right" style="width: 80px;">IGV<br/>S/.</th>
                                        <th class="text-right" style="width: 90px;">Imp. Renta<br/>S/.</th>
                                        <th class="text-right" style="width: 100px;">Total<br/>S/.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (liquidaciones.Any())
                                    {
                                        var index = 0;
                                        @foreach (var liq in liquidaciones)
                                        {
                                            index++;
                                            <tr>
                                                <td class="text-center">@index</td>
                                                <td class="text-center">@(liq.NumeroLiquidacion ?? "-")</td>
                                                <td>@(liq.DesTipoLiquidacion ?? liq.TipoLiquidacion ?? "-")</td>
                                                <td>@(liq.DescripcionLiquidacion ?? "-")</td>
                                                <td class="text-center">@(liq.PeriodoLiquidacion ?? "-")</td>
                                                <td>@(liq.NombreBanco ?? "-")</td>
                                                <td class="text-center">@(liq.CantComprobantes?.ToString() ?? "-")</td>
                                                <td class="text-right">@(liq.MtoSubtotalAcum?.ToString("N2") ?? "--")</td>
                                                <td class="text-right">@(liq.MtoIgvAcum?.ToString("N2") ?? "--")</td>
                                                <td class="text-right">@(liq.MtoRentaAcum?.ToString("N2") ?? "--")</td>
                                                <td class="text-right font-weight-bold">@(liq.MtoTotalAcum?.ToString("N2") ?? "--")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="11" class="text-center text-muted py-3">
                                                <i class="fas fa-inbox fa-2x mb-2"></i>
                                                <p class="mb-0">No hay liquidaciones asociadas</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                @if (liquidaciones.Any())
                                {
                                    <tfoot class="bg-light font-weight-bold">
                                        <tr>
                                            <td colspan="7" class="text-right">TOTALES:</td>
                                            <td class="text-right">@(liquidaciones.Sum(l => l.MtoSubtotalAcum ?? 0).ToString("N2"))</td>
                                            <td class="text-right">@(liquidaciones.Sum(l => l.MtoIgvAcum ?? 0).ToString("N2"))</td>
                                            <td class="text-right">@(liquidaciones.Sum(l => l.MtoRentaAcum ?? 0).ToString("N2"))</td>
                                            <td class="text-right">@(liquidaciones.Sum(l => l.MtoTotalAcum ?? 0).ToString("N2"))</td>
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Detalle de Liquidaciones (con seleccion y boton Registrar Pago) -->
                <div class="card card-compact mb-2">
                    <div class="card-header bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-0">
                            <h3 class="card-title mb-0">
                                <i class="fas fa-file-alt mr-1"></i>Detalle de Liquidaciones (@detalleLiquidaciones.Count)
                            </h3>
                        </div>
                        <div class="row mt-2 align-items-end">
                            <div class="col-md-4">
                                <div class="form-group mb-0">
                                    <label class="mb-1 small">Cod. Liquidación</label>
                                    <select id="cboFiltroLiquidacion" class="form-control form-control-sm" onchange="filtrarDetalle()">
                                        <option value="">- Todos -</option>
                                        @{
                                            var liquidacionesUnicas = detalleLiquidaciones
                                                .Where(d => !string.IsNullOrEmpty(d.NumeroLiquidacion))
                                                .GroupBy(d => d.NumeroLiquidacion)
                                                .Select(g => new {
                                                    Numero = g.Key,
                                                    Tipo   = g.First().DesTipoLiquidacion ?? g.First().TipoLiquidacion ?? ""
                                                })
                                                .OrderBy(x => x.Numero)
                                                .ToList();
                                        }
                                        @foreach (var liq in liquidacionesUnicas)
                                        {
                                            var label = string.IsNullOrEmpty(liq.Tipo)
                                                ? liq.Numero
                                                : $"{liq.Numero} - {liq.Tipo}";
                                            <option value="@liq.Numero">@label</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-auto">
                                <div class="form-group mb-0">
                                    <label class="mb-1 small">&nbsp;</label>
                                    <div class="d-flex align-items-center">
                                        <button type="button" id="btnSincronizarSAP" class="btn btn-sm btn-info" onclick="sincronizarSAP()"
                                                title="Sincronizar estado de pago de las facturas con SAP">
                                            <i class="fas fa-sync-alt mr-1"></i>Sincronizar con SAP
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-2">
                        <div class="table-responsive">
                            <table id="facturasTable" class="table table-sm table-hover table-bordered mb-0 table-liq" style="font-size: 0.85rem; table-layout: fixed; width: 100%;">
                                <thead style="background-color: #6c757d; color: #fff;">
                                    <tr>
                                        <th style="width: 35px; display:none;" class="text-center">
                                            <input type="checkbox" id="chkSelectAll" title="Seleccionar todos" />
                                        </th>
                                        <th style="width: 30px;">#</th>
                                        <th style="width: 130px;">Liquidaci&oacute;n</th>
                                        <th style="width: 85px;">RUC</th>
                                        <th style="width: 90px;">Cod.<br/>Acreedor</th>
                                        <th style="width: 100px;">Tipo<br/>Entidad</th>
                                        <th style="width: 130px;">Cia Medica</th>
                                        <th style="width: 160px;">Banco</th>
                                        <th style="width: 90px;">Comproban.</th>
                                        <th style="width: 90px;">F. Emisi&oacute;n</th>
                                        <th style="width: 40px;">PDF</th>
                                        <th style="width: 40px;">XML</th>
                                        <th style="width: 160px;">Estado</th>
                                        <th class="text-right" style="width: 100px;">Sub Total<br/>S/.</th>
                                        <th class="text-right" style="width: 80px;">IGV<br/>S/.</th>
                                        <th class="text-right" style="width: 90px;">Imp. Renta<br/>S/.</th>
                                        <th class="text-right" style="width: 100px;">Total<br/>S/.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (detalleLiquidaciones.Any())
                                    {
                                        var idxDet = 1;
                                        @foreach (var det in detalleLiquidaciones)
                                        {
                                            var numComp = (int.TryParse(det.Numero, out int nParsed) ? nParsed : 0).ToString("D7");
                                            var comprobante = !string.IsNullOrEmpty(det.TipoComprobante) && !string.IsNullOrEmpty(det.Serie) && !string.IsNullOrEmpty(det.Numero)
                                                ? $"{det.TipoComprobante.PadLeft(2, '0')}-0{det.Serie}-{numComp}"
                                                : "-";
                                            <tr data-numliq="@(det.NumeroLiquidacion ?? "")">
                                                <td class="text-center" style="display:none;">
                                                    <input type="checkbox" class="chk-factura"
                                                           data-guid="@det.GuidRegistro"
                                                           data-comprobante="@comprobante" />
                                                </td>
                                                <td class="text-center">@(idxDet++)</td>
                                                <td style="line-height: 1.6;">
                                                    <span class="font-weight-bold">@(det.NumeroLiquidacion ?? "-")</span><br/>
                                                    <small><span class="text-muted">Tipo:</span> @(det.DesTipoLiquidacion ?? det.TipoLiquidacion ?? "-")</small><br/>
                                                    <small><span class="text-muted">Periodo:</span> @(det.PeriodoLiquidacion ?? "-")</small>
                                                </td>
                                                <td class="text-center">@(det.Ruc ?? "-")</td>
                                                <td class="text-center">@(det.CodigoAcreedor ?? "-")</td>
                                                <td>@(det.DesTipoEntidadMedica ?? det.TipoEntidadMedica ?? "-")</td>
                                                <td>@(det.RazonSocial ?? "-")</td>
                                                <td class="text-center">@(det.NombreBanco ?? "-")</td>
                                                <td class="text-center">@comprobante</td>
                                                <td class="text-center">@(det.FechaEmision?.ToString("dd/MM/yyyy") ?? "-")</td>
                                                <td class="text-center">
                                                    @if (!string.IsNullOrEmpty(det.GuidArchivoFactura))
                                                    {
                                                        <a href="@Url.Action("Descargar", "Archivo", new { guid = det.GuidArchivoFactura })"
                                                           class="btn btn-outline-danger btn-xs" target="_blank" title="Ver Factura PDF">
                                                            <i class="fas fa-file-pdf"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (!string.IsNullOrEmpty(det.GuidArchivoXml))
                                                    {
                                                        <a href="@Url.Action("Descargar", "Archivo", new { guid = det.GuidArchivoXml })"
                                                           class="btn btn-outline-warning btn-xs" title="Descargar XML">
                                                            <i class="far fa-file-code"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge @EstadoDescripcion.Produccion.GetBadgeClass(det.Estado)">
                                                        @EstadoDescripcion.Produccion.GetDescripcion(det.Estado)
                                                    </span>
                                                    @if (det.PagoFecha.HasValue || !string.IsNullOrEmpty(det.PagoNumeroOperacion))
                                                    {
                                                        <div style="margin-top: 0.25rem; font-size: 0.75rem; line-height: 1.4; color: #155724;">
                                                            @if (det.PagoFecha.HasValue)
                                                            {
                                                                <div><span class="text-muted">F. Pago:</span> @det.PagoFecha.Value.ToString("dd/MM/yyyy")</div>
                                                            }
                                                            @if (!string.IsNullOrEmpty(det.PagoNumeroOperacion))
                                                            {
                                                                <div><span class="text-muted">Nro Op.:</span> @det.PagoNumeroOperacion</div>
                                                            }
                                                        </div>
                                                    }
                                                </td>
                                                <td class="text-right">@(det.MtoSubtotal?.ToString("N2") ?? "--")</td>
                                                <td class="text-right">@(det.MtoIgv?.ToString("N2") ?? "--")</td>
                                                <td class="text-right">@(det.MtoRenta?.ToString("N2") ?? "--")</td>
                                                <td class="text-right font-weight-bold">@(det.MtoTotal?.ToString("N2") ?? "--")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="14" class="text-center text-muted py-3">
                                                <i class="fas fa-inbox fa-2x mb-2"></i>
                                                <p class="mb-0">No hay detalle de liquidaciones</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                @if (detalleLiquidaciones.Any())
                                {
                                    <tfoot class="bg-light font-weight-bold">
                                        <tr>
                                            <td style="display:none;"></td>
                                            <td colspan="10" class="text-right">TOTAL GENERAL:</td>
                                            <td id="tfSubtotal" class="text-right">@(detalleLiquidaciones.Sum(d => d.MtoSubtotal ?? 0).ToString("N2"))</td>
                                            <td id="tfIgv"      class="text-right">@(detalleLiquidaciones.Sum(d => d.MtoIgv ?? 0).ToString("N2"))</td>
                                            <td id="tfRenta"    class="text-right">@(detalleLiquidaciones.Sum(d => d.MtoRenta ?? 0).ToString("N2"))</td>
                                            <td id="tfTotal"    class="text-right">@(detalleLiquidaciones.Sum(d => d.MtoTotal ?? 0).ToString("N2"))</td>
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        function sincronizarSAP() {
            const btn = document.getElementById('btnSincronizarSAP');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>Sincronizando...';

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('@Url.Action("SincronizarPagoFacturas", "Tesoreria")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ guidOrdenPago: '@Model.GuidRegistro' })
            })
            .then(async res => {
                const data = await res.json();
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-sync-alt mr-1"></i>Sincronizar con SAP';

                if (!res.ok || !data.success) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error al sincronizar',
                        text: data.message || 'Error interno al sincronizar con SAP.',
                        confirmButtonColor: '#dc3545'
                    });
                    return;
                }

                Swal.fire({
                    icon: 'success',
                    title: 'Sincronización completada',
                    html: `<ul class="text-left mb-0">
                               <li>Total comprobantes: <b>${data.totalComprobantes}</b></li>
                               <li>Consultados en SAP: <b>${data.consultadosEnSap}</b></li>
                               <li>Sin comprobante: <b>${data.sinComprobante}</b></li>
                               <li>Errores: <b>${data.errores}</b></li>
                           </ul>`,
                    confirmButtonColor: '#28a745'
                }).then(() => { location.reload(); });
            })
            .catch(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-sync-alt mr-1"></i>Sincronizar con SAP';
                Swal.fire({
                    icon: 'error',
                    title: 'Error de conexión',
                    text: 'No se pudo conectar al servidor.',
                    confirmButtonColor: '#dc3545'
                });
            });
        }

        // Filtrar filas por Cod. Liquidacion
        function filtrarDetalle() {
            const valor = document.getElementById('cboFiltroLiquidacion').value;
            document.querySelectorAll('#facturasTable tbody tr').forEach(function (tr) {
                if (!valor) {
                    tr.style.display = '';
                } else {
                    tr.style.display = (tr.dataset.numliq === valor) ? '' : 'none';
                }
            });
            // Desmarcar todos los checks y quitar resaltado al filtrar
            document.querySelectorAll('.chk-factura').forEach(chk => {
                chk.checked = false;
                const tr = chk.closest('tr');
                if (tr) tr.classList.remove('row-selected');
            });
            const selectAll = document.getElementById('chkSelectAll');
            if (selectAll) selectAll.checked = false;
            actualizarContador();
            renumerarFilas();
            recalcularTotales();
        }

        // Recalcula totales del tfoot con solo las filas visibles
        function recalcularTotales() {
            let subtotal = 0, igv = 0, renta = 0, total = 0;
            document.querySelectorAll('#facturasTable tbody tr').forEach(function (tr) {
                if (tr.style.display !== 'none') {
                    subtotal += parseMonto(tr.cells[11]);
                    igv      += parseMonto(tr.cells[12]);
                    renta    += parseMonto(tr.cells[13]);
                    total    += parseMonto(tr.cells[14]);
                }
            });
            setText('tfSubtotal', subtotal);
            setText('tfIgv',      igv);
            setText('tfRenta',    renta);
            setText('tfTotal',    total);
        }

        function parseMonto(cell) {
            if (!cell) return 0;
            const val = cell.textContent.replace(/,/g, '').trim();
            return parseFloat(val) || 0;
        }

        function setText(id, val) {
            const el = document.getElementById(id);
            if (el) el.textContent = val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        // Renumera la columna # solo en filas visibles
        function renumerarFilas() {
            let idx = 1;
            document.querySelectorAll('#facturasTable tbody tr').forEach(function (tr) {
                if (tr.style.display !== 'none') {
                    // col index 1 = columna #
                    if (tr.cells && tr.cells[1]) tr.cells[1].textContent = idx++;
                }
            });
        }

        // Retorna solo las checkboxes de filas visibles
        function chksVisibles() {
            return Array.from(document.querySelectorAll('#facturasTable tbody tr'))
                .filter(tr => tr.style.display !== 'none')
                .map(tr => tr.querySelector('.chk-factura'))
                .filter(chk => chk !== null);
        }

        // Actualiza el badge contando solo las marcadas (visibles o no)
        function actualizarContador() {
            const checked = document.querySelectorAll('.chk-factura:checked').length;
            const badge   = document.getElementById('badgeSeleccionados');
            if (badge) {
                badge.textContent = checked + ' selec.';
                badge.style.display = checked > 0 ? '' : 'none';
            }
        }

        // Aplica o quita resaltado amarillo en la fila
        function actualizarResaltado(chk) {
            const tr = chk.closest('tr');
            if (tr) tr.classList.toggle('row-selected', chk.checked);
        }

        // Seleccionar / deseleccionar todos (solo filas visibles)
        document.getElementById('chkSelectAll')?.addEventListener('change', function () {
            chksVisibles().forEach(chk => {
                chk.checked = this.checked;
                actualizarResaltado(chk);
            });
            actualizarContador();
        });

        // Si se desmarca uno, actualizar selectAll en base a visibles
        document.querySelectorAll('.chk-factura').forEach(chk => {
            chk.addEventListener('change', function () {
                actualizarResaltado(this);
                const visibles = chksVisibles();
                const checkedVisibles = visibles.filter(c => c.checked).length;
                const selectAll = document.getElementById('chkSelectAll');
                if (selectAll) selectAll.checked = (visibles.length > 0 && visibles.length === checkedVisibles);
                actualizarContador();
            });
        });

        // Prototipo: Revertir Pago por fila (sin accion real)
        function revertirPago(guid, comprobante) {
            Swal.fire({
                icon: 'warning',
                title: '¿Revertir Pago?',
                html: `Se revertirá el pago de la factura <strong>${comprobante}</strong>.<br/>
                       <small class="text-muted">El estado volverá a <em>Factura en Orden de Pago</em>.</small>`,
                showCancelButton: true,
                confirmButtonColor: '#f26522',
                cancelButtonColor:  '#6c757d',
                confirmButtonText:  'Sí, revertir',
                cancelButtonText:   'Cancelar'
            }).then(result => {
                if (!result.isConfirmed) return;
                Swal.fire({
                    icon: 'info',
                    title: 'Prototipo',
                    text: 'Funcionalidad de reversión pendiente de implementación.',
                    confirmButtonColor: '#6c757d'
                });
            });
        }

        function registrarPago() {
            const checks = Array.from(document.querySelectorAll('.chk-factura:checked'));

            if (checks.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Selección requerida',
                    text: 'Debe seleccionar al menos una factura para registrar el pago.',
                    confirmButtonColor: '#f26522'
                });
                return;
            }

            const comprobantes = checks.map(chk => chk.dataset.comprobante).join(', ');
            const guids        = checks.map(chk => chk.dataset.guid);

            Swal.fire({
                icon: 'question',
                title: '¿Registrar Pago?',
                html: `Se registrará el pago para <strong>${checks.length}</strong> factura(s):<br/>
                       <small class="text-muted">${comprobantes}</small>`,
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor:  '#6c757d',
                confirmButtonText:  'Sí, registrar',
                cancelButtonText:   'Cancelar'
            }).then(result => {
                if (!result.isConfirmed) return;

                const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                if (!tokenEl) {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Token de seguridad no encontrado. Recargue la página.', confirmButtonColor: '#dc3545' });
                    return;
                }

                fetch('@Url.Action("RegistrarPago", "Tesoreria")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenEl.value
                    },
                    body: JSON.stringify({
                        guidOrdenPago: '@Model.GuidRegistro',
                        guids: guids
                    })
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        const msg = data.errores && data.errores.length > 0
                            ? `${data.actualizados} factura(s) registrada(s). ${data.errores.length} con error.`
                            : `${data.actualizados} factura(s) registrada(s) correctamente.`;
                        Swal.fire({ icon: 'success', title: 'Pago registrado', text: msg, confirmButtonColor: '#28a745' })
                            .then(() => window.location.reload());
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: data.message || 'Error al registrar el pago.', confirmButtonColor: '#dc3545' });
                    }
                })
                .catch(() => {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Error de conexión al registrar el pago.', confirmButtonColor: '#dc3545' });
                });
            });
        }
    </script>
}
